#!/bin/sh
# vfg against realmc's stand-in box: this repo's toolkit/vfg, with HOME and VFG_HOME in the
# stand-in and the keys that choose the box pinned, so nothing reads ~/.vfg or ~/.ssh.
bin=$(dirname "$(readlink -f "$0")")
realmc=$(dirname "$bin")
repo=$(dirname "$(dirname "$realmc")")
state=${REALMC_DIR:-$realmc/.server}
if [ ! -f "$state/home/.vfg/config" ]; then
  echo "vfg: realmc is not set up: $realmc/up" >&2
  exit 3
fi
# The caller's own HOME, kept through every vfg the runner and its implementers start from here.
real_home=${REALMC_REAL_HOME:-$HOME}
export REALMC_REAL_HOME="$real_home"
export REALMC_DIR="$state" HOME="$state/home" VFG_HOME="$state/home/.vfg"
export VFG_SSH="$bin/ssh" VFG_SSH_HOST=realmc VFG_SSH_USER=ec2-user VFG_SSH_KEY="$state/home/.vfg/fake_key"
export VFG_REMOTE_VFG="$state/vfg" VFG_REMOTE_MC="$state/mc" VFG_REPO="$repo"
if [ "${1:-}" = orch ]; then
  # `vfg orch start` starts the runner, whose Claude CLI finds its login under ~/.claude and whose
  # uv finds its Python and cache under ~/.cache: it keeps the caller's HOME. vfg's own state stays
  # in VFG_HOME (the runner's inbox, state and log in $VFG_HOME/orch unless VFG_ORCH_DIR says
  # otherwise), and this bin/ is first on its PATH, so every vfg the runner runs comes back here.
  export HOME="$real_home"
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) export PATH="$bin:$PATH" ;;
  esac
fi
exec python3 "$repo/toolkit/vfg" "$@"
