[Unit]
Description=EverHear game engine: abilities, items, marks, actors and scenarios in one loop beside Minecraft
After=network-online.target minecraft.service
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/vfg/engine
EnvironmentFile=/opt/vfg/.env
Environment=PYTHONPATH=/opt/vfg/engine PYTHONUNBUFFERED=1
# The box's content folder, where vfg deploys made/main/content/; a VFG_ENGINE_CONTENT in .env
# wins over it (systemd lets EnvironmentFile= override Environment=).
Environment=VFG_ENGINE_CONTENT=/opt/vfg/made/main/content
ExecStart=/opt/vfg/engine/.venv/bin/python -m vfg_engine
# Started again after a crash, or when Minecraft was not up yet (exit 1); never after a bad
# setting (exit 78), which a restart does not mend.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
# SIGTERM ends the loop on its next tick and saves the state: well under this.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
