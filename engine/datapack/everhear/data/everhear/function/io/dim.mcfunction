# The dimension here into everhear:io ent.d (the three vanilla ones; another leaves it out).
execute if dimension minecraft:overworld run return run data modify storage everhear:io ent.d set value "minecraft:overworld"
execute if dimension minecraft:the_nether run return run data modify storage everhear:io ent.d set value "minecraft:the_nether"
execute if dimension minecraft:the_end run return run data modify storage everhear:io ent.d set value "minecraft:the_end"
