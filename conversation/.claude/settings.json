{
  "model": "sonnet",
  "effortLevel": "low",
  "autoCompactWindow": 200000,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(vfg *)",
      "Bash(date *)",
      "TaskStop"
    ],
    "deny": [
      "Bash(vfg cmd *)",
      "Bash(vfg script *)",
      "Bash(vfg orch reply *)",
      "Bash(vfg feed *)",
      "Bash(vfg usage *)",
      "Bash(vfg -*)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/usage.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/hooks/after-compact.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
