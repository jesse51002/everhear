#!/usr/bin/env python3
"""Fake `vfg` for testing the conversation: records every call, touches nothing.

Every call is appended as one JSON line {"at": …, "argv": […]} to
$VFG_FAKE_DIR/calls.jsonl (default: test/out/ beside this folder). Then:

  orch send      prints the next T<n> (from $VFG_FAKE_TASK_START, default 1)
  history        prints test/fixtures/history.txt
  cmd, script, orch reply, feed
                 exit 1 with `fake: must not be called`
  watch          replays $VFG_FAKE_FEED from the cursor in $VFG_FAKE_DIR/cursor:
                 a `sleep N` line waits N seconds, any other line is printed and
                 moves the cursor (the cursor is the feed file's line number of
                 the last line printed); `{now}` in a line becomes the UTC time
                 it is printed, as HH:MM:SS. At the end it sleeps forever — or, with
                 VFG_FAKE_WATCH_EXIT=1, exits 0, but only the first time, so the
                 re-armed watch that follows sleeps instead of exiting at once.
  say            prints `ok`, or with VFG_FAKE_SAY_FAIL=<message> exits 1 with
                 `vfg: <message>` (e.g. `nobody is online`, as on an empty server)
  everything else  prints `ok`

Options before the subcommand (`vfg --timeout 5 cmd …`) are skipped to find it,
so a call that tries to slip past the deny rules is still refused.
"""

import json
import os
import sys
import time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
TEST = os.path.dirname(HERE)
OUT = os.environ.get("VFG_FAKE_DIR") or os.path.join(TEST, "out")
FORBIDDEN = {("cmd",), ("script",), ("orch", "reply"), ("feed",)}


def now_iso():
    t = datetime.now(timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (t.microsecond // 1000)


def words(argv):
    """The subcommand words, after any global options."""
    i = 0
    while i < len(argv) and argv[i].startswith("-"):
        i += 2 if argv[i] == "--timeout" else 1
    return argv[i:]


def record(argv):
    os.makedirs(OUT, exist_ok=True)
    with open(os.path.join(OUT, "calls.jsonl"), "a") as f:
        f.write(json.dumps({"at": now_iso(), "argv": argv}, ensure_ascii=False) + "\n")


def next_task():
    start = int(os.environ.get("VFG_FAKE_TASK_START", "1"))
    path = os.path.join(OUT, "tasks")
    try:
        n = int(open(path).read().strip()) + 1
    except (OSError, ValueError):
        n = start
    with open(path, "w") as f:
        f.write(str(n))
    return "T%d" % n


def watch():
    feed = os.environ.get("VFG_FAKE_FEED")
    if feed and not os.path.isabs(feed) and not os.path.exists(feed):
        feed = os.path.join(os.path.dirname(TEST), feed)   # relative to the conversation folder
    cursor_path = os.path.join(OUT, "cursor")
    try:
        cursor = int(open(cursor_path).read().strip())
    except (OSError, ValueError):
        cursor = 0
    if feed:
        with open(feed) as f:
            lines = f.read().splitlines()
        for number, line in enumerate(lines, 1):
            if number <= cursor or not line.strip() or line.startswith("#"):
                continue
            if line.startswith("sleep "):
                time.sleep(float(line.split()[1]))
                continue
            print(line.replace("{now}", datetime.now(timezone.utc).strftime("%H:%M:%S")), flush=True)
            with open(cursor_path, "w") as c:
                c.write(str(number))
    marker = os.path.join(OUT, "watch-exited")
    if os.environ.get("VFG_FAKE_WATCH_EXIT") == "1" and not os.path.exists(marker):
        open(marker, "w").close()
        return 0
    while True:
        time.sleep(3600)


def main():
    argv = sys.argv[1:]
    record(argv)
    cmd = words(argv)
    if tuple(cmd[:1]) in FORBIDDEN or tuple(cmd[:2]) in FORBIDDEN:
        print("fake: must not be called", file=sys.stderr)
        return 1
    if cmd[:2] == ["orch", "send"]:
        print(next_task())
    elif cmd[:1] == ["history"]:
        with open(os.path.join(TEST, "fixtures", "history.txt")) as f:
            sys.stdout.write(f.read())
    elif cmd[:1] == ["watch"]:
        return watch()
    elif cmd[:1] == ["say"] and os.environ.get("VFG_FAKE_SAY_FAIL"):
        print("vfg: " + os.environ["VFG_FAKE_SAY_FAIL"], file=sys.stderr)
        return 1
    else:
        print("ok")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
