[Unit]
Description=VFG Jev filter
After=network-online.target vfg-bridge.service
Wants=network-online.target
ConditionPathExists=/opt/vfg/jev/jev_filter.py

[Service]
User=ec2-user
WorkingDirectory=/opt/vfg/jev
EnvironmentFile=-/opt/vfg/.env
ExecStart=/opt/vfg/python/bin/python3 -u /opt/vfg/jev/jev_filter.py
Restart=always
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
