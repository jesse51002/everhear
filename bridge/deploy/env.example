# /opt/vfg/.env -- mode 600, owner ec2-user, read by vfg-bridge, vfg-jev and vfg-engine (EnvironmentFile).
# Names only. Fill the values on the box over SSH; never put a value in the repo.

# The bridge's bearer token; the same value goes in every player's mod config, and the Jev
# filter's cast check sends it with each cast to the bridge's POST /v1/jev/casts.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VFG_CLIENT_TOKEN=
# The Jev filter's TypeSafe key.
TYPESAFE_API_KEY=

# The Jev filter's settings (jev/README.md), at their defaults:
# VFG_JEV_STATE_TOKENS=8000
# VFG_BATCH_SECONDS=5
# VFG_JEV_CAST_MIN=0.5         (the cast check's threshold, on the chosen option's probability;
#                               over 1 turns the check off)
# VFG_JEV_CAST_MIN_LONG=0.7    (a line over 6 words: its threshold; over 1, long lines unchecked)
# VFG_JEV_CAST_SURE=0.7        (a short cast this sure drops its line; under it, the line is routed too)

# The bridge's incantation settings (bridge/README.md), at their defaults:
# VFG_CAST_SLACK_S=0.3
# VFG_CAST_WAIT_S=1.5
# VFG_JEV_CAST_MAX_AGE_S=2.0   (a Jev cast of a line the bridge received longer ago is stale)
# VFG_INCANT_ALLOWANCE=0.25
# VFG_INCANT_LAYER2=on
# VFG_INCANT_LAYER2_MAX_WORDS=6  (Layer 2 only on a line of at most this many words; 0 any length)
# VFG_ENGINE_CAST_WAIT_S=1.0   (an engine binding's cast waits this long for the engine's answer)

# The game engine's settings (engine/README.md), at their defaults. The bridge reads the export's
# and the socket's too, the Jev filter the export's, and engine ctl the socket's:
# VFG_ENGINE_TICK_HZ=10
# VFG_ENGINE_SLOW_MS=5         (a content call over this is logged as slow)
# VFG_ENGINE_CUT_MS=50         (and over this is cut)
# VFG_ENGINE_CONTENT=/opt/vfg/engine/library:/opt/vfg/made/main/content   (folders, colon-separated, the
#                              library first; vfg-engine.service's default)
# VFG_ENGINE_STATE=/opt/vfg/engine/state.json
# VFG_ENGINE_EXPORT=/opt/vfg/engine/incantations.json
# VFG_ENGINE_SOCKET=/opt/vfg/engine/engine.sock
# VFG_ENGINE_LOG=/opt/vfg/engine/engine.log
# VFG_ENGINE_STALE_S=5        (a use, hit, hurt or kill older than this is not acted on)
# VFG_ENGINE_RAY_BLOCKS=48    (each player's raycast, in blocks: engine/MINECRAFT.md)
# VFG_ENGINE_MIRROR_RADIUS=32 (the mirror: entities this many blocks round each player)
# VFG_ENGINE_MIRROR_S=0.1     (a mirror pass this often)
# VFG_ENGINE_MIRROR_BUDGET=0.1   (slower when a pass would take more of the server's time than this)
