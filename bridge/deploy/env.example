# /opt/vfg/.env -- mode 600, owner ec2-user, read by vfg-bridge and vfg-jev (EnvironmentFile).
# Names only. Fill the values on the box over SSH; never put a value in the repo.

# The bridge's bearer token; the same value goes in every player's mod config.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VFG_CLIENT_TOKEN=
# The Jev filter's TypeSafe key.
TYPESAFE_API_KEY=

# The Jev filter's settings (jev/README.md), at their defaults:
# VFG_JEV_STATE_TOKENS=8000
# VFG_BATCH_SECONDS=5

# The bridge's incantation settings (bridge/README.md), at their defaults:
# VFG_KIT=/opt/vfg/scripts/_lib
# VFG_OWNER=
# VFG_CAST_GAP_S=1.0
# VFG_CAST_SLACK_S=0.3
# VFG_INCANT_ALLOWANCE=0.25
# VFG_INCANT_LAYER2=on
