# /opt/vfg/.env -- mode 600, owner ec2-user, read by vfg-bridge and vfg-jev (EnvironmentFile).
# Names only. Fill the values on the box over SSH; never put a value in the repo.

# The bridge's bearer token; the same value goes in every player's mod config, and the Jev
# filter's cast check sends it with each cast to the bridge's POST /v1/jev/casts.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VFG_CLIENT_TOKEN=
# The Jev filter's TypeSafe key.
TYPESAFE_API_KEY=

# The Jev filter's settings (jev/README.md), at their defaults:
# VFG_JEV_STATE_TOKENS=8000
# VFG_BATCH_SECONDS=5
# VFG_JEV_CAST_MIN=0.5         (the cast check's threshold, on the chosen option's probability;
#                               over 1 turns the check off)
# VFG_JEV_CAST_MIN_LONG=0.7    (a line over 6 words: its threshold; over 1, long lines unchecked)
# VFG_JEV_CAST_SURE=0.7        (a short cast this sure drops its line; under it, the line is routed too)

# The bridge's incantation settings (bridge/README.md), at their defaults:
# VFG_KIT=/opt/vfg/scripts/_lib
# VFG_OWNER=
# VFG_CAST_GAP_S=1.0
# VFG_CAST_SLACK_S=0.3
# VFG_CAST_WAIT_S=1.5
# VFG_JEV_CAST_MAX_AGE_S=2.0   (a Jev cast of a line the bridge received longer ago is stale)
# VFG_INCANT_ALLOWANCE=0.25
# VFG_INCANT_LAYER2=on
