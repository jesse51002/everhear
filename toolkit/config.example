# ~/.vfg/config: every Everhear setting on your PC, KEY=value, mode 600.
# toolkit/install.sh copies this file there. The vfg toolkit, bridge/deploy/*.sh,
# jev/deploy.sh, installer/publish.sh, conversation/start and lib/py all read it.
# An environment variable of the same name wins. An empty value means the default.
# No secret goes here: the key's path only, never the key.

# --- You ---
# Your Minecraft name. The conversation treats this player as the server's owner:
# only the owner may ask for op, bans, the whitelist, stopping the server and the like.
# conversation/start writes it into conversation/CLAUDE.local.md the first time. Required.
VFG_OWNER=

# --- The EC2 box ---
# The box's public IP or DNS name; new each time the instance is launched or started. Required.
VFG_SSH_HOST=
# Default: ec2-user
VFG_SSH_USER=
# Path to the SSH private key of VFG_KEY_PAIR, e.g. ~/.ssh/everhear.pem (only the path is read). Required.
VFG_SSH_KEY=
# The AWS region the box and the installer bucket live in. Default: us-east-2
VFG_AWS_REGION=
# Default: m7i.xlarge
VFG_INSTANCE_TYPE=
# The EC2 key pair ec2.sh launch puts on the box. Default: everhear
VFG_KEY_PAIR=
# Where ec2.sh retire keeps the world's backups and deploy.sh provision --restore
# finds them. Default: ~/everhear/backups
VFG_BACKUP_DIR=
# Set it to true once you have read and accepted Minecraft's EULA
# (https://aka.ms/MinecraftEULA); deploy.sh provision needs it for a new world.
VFG_ACCEPT_EULA=
# A .env file, mode 600, outside any repo, holding the box's secrets (TYPESAFE_API_KEY, and
# VFG_CLIENT_TOKEN to keep one token across boxes). deploy.sh provision and deploy.sh env send
# those names to /opt/vfg/.env; any other key in the file stays on this PC.
# Default: ~/.vfg/box.env
VFG_BOX_ENV=

# --- The installer link (installer/publish.sh) ---
# The private S3 bucket; publish.sh makes one and writes its name here on the first run.
VFG_INSTALL_BUCKET=
# The address players join. Default: VFG_SSH_HOST
VFG_INSTALL_ADDRESS=
# Where the built mod jar is. Default: client-mod/build/libs in this repo
VFG_CLIENT_JAR_DIR=

# --- The vfg toolkit ---
# What vfg say puts first, in aqua. Default: "[AI] " (quote it to keep the space).
VFG_CHAT_PREFIX=
# Where orchestrator/run and scripts/ are. Default: the repo the toolkit is in
VFG_REPO=
# The bridge's folder on EC2. Default: /opt/vfg
VFG_REMOTE_VFG=
# The Minecraft server's folder on EC2. Default: /opt/mc
VFG_REMOTE_MC=
# Most lines vfg watch replays after a gap. Default: 100
VFG_WATCH_CATCHUP=
# The valve: most lines vfg watch prints in any minute. Default: 120
VFG_WATCH_MAX_PER_MIN=
# The ssh binary. Default: ssh
VFG_SSH=
# Seconds vfg place list answers from its cache, $VFG_HOME/places.json, before it asks the
# server again; vfg place save and forget update the cache as they go. Default: 30
VFG_PLACES_TTL_S=

# --- The dispatcher ---
# The file holding your OpenRouter API key alone, mode 600; lib/py's structured()
# reads it. OPEN_ROUTER_API in the environment wins over the file.
# Default: ~/.vfg/openrouter.key
VFG_OPENROUTER_KEY=
# Its folder: the inbox vfg orch send appends to, state.json, dispatcher.log, the pid
# and refs/, the command references per server version. Default: ~/.vfg/dispatch
VFG_DISPATCH_DIR=
# The OpenRouter model of every dispatcher call. Default: ~deepseek/deepseek-v4-flash-latest
VFG_DISPATCH_MODEL=
# Seconds one model call may take, its retries included; past it the task, or that
# part of it, goes to the orchestrator. Default: 10
VFG_DISPATCH_MODEL_TIMEOUT_S=
# The dispatcher's reasoning: off, or an effort (low, medium, high) for a model that
# cannot turn it off, such as Sonnet 5.5 on OpenRouter. Default: off
VFG_DISPATCH_REASONING=
# The action planner's own model, providers and reasoning, when they should differ from the
# selector's: a smarter selector to route, a faster planner to write the command. Each
# defaults to the selector's setting above.
VFG_DISPATCH_PLAN_MODEL=
VFG_DISPATCH_PLAN_PROVIDERS=
VFG_DISPATCH_PLAN_REASONING=
# on: the planner sends each command draft back with Minecraft's reference before it runs,
# one model call more per command; a failed command is retried with the reference either
# way. Default: off
VFG_DISPATCH_PLAN_CHECK=
# How often a failed action is changed and run again before it is handed on or
# dropped. Default: 1
VFG_DISPATCH_RETRIES=
# Seconds from the first task handed on until every task handed since goes to the
# orchestrator, in one vfg orch hand. Default: 10
VFG_DISPATCH_WINDOW_S=
# Seconds an action may run on EC2; teleport allows itself 60. Default: 20
VFG_DISPATCH_ACTION_TIMEOUT_S=

# --- Scripts (vfg script, vfg preset, vfg state) ---
# The server this PC drives, and the name of its folder under made/, where what its
# implementers make is kept apart from the library in scripts/. Default: main
VFG_SERVER=
# How often a running script looks again for the values vfg script set wrote, in seconds.
# Default: 0.5
VFG_LIVE_POLL_S=

# --- The router (vfg route) and the implementers' cache ---
# Seconds vfg route waits for Jev before it picks by words instead. Default: 3
VFG_ROUTE_TIMEOUT_S=
# What loads an example script for an implementer (runs_it and close together)
# or a preset (use), from 0 to 1. Default: 0.3
VFG_ROUTE_LOAD=
# How long an implementer's prompt cache lives, 5m or 1h; the orchestrator passes
# it as subagentPromptCacheTtl. An hour doubles the price of every cache write. Default: 5m
VFG_SUBAGENT_CACHE_TTL=
