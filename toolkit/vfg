# What this server's implementers made, made/<server>/ (scripts, presets, actions), is kept out
# of git; `vfg made save` copies it after a run into a new folder $VFG_MADE_ARCHIVE/<save>/, named
# to the second (2026-10-10-142301), and never deletes one; `vfg made restore <save>` puts one
# back, and `vfg made restore <date>` that day's latest.
MADE_ARCHIVE = "/var/home/jm/Documents/EverHear/Internal/made"
SAVE_RE = re.compile(r"^[0-9][0-9A-Za-z_.-]{0,63}$")
DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def copy_tree(src, dest):
    """src copied to dest whole (no caches, no dotfiles), through dest's temp twin; files copied."""
    import shutil
    tmp = os.path.join(os.path.dirname(dest), ".%s.new-%d" % (os.path.basename(dest), os.getpid()))
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, ignore=shutil.ignore_patterns("__pycache__", ".*", "*.pyc"))
    n = sum(len(files) for _, _, files in os.walk(tmp))
    old = None
    if os.path.lexists(dest):
        old = os.path.join(os.path.dirname(dest), ".%s.old-%d" % (os.path.basename(dest), os.getpid()))
        os.rename(dest, old)
    os.rename(tmp, dest)
    return n, old


def saves(archive):
    """The saves in the archive, oldest first: their names sort as their times."""
    try:
        names = os.listdir(archive)
    except OSError:
        return []
    return sorted(d for d in names if SAVE_RE.match(d) and os.path.isdir(os.path.join(archive, d)))


def save_named(archive, name):
    """A save by its full name, or a date's latest (a folder named by the day alone, as an
    older vfg saved, counts as that day's earliest); None when there is none."""
    have = saves(archive)
    if name in have:
        return name
    if DAY_RE.match(name):
        day = [d for d in have if d == name or d.startswith(name + "-")]
        if day:
            return day[-1]
    return None


def cmd_made(cfg, a):
    server = server_name(cfg)
    here = os.path.join(cfg.repo, "made", server)
    archive = os.path.expanduser(cfg.get("VFG_MADE_ARCHIVE") or MADE_ARCHIVE)
    if a.op == "save":
        if not os.path.isdir(here) or not os.listdir(here):
            raise Fail(1, "nothing to save: made/%s/ is empty" % server)
        os.makedirs(archive, exist_ok=True)
        # A new folder each time, named to the second: one saved this second already waits for the next.
        while True:
            dest = os.path.join(archive, datetime.now().strftime("%Y-%m-%d-%H%M%S"))
            if not os.path.lexists(dest):
                break
            time.sleep(0.2)
        n, _ = copy_tree(here, dest)
        out("saved made/%s/ to %s: %d file%s" % (server, tilde(dest), n, "" if n == 1 else "s"))
        return 0
    name = save_named(archive, a.save) if SAVE_RE.match(a.save) else None
    if name is None:
        raise Fail(1, "no save %s in %s; saved: %s" % (a.save, tilde(archive), ", ".join(saves(archive)) or "none"))
    os.makedirs(os.path.dirname(here), exist_ok=True)
    n, old = copy_tree(os.path.join(archive, name), here)
    line = "restored made/%s/ from %s: %d file%s" % (server, tilde(os.path.join(archive, name)), n,
                                                     "" if n == 1 else "s")
    if old:
        # What it replaced is kept beside it, hidden, until someone deletes it.
        base = os.path.join(cfg.repo, "made", ".replaced", "%s-%s" % (server, time.strftime("%Y%m%d-%H%M%S")))
        os.makedirs(os.path.dirname(base), exist_ok=True)
        kept, k = base, 2
        while os.path.lexists(kept):     # another restore this second
            kept, k = "%s-%d" % (base, k), k + 1
        os.rename(old, kept)
        line += "; the one it replaced is in %s" % os.path.relpath(kept, cfg.repo)
    out(line)
    return 0


