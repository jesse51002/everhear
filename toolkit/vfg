def cmd_usage(cfg, a, started):
    if a.op == "flush":
        return send_usage(cfg, a, [])
    return send_usage(cfg, a, [usage_row(a, started)])


def usage_row(a, started):
    """`vfg usage add`'s row, checked. lib/py/vfg_llm.py's usage_row() queues each model call's
    in this format, with ok, error and ms after it."""
    if a.component not in COMPONENTS:
        raise Fail(2, "--component is one of %s" % ", ".join(COMPONENTS))
    if not a.model.strip() or len(a.model) > 200:
        raise Fail(2, "--model is a model name")
    if a.in_ < 0 or a.out < 0:
        raise Fail(2, "--in and --out are whole numbers, 0 or more")
    if (a.cache_read or 0) < 0 or (a.cache_write or 0) < 0:
        raise Fail(2, "--cache-read and --cache-write are whole numbers, 0 or more")
    if (getattr(a, "largest", None) or 0) < 0:
        raise Fail(2, "--largest is a whole number, 0 or more")
    if a.cost is not None and (a.cost < 0 or math.isnan(a.cost) or math.isinf(a.cost)):
        raise Fail(2, "--cost is a number, 0 or more")
    if a.ref is not None and len(a.ref) > 64:
        raise Fail(2, "--ref is at most 64 characters")
    row = {"at": now_iso(started), "component": a.component, "model": a.model.strip(),
           "input_tokens": a.in_, "output_tokens": a.out, "cost_usd": a.cost, "ref": a.ref,
           "cache_read_tokens": a.cache_read, "cache_write_tokens": a.cache_write}
    # A run's largest request (an implementer's): only when given, so the row stays the one
    # lib/py/vfg_llm.py queues for a call, with ok, error and ms after it.
    if getattr(a, "largest", None) is not None:
        row["largest_tokens"] = a.largest
    return row


def send_usage(cfg, a, rows):
    """The queue, usage.pending.jsonl (structured()'s own rows among them, VFG_USAGE_QUEUE's
    folder: Pending), then `rows`, to the box in one SSH call; queued again when they do not get
    there. Nothing queued and no row: nothing sent, exit 0. A row's cost_usd may be null: a call
    cut off with an attempt in flight, whose cost nobody told."""
    cfg.ensure_home()
    pending = Pending(cfg.home)
    rows = pending.claim() + rows
    if not rows:
        return 0
    try:
        timeout = a.timeout if a.timeout is not None else 15
        rc, o, e = Ssh(cfg).call(program("usage.py", {"vfg": cfg.rvfg, "rows": rows}), timeout)
        if rc != 0:
            pending.requeue(rows)
        else:
            pending.done()
    except BaseException:
        pending.requeue(rows)
        raise
    return finish(rc, o, e)


class Pending(object):
    """usage.pending.jsonl: rows that could not reach EC2, and every structured() call's row
    (lib/py/vfg_llm.py appends them under the same lock), inserted next time. Its folder is
    VFG_USAGE_QUEUE from the environment, as vfg_llm's record() reads it, else $VFG_HOME: a
    replay points it at its own folder, so its rows reach the box only when sent on purpose
    (`VFG_USAGE_QUEUE=<that folder> vfg usage flush`).

    A call claims the queue by moving it into usage.sending.<pid>.jsonl, so two
    calls never insert the same row; a crashed caller's file is claimed again."""

    def __init__(self, home):
        self.home = os.path.expanduser(os.environ.get("VFG_USAGE_QUEUE") or home)
        os.makedirs(self.home, mode=0o700, exist_ok=True)
        self.queue = os.path.join(self.home, "usage.pending.jsonl")
        self.lock = os.path.join(self.home, "usage.pending.lock")
        self.mine = os.path.join(self.home, "usage.sending.%d.jsonl" % os.getpid())

    def claim(self):
        rows = []
        with flocked(self.lock):
            sources = [self.queue]
            for name in os.listdir(self.home):
                m = re.match(r"^usage\.sending\.(\d+)\.jsonl$", name)
                if m and int(m.group(1)) != os.getpid() and not self._alive(int(m.group(1))):
                    sources.append(os.path.join(self.home, name))
            for path in sources:
                rows.extend(read_jsonl(path))
            if rows:
                atomic_write(self.mine, "".join(json.dumps(r) + "\n" for r in rows))
            for path in sources:
                try:
                    os.remove(path)
                except OSError:
                    pass
        return rows

    @staticmethod
    def _alive(pid):
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def requeue(self, rows):
        with flocked(self.lock):
            if rows:
                append_line(self.queue, "".join(json.dumps(r) + "\n" for r in rows))
            self._drop()

    def done(self):
        self._drop()

    def _drop(self):
        try:
            os.remove(self.mine)
        except OSError:
            pass


# ----------------------------------------------------------------- brain

# The brain, brain/run, runs detached on this PC with its files in $VFG_HOME/brain: brain.pid and
# brain.log (one `<ISO time> <area> <message>` line each; its output goes there too). Its tasks are
# rows of the tasks table in the box's vfg.db (Prototype_Named_Tasks), which only the brain writes,
# through vfg task set; vfg reads them through remote/tasks.py, as vfg task list does: the open ones
# (vfg brain status) and one task's description (vfg route --task).
BRAIN_MARKER = "VFG_BRAIN=1"  # in its environment: a pid without it is not the brain
START_CHECK_S = 3.0           # a brain that exits within this did not start
STOP_GRACE_S = 15.0           # SIGTERM, then SIGKILL after this
BRAIN_TASKS_S = 10.0          # vfg brain status's read of the open tasks from the box


def brain_pidfile(cfg):
    return os.path.join(cfg.brain, "brain.pid")


def brain_pid(cfg):
    """Its pid when it is running; a stale pid file is removed."""
    pid = read_int(brain_pidfile(cfg))
    if pid is None:
        return None
    if pid_with_marker(pid, BRAIN_MARKER):
        return pid
    try:
        os.remove(brain_pidfile(cfg))
    except OSError:
        pass
    return None


def cmd_brain_start(cfg, a):
    """Start brain/run detached, in a process group of its own, its output appended to its log;
    one that exits within START_CHECK_S did not start."""
    pid = brain_pid(cfg)
    if pid:
        out("brain  running pid %d" % pid)
        return 0
    run = os.path.join(cfg.repo, "brain", "run")
    if not (os.path.isfile(run) and os.access(run, os.X_OK)):
        raise Fail(1, "%s is missing or not executable" % tilde(run))
    os.makedirs(cfg.brain, mode=0o700, exist_ok=True)
    log = os.path.join(cfg.brain, "brain.log")
    append_line(log, "%s vfg brain start\n" % now_iso())
    env = dict(os.environ)
    for k in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"):
        env.pop(k, None)
    key, value = BRAIN_MARKER.split("=", 1)
    env[key] = value
    env["VFG_HOME"] = cfg.home
    env.setdefault("VFG_REPO", cfg.repo)
    logf = open(log, "ab")
    try:
        p = subprocess.Popen([run], cwd=os.path.dirname(run), stdin=subprocess.DEVNULL,
                             stdout=logf, stderr=subprocess.STDOUT, start_new_session=True, env=env)
    finally:
        logf.close()
    atomic_write(brain_pidfile(cfg), "%d\n" % p.pid)
    try:
        code = p.wait(timeout=START_CHECK_S)
    except subprocess.TimeoutExpired:
        out("brain  started pid %d" % p.pid)
        return 0
    try:
        os.remove(brain_pidfile(cfg))
    except OSError:
        pass
    out("brain  exited at once (code %d)" % code)
    raise Fail(1, "the brain exited at once (code %d) — see %s" % (code, tilde(log)))


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def stop_group(pid):
    """SIGTERM the brain alone, then wait for its whole process group; SIGKILL the group after
    STOP_GRACE_S. The implementers' claude CLIs are in that group: the brain interrupts them
    itself and fails their tasks, which a SIGTERM to the group would kill first."""
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + STOP_GRACE_S
    while group_alive(pid) and time.monotonic() < deadline:
        time.sleep(0.02)
    if group_alive(pid):
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        end = time.monotonic() + 3
        while group_alive(pid) and time.monotonic() < end:
            time.sleep(0.02)


def cmd_brain_stop(cfg, a):
    """SIGTERM to the brain, so it can stop its implementers and close what it holds; SIGKILL to
    its process group after STOP_GRACE_S."""
    pid = brain_pid(cfg)
    if not pid:
        out("brain  not running")
        return 0
    stop_group(pid)
    try:
        os.remove(brain_pidfile(cfg))
    except OSError:
        pass
    out("brain  stopped pid %d" % pid)
    return 0


def cmd_brain_status(cfg, a):
    """Running or stopped, then one line per open task, oldest first, read from the box: its name,
    its player and its description. A read that fails warns and says `open   ?`; the exit code is
    the brain's either way."""
    pid = brain_pid(cfg)
    if pid:
        try:
            since = hms(os.stat(brain_pidfile(cfg)).st_mtime)
        except OSError:
            since = "?"
        out("brain  running pid %d since %s" % (pid, since))
    else:
        out("brain  stopped")
    try:
        open_ = task_read(cfg, {"open": True, "name": None}, BRAIN_TASKS_S if a.timeout is None else a.timeout)
    except Fail as f:
        warn("cannot read the open tasks from the box: %s" % f.msg)
        out("open   ? (%s)" % f.msg)
        open_ = None
    for t in open_ or []:
        text = clean_text(str(t.get("description") or ""))
        text = text if len(text) <= 120 else text[:119] + "…"
        out("open   %s %s: %s" % (t.get("name"), t.get("player") or "-", text))
    if open_ == []:
        out("open   none")
    if not pid:
        raise Fail(1, "the brain is not running — vfg brain start")
    return 0


def cmd_brain(cfg, a):
    return {"start": cmd_brain_start, "stop": cmd_brain_stop, "status": cmd_brain_status}[a.op](cfg, a)


# ----------------------------------------------------------------- tasks

# The brain's tasks (Prototype_Named_Tasks): the tasks table in the box's vfg.db, one row per
# implementer task, keyed by its name, which the bridge creates. `vfg task set` is how the brain,
# and only the brain, writes a row: every key checked here, then one SSH call to remote/tasks.py,
# an insert or an update of the keys given in one transaction there. `vfg task list` reads them;
# vfg brain status and vfg route --task read them the same way (task_read). A row is one shape
# everywhere: TASK_COLUMNS, made {"content", "bindings", "grants"} of names (the classes it wrote,
# the engine's binding ids, "player:ability"), variables a list of objects (null since the engine:
# a class's numbers are its Config), times ISO UTC with milliseconds and a Z.

def task_read(cfg, args, timeout, keep_master=False):
    """Tasks from the box, as vfg task list --json prints them, `args` {"open", "name"} saying
    which: a list of rows. Fail when they cannot be read: not configured, EC2 down or out of
    time, or no tasks table on the box yet."""
    data = program("tasks.py", dict(args, op="list", json=True, vfg=cfg.rvfg, mc=cfg.rmc))
    rc, o, e = Ssh(cfg).call(data, timeout, keep_master=keep_master)
    if rc != 0:
        finish(rc, b"", e)   # raises Fail with the box's one line
    try:
        rows = json.loads(o.decode("utf-8"))
    except ValueError:
        raise Fail(1, "tasks.py answered something that is not JSON")
    if not isinstance(rows, list):
        raise Fail(1, "tasks.py answered something that is not a list")
    return [t for t in rows if isinstance(t, dict)]


def checked_task(raw):
    """vfg task set's JSON, checked: one object of TASK_COLUMNS only, its name a task's (never
    cast), its status open, done or failed, its description a text, its player a player's name, made
    an object of names per kind, variables a list of objects, and its times ISO with milliseconds
    and a Z (parse_when). The dict sent to the box; Fail 2 for anything wrong, before any SSH call."""
    try:
        task = json.loads(raw)
    except ValueError as e:
        raise Fail(2, "the task is one JSON object: %s" % e)
    if not isinstance(task, dict):
        raise Fail(2, "the task is one JSON object, not %s" % type(task).__name__)
    unknown = [k for k in task if k not in TASK_COLUMNS]
    if unknown:
        raise Fail(2, "%s %s not a task's key; its keys: %s" % (", ".join(sorted(unknown)),
                                                               "is" if len(unknown) == 1 else "are",
                                                               ", ".join(TASK_COLUMNS)))
    name = task.get("name")
    if not isinstance(name, str):
        raise Fail(2, "the task needs its name, like {\"name\": \"galick_gun_styrk\", …}")
    check_task(name, "name")
    if "status" in task and task["status"] not in TASK_STATUSES:
        raise Fail(2, "status is %s, not %r" % (", ".join(TASK_STATUSES), task["status"]))
    if "description" in task and not (isinstance(task["description"], str) and task["description"].strip()):
        raise Fail(2, "description is what the thing is now: a text that is not empty")
    if task.get("player") is not None and not (isinstance(task["player"], str) and PLAYER_RE.match(task["player"])):
        raise Fail(2, "player is a player's name (letters, digits, _; at most 16) or null")
    for k in ("line", "brief", "session", "result"):
        if task.get(k) is not None and not isinstance(task[k], str):
            raise Fail(2, "%s is a text or null" % k)
    made = task.get("made")
    if made is not None:
        if not isinstance(made, dict) or any(k not in MADE_KINDS for k in made) or \
                any(not isinstance(v, list) or any(not isinstance(x, str) for x in v) for v in made.values()):
            raise Fail(2, "made is null, or an object of %s, each a list of names" % ", ".join(MADE_KINDS))
    variables = task.get("variables")
    if variables is not None and not (isinstance(variables, list) and all(isinstance(v, dict) for v in variables)):
        raise Fail(2, "variables is null, or a list of objects")
    for k in ("created_at", "updated_at", "closed_at"):
        if task.get(k) is None:
            continue
        if not isinstance(task[k], str):
            raise Fail(2, "%s is a time, like 2026-10-11T18:22:33.120Z, or null" % k)
        try:
            task[k] = parse_when(task[k])
        except Fail as f:
            raise Fail(2, "%s: %s" % (k, f.msg))
    return task


def cmd_task_set(cfg, a):
    """vfg task set '<json>' (or - for stdin): one SSH call, which adds the task or changes the
    keys given; it prints added, updated, or kept when the box holds a newer write."""
    raw = sys.stdin.read() if a.row == "-" else a.row
    task = checked_task(raw)
    # A new task never takes the name of a library class or an action: the box refuses the insert
    # when this is true.
    library_action = any(os.path.isfile(os.path.join(cfg.repo, d, task["name"] + ".py"))
                         for d in ("actions", os.path.join("engine", "library")))
    return finish(*remote(cfg, a, "tasks.py", {"op": "set", "task": task, "library_action": library_action}, 30))


def cmd_task_list(cfg, a):
    """vfg task list [--open] [--name N] [--json]: one SSH call."""
    if a.name is not None:
        check_task(a.name, "--name")
    return finish(*remote(cfg, a, "tasks.py", {"op": "list", "open": bool(a.open), "name": a.name,
                                               "json": bool(a.json)}, 30))


def cmd_task(cfg, a):
    return {"set": cmd_task_set, "list": cmd_task_list}[a.op](cfg, a)


# ------------------------------------------------------------------ made

def server_name(cfg):
    """VFG_SERVER: the server this PC drives, and the name of its folder under made/."""
    name = cfg.get("VFG_SERVER") or "main"
    if not NAME_RE.match(name):
        raise Fail(3, "not configured: VFG_SERVER must be a name (a-z, 0-9, _ and -, at most 48)")
    return name


def tree(root, name):
    """What a deploy sends of <root>/<name>, in its order: (path in the tar, its os.stat, the
    file's bytes, or None for a folder); no caches, no dotfiles, no links."""
    for dirpath, dirnames, filenames in os.walk(os.path.join(root, name)):
        dirnames[:] = sorted(d for d in dirnames
                             if not d.startswith(".") and d != "__pycache__"
                             and not os.path.islink(os.path.join(dirpath, d)))
        rel = os.path.relpath(dirpath, root)
        yield rel, os.stat(dirpath), None
        for fn in sorted(filenames):
            path = os.path.join(dirpath, fn)
            if fn.startswith(".") or fn.endswith(".pyc") or os.path.islink(path) or not os.path.isfile(path):
                continue
            with open(path, "rb") as f:
                yield rel + "/" + fn, os.stat(path), f.read()


def stamp(entries):
    """A folder's stamp: the sha256 of its files' paths, exec bits and bytes as a deploy sends
    them (tree), not of the gzip."""
    h = hashlib.sha256()
    for path, st, data in entries:
        if data is not None:
            h.update(b"%s\0%d\0%d\0" % (path.encode("utf-8"), bool(st.st_mode & 0o111), len(data)))
            h.update(data)
    return h.hexdigest()


def pack(names, root):
    """The folders <root>/<name> as a gzipped tar in memory, base64, and each one's stamp, from the
    same bytes: (tar, {name: stamp})."""
    buf = io.BytesIO()
    stamps = {}
    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
        for name in names:
            entries = list(tree(root, name))
            stamps[name] = stamp(entries)
            for path, st, data in entries:
                ti = tarfile.TarInfo(path)
                ti.mode, ti.mtime = stat.S_IMODE(st.st_mode), int(st.st_mtime)
                if data is None:
                    ti.type = tarfile.DIRTYPE
                    tf.addfile(ti)
                else:
                    ti.size = len(data)
                    tf.addfile(ti, io.BytesIO(data))
    data = buf.getvalue()
    if len(data) > DEPLOY_MAX:
        raise Fail(1, "%s pack to %d MB; at most 20 MB" % (", ".join(names), len(data) // (1024 * 1024)))
    return base64.b64encode(data).decode("ascii"), stamps


# ------------------------------------------------------------------ actions

# The brain's menu: every action is one of the game engine's control ops (actions/engine_*.py, the
# game engine spec); `vfg action run` checks its values against its class and sends the op through
# the engine (run_engine_action), with no script and no copy. A scenario's or a mark's args come as
# `args.<name>=<value>` words, one each (args.at=home args.count=6), or `args=<a JSON object>`: a
# word starting with [ or { is read as JSON, any other stays text, which the engine's own check
# reads as its arg's type ("6" as 6, "true" as true).
KEY_RE = re.compile(r"^[a-z_][a-z0-9_]{0,47}$")
ARG_KEY_RE = re.compile(r"^args\.[a-z_][a-z0-9_]{0,47}$")
LIB_PY = os.path.join(os.path.dirname(HERE), "lib", "py")
_CATALOG = {}


def actions_lib():
    """lib/py/vfg_actions.py, the one loader of the actions, imported on first use."""
    if LIB_PY not in sys.path:
        sys.path.insert(0, LIB_PY)
    import logging
    logging.getLogger("vfg_actions").addHandler(logging.NullHandler())
    logging.getLogger("vfg_actions").propagate = False
    try:
        import vfg_actions
    except ImportError as e:
        raise Fail(3, "not configured: cannot load lib/py/vfg_actions.py (%s): run vfg as it is, "
                      "under uv" % e)
    return vfg_actions


def catalog(cfg):
    """(vfg_actions, the Catalog of the repo's actions), loaded once per run."""
    va = actions_lib()
    if cfg.repo not in _CATALOG:
        _CATALOG[cfg.repo] = va.Catalog(cfg.repo)
    return va, _CATALOG[cfg.repo]


def action_class(cfg, name):
    """(vfg_actions, the catalog, the action's class), or Fail 1 saying why there is none."""
    va, cat = catalog(cfg)
    cls = cat.get(name)
    if cls is None:
        why = cat.errors().get(name)
        if why:
            raise Fail(1, "action %s did not load: %s" % (name, why))
        raise Fail(1, "no action %s in actions/ — vfg action list" % name)
    return va, cat, cls


def arg_word(x):
    """An args.<name>= word's value: JSON when it starts with [ or { (a list, an object), else the
    text itself, which the engine reads as its arg's type."""
    s = x.strip()
    if s[:1] in ("[", "{"):
        try:
            return json.loads(s)
        except ValueError:
            raise Fail(2, "%s reads as JSON but is not: a list as [\"a\", \"b\"], an object as {\"k\": 1}" % s)
    return x


def action_words(words):
    """`<action> key=value … [--task <name>]`, in any order: (action, given, task). Every
    args.<name>=<value> word goes into given["args"], over an args=<JSON object>."""
    if words[:1] == ["--"]:
        words = words[1:]
    name, given, task, inner = None, {}, None, {}
    i = 0
    while i < len(words):
        w = words[i]
        if w == "--task":
            if i + 1 >= len(words):
                raise Fail(2, "--task takes a task's name, like --task galick_gun_styrk")
            task = words[i + 1]
            i += 2
            continue
        if w.startswith("--task="):
            task = w[len("--task="):]
        elif name is None and "=" not in w and not w.startswith("-"):
            name = w
        elif "=" in w and not w.startswith("-"):
            k, v = w.split("=", 1)
            if ARG_KEY_RE.match(k):
                if k[5:] in inner:
                    raise Fail(2, "%s is given twice" % k)
                inner[k[5:]] = arg_word(v)
            elif not KEY_RE.match(k):
                raise Fail(2, "%r is not key=value" % w)
            elif k in given:
                raise Fail(2, "%s is given twice" % k)
            else:
                given[k] = v
        else:
            raise Fail(2, "%r is not key=value" % w)
        i += 1
    if name is None:
        raise Fail(2, "which action? vfg action run <action> key=value … [--task <name>] — vfg action list")
    if not NAME_RE.match(name):
        raise Fail(2, "%s is not an action name" % name)
    if task is not None:
        check_task(task, "--task")
    if inner:
        whole = given.get("args")
        if isinstance(whole, str):
            whole = arg_word(whole) if whole.strip() else {}
        if whole is not None and not isinstance(whole, dict):
            raise Fail(2, "args= is a JSON object of the args, or give each as args.<name>=<value>")
        given["args"] = dict(whole or {}, **inner)
    check_home([v for v in given.values() if isinstance(v, str)])
    return name, given, task


def run_named(cfg, a, name, given, task=None):
    """Any action, as vfg action run and vfg cmd run it: its values checked against its class, then
    its op through the engine (run_engine_action). The JSON line's dict."""
    va, _, cls = action_class(cfg, name)
    if not va.engine_op(cls):
        raise Fail(1, "%s names none of the engine's ops: every action is one (vfg action check %s)" % (name, name))
    return run_engine_action(cfg, a, name, va, cls, given, task)


def cmd_action_run(cfg, a):
    """vfg action run: ONE JSON line, whatever happens; exit 0 when ok."""
    name, task = None, None
    try:
        name, given, task = action_words(list(a.rest))
        line = run_named(cfg, a, name, given, task)
    except Fail as f:
        out(json.dumps({"ok": False, "action": name or "", "running": False, "summary": "",
                        "facts": {}, "notes": [], "error": f.msg or "failed"}, ensure_ascii=False))
        raise
    out(json.dumps(line, ensure_ascii=False))
    if not line["ok"]:
        raise Fail(1, line.get("error") or "failed")
    return 0


def cmd_action_list(cfg, a):
    va, cat = catalog(cfg)
    if a.json:
        out(json.dumps(va.cache(cfg.repo, cfg.home, catalog=cat), ensure_ascii=False))
        return 0
    out("\n".join(va.menu_line(name, cat.get(name)) for name in cat.names()) or "none")
    for stem, why in sorted(cat.errors().items()):
        warn("%s did not load, left out: %s" % (stem, why))
    return 0


def cmd_action_show(cfg, a):
    """One action in full (menu.describe): its line, the op it goes to, and every value with its
    type, limits, default and description. From the actions cache, built again first when an
    action file is newer. An action that is not there exits 1 with why, or the names near it."""
    va = actions_lib()
    try:
        data = va.cache(cfg.repo, cfg.home)
    except Exception as e:
        raise Fail(1, "the actions cache could not be read: %s: %s" % (type(e).__name__, one_line(str(e))))
    acts = data.get("actions") or {}
    menu = lib_module("menu")
    entry = acts.get(a.name)
    if not isinstance(entry, dict):
        why = (data.get("errors") or {}).get(a.name)
        if why:
            raise Fail(1, "action %s did not load: %s — vfg action check %s" % (a.name, one_line(str(why)), a.name))
        near = menu.near(a.name, sorted(acts))
        raise Fail(1, "no action %s in actions/%s" % (
            a.name, "; near it: " + ", ".join(near) if near else " — vfg action list names them"))
    out(menu.describe(a.name, entry))
    return 0


def one_line(text, most=300):
    """`text` on one line, at most `most` characters."""
    text = " ".join(str(text).split())
    return text if len(text) <= most else text[:most - 1] + "…"


def action_rel(cfg, cat, name):
    """An action's file, from the repo: actions/engine_grant.py."""
    try:
        return os.path.relpath(str(cat.file(name)), cfg.repo)
    except KeyError:
        return "actions/%s.py" % name


def cmd_action_check(cfg, a):
    va, cat = catalog(cfg)
    if cat.get(a.name) is None:
        why = cat.errors().get(a.name)
        if why:
            out("%s: %s" % (a.name, why))
            raise Fail(1, "%s is left out: it does not load or does not pass" % a.name)
        raise Fail(1, "no action %s in actions/" % a.name)
    problems = va.check_action(a.name, cat.get(a.name))
    if problems:
        out("\n".join("%s: %s" % (action_rel(cfg, cat, a.name), p) for p in problems))
        raise Fail(1, "%d problem%s in %s" % (len(problems), "" if len(problems) == 1 else "s", a.name))
    out("ok: " + action_rel(cfg, cat, a.name))
    return 0


# ------------------------------------------------------------------ state

def day_phase(t):
    t %= 24000
    return "day" if t < 12000 else "dusk" if t < 13000 else "night" if t < 23000 else "dawn"


def condition(p):
    """One player's state as --items read it, what Minecraft answered and nothing else:
    `14.5/20 health, 18/20 food, armor 12, level 5, survival; effects: speed 2 0:30, night_vision ∞`."""
    def num(x):
        return None if isinstance(x, bool) or not isinstance(x, (int, float)) else f"{x:.1f}".removesuffix(".0")

    def left(t):
        if not isinstance(t, int) or isinstance(t, bool):
            return ""
        m, sec = divmod(max(t, 0) // 20, 60)
        return "∞" if t < 0 else f"{m // 60}:{m % 60:02d}:{sec:02d}" if m >= 60 else f"{m}:{sec:02d}"

    health, most, food, armor, level = (num(p.get(k)) for k in ("health", "max_health", "food", "armor", "xp_level"))
    bits = [f"{health}/{most} health" if health and most else f"{health} health" if health else "",
            f"{food}/20 food" if food else "", f"armor {armor}" if armor else "",
            f"level {level}" if level else "", p.get("game_mode") or ""]
    out = ", ".join(b for b in bits if b)
    if isinstance(p.get("effects"), list):
        on = ", ".join(" ".join(x for x in (str(e.get("id") or "?").removeprefix("minecraft:"),
                                             str(e["amplifier"] + 1) if isinstance(e.get("amplifier"), int)
                                             and e["amplifier"] > 0 else "", left(e.get("duration"))) if x)
                       for e in p["effects"] if isinstance(e, dict))
        out += ("; " if out else "") + ("effects: " + on if on else "no effects")
    return out


def cmd_state(cfg, a):
    """Who is online and where, the time and the weather, and with --items each player's
    inventory, armor and held slot, and their health, food, armor points, XP level, game mode and
    effects: one SSH call (remote/state.py, read-only RCON). What the engine runs is `vfg engine
    instances`."""
    t0 = time.monotonic()
    rc, o, e = remote(cfg, a, "state.py", {"items": bool(a.items)}, 30)
    if rc not in (0, 5):
        finish(rc, o, e)
    try:
        world = json.loads(o.decode("utf-8"))
    except ValueError:
        finish(rc, o, e)
        raise Fail(1, "state.py answered something that is not JSON")
    weather = None
    if world.get("raining") is not None:
        weather = "thunder" if world.get("thundering") else "rain" if world.get("raining") else "clear"
    daytime = world.get("daytime")
    result = {"online": world.get("online") or [],
              "time": {"daytime": daytime, "day": world.get("day"),
                       "phase": day_phase(daytime) if isinstance(daytime, int) else None},
              "weather": weather, "rcon": world.get("rcon"), "ms": int((time.monotonic() - t0) * 1000)}
    if a.json:
        out(json.dumps(result, ensure_ascii=False))
    else:
        rows_ = []
        if world.get("rcon"):
            rows_.append(("minecraft", world["rcon"]))
        else:
            people = ["%s %s %s" % (p["name"], " ".join(str(c) for c in p["pos"]) if p.get("pos") else "?",
                                    p.get("dimension") or "?") for p in result["online"]]
            rows_.append(("online", ", ".join(people) if people else "nobody"))
            for p in result["online"]:
                if p.get("items") is not None:
                    rows_.append(("items", "%s: %s" % (p["name"], " · ".join(
                        " ".join(str(x).split()) for x in p["items"] if str(x).strip()) or "nothing")))
                    rows_.append(("player", "%s: %s" % (p["name"], condition(p) or "unknown")))
            t = result["time"]
            rows_.append(("time", "%s (%s)%s" % (t["phase"] or "?", "?" if daytime is None else daytime,
                                                 ", day %d" % t["day"] if isinstance(t["day"], int) else "")))
            rows_.append(("weather", weather or "unknown"))
        out("\n".join("%-10s%s" % row for row in rows_))
    if rc == 5:
        finish(rc, b"", e)
    return 0


class _Stop(Exception):
    pass


def _raise_stop(signum, frame):
    raise _Stop()


# ------------------------------------------------------------- action refs

REFS_TIMEOUT = 300.0


def cmd_action_refs(cfg, a):
    if a.version_only:
        return finish(*remote(cfg, a, "refs.py", {"op": "version"}, 30))
    timeout = a.timeout if a.timeout is not None else REFS_TIMEOUT
    # The generator is stopped before the call gives up, so EC2 always cleans up.
    limit = timeout - 10 if timeout > 20 else timeout / 2
    return finish(*remote(cfg, a, "refs.py", {"op": "commands", "limit": limit}, REFS_TIMEOUT))


def cmd_action(cfg, a):
    return {"run": cmd_action_run, "list": cmd_action_list, "check": cmd_action_check, "show": cmd_action_show,
            "refs": cmd_action_refs}[a.op](cfg, a)


# ----------------------------------------------------------- incantations

# An incantation is a phrase that casts one of a player's engine abilities, or starts a scenario
# with set args, the moment that player says it, with no model on the path (the game engine spec,
# "Incantations"; Specs/2026-10-10-Prototype_Voice_Triggers and 2026-10-11-Prototype_Fast_Casts).
# The engine keeps them, per player (`vfg engine bind`, `vfg engine incantations`); what is here is
# what a bind makes on this PC first: the phrase checked and its aliases, the bridge's rules
# (bridge/vfg_bridge/sounds.py, the one copy) and one alias call.
# The alias call: one structured() call as an incantation is made, on Gemini 3.8 Flash at light
# thinking, OpenRouter picking the host, unless VFG_INCANT_ALIAS_MODEL names another (off: no
# call). Its prompt is this one, filled with the phrase, each word's pronunciation (CMUdict's, or
# the kit's letter-to-sound guess for a made-up word: incantations.pronunciation) and the count:
# exactly INCANT_ALIAS_COUNT variants, each with its sounds, the likeliest first. On the
# 2026-10-12 bench of alias prompts and models (seven phrases from the play sessions), Gemini at
# light thinking made 20 every time, at a median 6.0 s and at most 9.7 s, $0.0036 a create, where
# DeepSeek V4 Flash with no thinking made at most six, some of them other words; 20 kept Layer
# 2's recall on both sessions (79% and 96%, with lines of at most 6 words) for 31 false casts on
# the 843 lines of 10-08's talk, against 7 with the six stored. The code then checks each
# variant (incantations.checked_variants: the phrase itself, repeats, one 3 speech sounds longer
# or more, an H weighed 0.25 and an "uh" 0.5, one more than 0.35 from it in sound), and what it
# drops goes in the line's facts.alias_call.dropped, never in a note.
# It also says whether the phrase is everyday talk, which casts whenever it is said in
# conversation (a note), as a word list cannot without flagging made-up words: CMUdict holds
# kamehameha, nova and umbra. And it marks each variant that is a common phrase of its own
# (common_phrase), the entry's everyday_aliases, which the keyword spotter leaves out (the bridge's
# GET /v1/incantations): on 2026-10-12 "ice cream", "i scream", "nice beam" and "eyes beam" for
# ice beam fired the widened spotter on ordinary talk ("i scream" alone 17 times an hour; the
# four took false casts from 47 to 18 an hour), while speech to text wrote "Ice cream." for "ice
# beam" 10 times in one session, which Layer 2 caught through the alias. A flag on each variant,
# not a list of them after: as a list DeepSeek marked "juicy stake" and "destroyed everything"
# too, carrying the phrase's own everyday talk over. Word frequencies cannot tell them apart: in
# Google Books (2010-2019) "destroyed everything", which the spotter needs, is 23 times as common
# as "eyes beam" and 460 times "nice beam", and "ice been" 8 times "nice beam".
INCANT_ALIAS_MODEL = "google/gemini-3.8-flash"


INCANT_ALIAS_REASONING = "low"


INCANT_ALIAS_TIMEOUT_S = 20.0


INCANT_ALIAS_COUNT = 20


INCANT_ALIAS_PROMPT = """\
A player in a voice-controlled Minecraft game casts a spell by saying its incantation. Two programs \
listen and both mishear: a keyword spotter, which hears sounds and writes the words those sounds most \
often are, and speech to text, which writes down whole lines. List how the incantation is likely to be \
WRITTEN when the player says it, so the spell still fires.

The incantation: "%(phrase)s"
How it sounds (the CMU pronouncing dictionary, ARPAbet, stress left out):
%(sounds)s

Rules for every variant:
1. Said aloud it sounds almost the same as the incantation: the same sounds in the same order, with at \
most one or two changed: a vowel for a near vowel (IY/IH, EY/EH, AA/AO, AH/UH), a consonant for a near \
one (B/P, D/T, G/K, M/N, S/Z, F/V, TH/F), or a weak sound dropped or added at the end of a word (S, Z, \
D, T, H).
2. The same length: never a word added before or after it ("... now", "... out", "the ..."), never a \
word dropped, never extra syllables ("steakhouse").
3. Written the way a recognizer writes: real English words that make those sounds ("ice been", "juicy \
stake"), the words run together or split ("icebeam", "fire ball"), or for a made-up word, plain \
English syllables or words for how it is said ("come a hammer ha" for kamehameha).
4. Never the incantation itself, never one that means the same but sounds different ("destroy all"), \
no repeats.
5. The likeliest first: what a recognizer most often writes for these sounds. Always exactly %(count)d, \
the likeliest first.
For each variant give its sounds in ARPAbet too.

Mark each variant common_phrase when its words, as written, are a common phrase of their own that \
people say in conversation meaning something else, so a player would say it while not casting the \
spell. For ice beam, "ice cream", "i scream", "nice beam" and "eyes beam" are. Not a common phrase: a \
mishearing people do not say ("ice been", "juicy stake", "hot fire bowl", "speed ash", "fire bal"), \
even when the spell's own phrase is common, and the spell's own words in another form, run together, \
split, plural or in another tense ("fireball", "fire balls", "destroyed everything").

Then say whether the incantation itself is everyday talk: a word or words people often say in \
ordinary conversation, as "heal", "shield" or "come here". A made-up word, as kamehameha, or a \
spell's name, as "fire ball", is not.
"""


_INCANT = []


SOUNDS = os.path.join(os.path.dirname(HERE), "bridge", "vfg_bridge", "sounds.py")


def incantations_module():
    """bridge/vfg_bridge/sounds.py, loaded once by its path: the phrase rules, the code's aliases
    and the bind checks, the one copy the bridge matches lines with too."""
    if not _INCANT:
        import importlib.util
        if not os.path.isfile(SOUNDS):
            raise Fail(3, "not configured: there is no bridge/vfg_bridge/sounds.py")
        spec = importlib.util.spec_from_file_location("vfg_sounds", SOUNDS)
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod
        spec.loader.exec_module(mod)
        _INCANT.append(mod)
    return _INCANT[0]


def incant_find(inc, rows, player, phrase):
    """The entry of `player` (its exact key, in any case) for the normalised phrase, or None."""
    for e in rows:
        if str(e.get("player") or "").lower() == player.lower() and inc.normalize(e.get("phrase") or "") == phrase:
            return e
    return None


def incant_warnings(inc, phrase, aliases, player, rows):
    """bind_warnings against the player's other incantations (`rows`, theirs): the phrase being
    bound again is not one of them."""
    others = [e for e in rows if str(e.get("player") or "").lower() == player.lower()
              and not incant_find(inc, [e], player, phrase)]
    return list(dict.fromkeys(inc.bind_warnings(phrase, aliases, others)))


def incant_sounds(inc, phrase):
    """The prompt's pronunciation lines, one a word: `  beam = B IY M`, or for a word CMUdict
    lacks, `  galick = not in the dictionary (a made-up word); a guess from its letters: …`."""
    return "\n".join("  %s = %s" % (w, ph) if known else
                     "  %s = not in the dictionary (a made-up word); a guess from its letters: %s. "
                     "Think how a player would say it." % (w, ph) for w, ph, known in inc.pronunciation(phrase))


def incant_alias_call(cfg, phrase):
    """How `phrase` is likely said or misheard, from one structured() call: (variants, those of
    them that are everyday talk, whether the phrase is everyday talk, a note when the call failed,
    {"model", "cost", "ms"} when it answered). The variants are the model's as it wrote them, the
    code's checks still to come (incantations.checked_variants). A failure is a note, never a
    refusal: the code's aliases stand. The call queues its own usage row, component alias and the
    phrase its ref, and `vfg usage flush` sends it, nobody waiting."""
    model = (cfg.get("VFG_INCANT_ALIAS_MODEL") or INCANT_ALIAS_MODEL).strip()
    if model.lower() == "off":
        return [], [], False, None, None
    asked = False
    try:
        actions_lib()  # lib/py on sys.path
        import asyncio
        import logging
        import vfg_llm
        from pydantic import BaseModel, Field
        logging.getLogger("vfg_llm").addHandler(logging.NullHandler())
        logging.getLogger("vfg_llm").propagate = False

        class Variant(BaseModel):
            text: str = Field(description="lowercase words and spaces, as a recognizer writes it")
            sounds: str = Field(description="its ARPAbet sounds")
            common_phrase: bool = Field(description="whether these words are a common phrase people say meaning "
                                                    "something else")

        class Variants(BaseModel):
            variants: list[Variant] = Field(description="exactly %d, the likeliest first, each sounding almost the "
                                                        "same as the incantation and the same length"
                                                        % INCANT_ALIAS_COUNT)
            everyday: bool

        prompt = INCANT_ALIAS_PROMPT % {"phrase": phrase, "sounds": incant_sounds(incantations_module(), phrase),
                                        "count": INCANT_ALIAS_COUNT}
        asked = True
        got = asyncio.run(vfg_llm.structured(prompt, Variants, component="alias", call_id=phrase[:64], model=model,
                                             reasoning=INCANT_ALIAS_REASONING, timeout=INCANT_ALIAS_TIMEOUT_S))
    except Exception as e:  # noqa: BLE001 — an LlmError, no key, no httpx: the code's aliases stand
        if asked:
            flush_usage_later(cfg)
        return [], [], False, "aliases from code only: the alias call failed (%s)" % (str(e) or type(e).__name__), None
    flush_usage_later(cfg)
    variants = got.value.variants
    return [x.text for x in variants], [x.text for x in variants if x.common_phrase is True], \
        got.value.everyday is True, None, {"model": model, "cost": round(got.cost, 6), "ms": got.ms}


def incant_aliases(inc, phrase, variants, marked):
    """A new incantation's aliases from the alias call's variants and the code's: (aliases, its
    everyday_aliases, what was dropped, ["fire ball now: 6 speech sounds longer"]). The variants
    go through the code's checks (incantations.checked_variants), then merge_aliases after the
    code's own, the phrase joined and split. The everyday ones are those the call marked among
    the aliases kept, never the code's: the spotter leaves them out."""
    code = inc.code_aliases(phrase)
    kept, dropped = inc.checked_variants(phrase, variants)
    aliases = inc.merge_aliases(phrase, code, kept)
    dropped += [(x, "fewer than %d speech sounds" % inc.MIN_ALIAS_PHONES
                 if len(inc.phones(x)) < inc.MIN_ALIAS_PHONES else "past the %d" % inc.ALIAS_CAP)
                for x in kept if x not in aliases and x not in code]
    marks = inc.everyday(aliases, [m for m in marked if inc.normalize(m) not in code])
    return aliases, marks, ["%s: %s" % d for d in dropped]


def incant_blank(x):
    return x is None or (isinstance(x, str) and not x.strip())


# ------------------------------------------------------------------- engine

# The game engine (Specs/2026-10-12-Prototype_Game_Engine): one process on the box, vfg-engine, that
# runs the abilities, items, marks, actors and scenarios written as Python classes. vfg reaches it
# through its control ops (grant, give, start, bind, reload ...: the build's design, THE CONTROL OPS),
# which remote/engine.py sends to its control socket, <vfg>/engine/engine.sock, one JSON line in and
# one out; every reply is {"ok": true|false, "error"?: why, ...}. `vfg engine <op>` prints a reply in
# words, or with --json as it came; the engine's menu actions (actions/engine_*.py, each naming its
# op in `engine`) come here through `vfg action run` (run_engine_action), so the brain runs them as
# any action.
# Exit 0 when the engine did it, 1 when it refused (its error on stderr), 2 bad arguments, 4 no
# answer in time (it may still do it), 6 the engine not running.
#
# Content classes are written on this PC, in made/<server>/content/<file>.py, and deployed whole to
# <vfg>/made/<server>/content/ by `engine reload`, `config set` and `config undo` (remote/engine.py,
# swapped in under the box's deploy lock as a script's folder is), then reloaded there: the engine
# runs every check before anything switches, and a class that fails one leaves the old one running.
#
# The brain changes a class's numbers by rewriting its Config ("One version for everyone, rewritten
# by the brain"): `config get` shows it as written, with its file and lines; `config set` takes the
# whole new Config class on stdin, and the engine's rewrite.py (standard library only, imported here
# by its path) splices it into exactly the old one's lines and runs the static checks (it parses,
# the same fields, nothing outside the Config changed). Then the file is deployed and reloaded, the
# engine's full checks among it; when the box refuses, the PC file is put back and deployed again,
# and the engine's error is the answer. Every change keeps the file as it was, in
# made/<server>/content/.history/<file>/ (a deploy skips dot folders), and logs it there
# (log.jsonl), so `config undo` puts that class's last Config back; an undone version moves to
# undone/ beside them, so the next undo goes one further back.
ENGINE_DOWN = 6               # vfg's exit when the engine is not running
ENGINE_TIMEOUT_S = 10.0       # an op's answer: the engine takes it in its next tick
ENGINE_RELOAD_S = 120.0       # a reload's: the engine's every check of each class it reloads (its own default)
ENGINE_CONFIG_S = 60.0        # a Config's reload, inside the brain's loop of 120 s
ENGINE_START_WAIT_S = 15.0    # a start waits this long for a one-off's result (VFG_ENGINE_START_WAIT_S)
ENGINE_KINDS = ("ability", "item", "mark", "actor", "scenario")
ENGINE_ID_RE = re.compile(r"^[a-z][a-z0-9_]{0,63}\Z")             # a class's id: fireball, fire_staff
ENGINE_CLASS_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}\Z")   # an id, or a class's name: Fireball
ENGINE_FILE_RE = re.compile(r"^[a-z0-9][a-z0-9_]{0,63}\Z")        # a content file's stem
ENGINE_INSTANCE_RE = re.compile(r"^[A-Za-z0-9_.:@#-]{1,96}\Z")   # ability:fireball#12
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\Z")
REWRITE = os.path.join(os.path.dirname(HERE), "engine", "vfg_engine", "rewrite.py")
_REWRITE = []


def engine_remote(cfg, a, args, timeout):
    """remote/engine.py, in one SSH call: the JSON object it prints. A box that cannot be reached
    raises as every call does; one that answers is read by the caller (engine_faults)."""
    rc, o, e = remote(cfg, a, "engine.py", args, timeout + 30)
    if rc != 0:
        finish(rc, b"", e)  # raises Fail with the remote's one line
    try:
        got = json.loads(o.decode("utf-8").strip().splitlines()[-1])
        if not isinstance(got, dict) or not isinstance(got.get("replies"), list):
            raise TypeError
    except (ValueError, IndexError, TypeError):
        raise Fail(1, "remote/engine.py answered something that is not its JSON")
    return got


class EngineLate(Fail):
    """The engine took a request and did not answer in time: it may still carry it out (exit 4)."""


def engine_faults(got, done=""):
    """Fail 6 when the engine is not running, EngineLate (4) when it took a request and did not
    answer in time; `done` says what happened before it (a deploy)."""
    if got.get("down"):
        raise Fail(ENGINE_DOWN, (done + ", but " if done else "") + got["down"])
    if got.get("timeout"):
        raise EngineLate(4, (done + ", but " if done else "") + got["timeout"])


def engine_ask(cfg, a, requests, timeout=ENGINE_TIMEOUT_S):
    """The engine's reply to each of `requests` ([(op, args)]), in order, in one SSH call. Fail 6
    or EngineLate as engine_faults."""
    got = engine_remote(cfg, a, {"op": "ask", "requests": [{"op": op, "args": args} for op, args in requests],
                                 "timeout": timeout}, timeout * max(1, len(requests)))
    engine_faults(got)
    if len(got["replies"]) != len(requests):
        raise Fail(1, "the engine answered %d of %d requests" % (len(got["replies"]), len(requests)))
    return got


def engine_one(cfg, a, op, args, timeout=ENGINE_TIMEOUT_S):
    """One control op: the engine's reply, refused or not."""
    return engine_ask(cfg, a, [(op, args)], timeout)["replies"][0]


def engine_error(reply):
    return str(reply.get("error") or "").strip() or "the engine refused it and said no more"


def engine_show(a, reply, text):
    """A reply, with --json as it came, else `text` (words, or a function of the reply that gives
    them); a refusal exits 1 with the engine's error."""
    if getattr(a, "json", False):
        out(json.dumps(reply, ensure_ascii=False))
    elif reply.get("ok"):
        out(text(reply) if callable(text) else text)
    if not reply.get("ok"):
        raise Fail(1, engine_error(reply))
    return 0


def engine_when(x):
    """A time the engine gave: epoch seconds as ISO UTC, anything else as it is."""
    if isinstance(x, (int, float)) and not isinstance(x, bool) and x > 1e9:
        return now_iso(float(x))
    return "" if x is None else str(x)


def engine_count(x):
    """A count the engine gave: a number; a list, its length and its items; a dict of counts by
    kind, their sum and each (`3: ability 2, item 1`)."""
    if isinstance(x, dict):
        counts = dict((k, v) for k, v in x.items() if isinstance(v, int) and not isinstance(v, bool))
        return "%d%s" % (sum(counts.values()), ": " + ", ".join("%s %d" % kv for kv in sorted(counts.items()))
                         if counts else "")
    if isinstance(x, list):
        names = [str(v.get("instance") or v.get("id") or v) if isinstance(v, dict) else str(v) for v in x]
        return "%d%s" % (len(names), ": " + ", ".join(names) if names else "")
    return x


def engine_cell(x):
    """One value in a table: a whole number bare, a number to 4 places, a list joined, none as -."""
    if x is None or x == "":
        return "-"
    if isinstance(x, bool):
        return "true" if x else "false"
    if isinstance(x, float):
        return fmt_s(round(x, 4))
    if isinstance(x, (list, tuple)):
        return ",".join(engine_cell(v) for v in x) or "-"
    if isinstance(x, dict):
        return json.dumps(x, ensure_ascii=False, separators=(",", ":"))
    return one_line(x, 120)


def engine_table(rows, columns):
    """Rows of dicts as aligned columns, a header first."""
    cells = [[engine_cell(r.get(c)) for c in columns] for r in rows]
    widths = [max([len(c)] + [len(row[i]) for row in cells]) for i, c in enumerate(columns)]
    lines = ["  ".join(c.ljust(w) for c, w in zip(columns, widths)).rstrip()]
    lines += ["  ".join(v.ljust(w) for v, w in zip(row, widths)).rstrip() for row in cells]
    return "\n".join(lines)


def engine_file(cfg, path):
    """A file the engine named, from <vfg>/: made/main/content/fireball.py."""
    path = str(path or "")
    return path[len(cfg.rvfg) + 1:] if path.startswith(cfg.rvfg + "/") else path


def engine_status_text(r):
    ms = r.get("tick_ms")
    if isinstance(ms, dict):
        ms = "p50 %s ms, p95 %s ms" % (engine_cell(ms.get("p50")), engine_cell(ms.get("p95")))
    elif isinstance(ms, (list, tuple)) and len(ms) == 2:
        ms = "p50 %s ms, p95 %s ms" % tuple(engine_cell(x) for x in ms)
    elif ms is not None:
        ms = "%s ms" % engine_cell(ms)
    tick = "%s" % engine_cell(r.get("tick"))
    if r.get("tick_hz"):
        tick += " at %s a second" % engine_cell(r.get("tick_hz"))
    if ms:
        tick += "; " + ms
    since = engine_when(r.get("started_at"))
    rows = [("engine", "running" + (" since " + since if since else "")), ("tick", tick)]
    rows += [(k, engine_cell(engine_count(r.get(k)))) for k in ("players", "instances", "classes", "slow", "orphans")
             if k in r]
    return "\n".join("%-11s%s" % row for row in rows)


def engine_classes_text(cfg, r):
    """Every class, a line each: its kind, id, summary and file; under a scenario or a mark, its
    args, one indented line each."""
    rows = [c for c in r.get("classes") or [] if isinstance(c, dict)]
    if not rows:
        return "none"
    order = dict((k, i) for i, k in enumerate(ENGINE_KINDS))
    rows.sort(key=lambda c: (order.get(c.get("kind"), len(order)), str(c.get("id"))))
    width = max(len(str(c.get("id") or "")) for c in rows)
    lines = []
    for c in rows:
        lines.append(("%-9s %-*s  %s" % (c.get("kind") or "?", width, c.get("id") or "?",
                                        one_line(c.get("summary") or "(no summary)", 120))).rstrip()
                     + ("  (%s)" % engine_file(cfg, c.get("file")) if c.get("file") else ""))
        lines += ["%s  %s" % (" " * (11 + width), engine_arg_text(x)) for x in engine_args_of(c)]
    return "\n".join(lines)


def engine_meta_row(x):
    """One class's meta row, flat: its kind and id, its damage at power 0, 10 and 20, its required
    fields (the summary apart), then its own fields as `name=value`."""
    if not any(isinstance(x.get(k), dict) for k in ("required", "damage", "fields")):
        return x
    out = {"kind": x.get("kind"), "id": x.get("id")}
    damage = x.get("damage") if isinstance(x.get("damage"), dict) else {}
    for power in ("0", "10", "20"):
        out["damage@" + power] = damage.get(power)
    for k, v in (x.get("required") or {}).items():
        if k not in ("summary", "damage"):
            out[k] = v
    own = x.get("fields") if isinstance(x.get("fields"), dict) else {}
    out["own"] = " ".join("%s=%s" % (k, engine_cell(v)) for k, v in own.items()) or None
    return out


def engine_meta_text(r):
    """`engine meta`: every class as one table (the spec: the required fields, damage at power 0,
    10 and 20, then the class's own fields)."""
    rows = r.get("rows") or []
    if not rows:
        return "none"
    if all(isinstance(x, dict) for x in rows):
        rows = [engine_meta_row(x) for x in rows]
        columns = []
        for x in rows:
            columns += [k for k in x if k not in columns and k != "own"]
        if any("own" in x for x in rows):
            columns.append("own")
        return engine_table(rows, columns)
    return "\n".join("  ".join(engine_cell(v) for v in x) if isinstance(x, (list, tuple)) else engine_cell(x)
                     for x in rows)


def engine_world_text(r):
    """Every world setting a holder holds: its value, what it was, and who holds what."""
    lines = []
    for s in r.get("settings") or []:
        if not isinstance(s, dict):
            continue
        lines.append("%s = %s (it was %s)" % (s.get("name"), engine_cell(s.get("value")),
                                              engine_cell(s.get("original"))))
        for h in s.get("holds") or []:
            if isinstance(h, dict):
                lines.append("  held by %s: %s at priority %s since %s" % (
                    h.get("holder"), engine_cell(h.get("value")), engine_cell(h.get("priority")),
                    engine_when(h.get("since")) or "-"))
    return "\n".join(lines) or "no world setting is held"


def engine_instances_text(r):
    rows = [dict(i, started=engine_when(i.get("started")), ends=engine_when(i.get("ends")))
            for i in r.get("instances") or [] if isinstance(i, dict)]
    return engine_table(rows, ["instance", "kind", "id", "user", "started", "ends"]) if rows else "none"


def engine_log_text(r):
    """The engine's log lines: one it gave as {"t", "level", "msg", ...} as `<time> <level> <msg>`
    and its other fields as JSON; text as it is."""
    lines = []
    for x in r.get("lines") or []:
        if isinstance(x, dict) and "msg" in x:
            more = dict((k, v) for k, v in x.items() if k not in ("t", "at", "level", "msg"))
            lines.append(" ".join(str(b) for b in (engine_when(x.get("t", x.get("at"))), x.get("level") or "",
                                                    x["msg"], json.dumps(more, ensure_ascii=False) if more else "")
                                  if b).strip())
        else:
            lines.append(x if isinstance(x, str) else json.dumps(x, ensure_ascii=False))
    return "\n".join(lines) or "the log is empty"


def engine_args_of(c):
    """A class's Args as the engine gives them (classes, meta): [{"name", "type", "default", "bounds":
    {"ge", "le", ...}, "description"}], from a list of them or a {name: spec} map; [] with none."""
    spec = c.get("args") if isinstance(c, dict) else None
    if isinstance(spec, dict):
        spec = [dict(v, name=k) if isinstance(v, dict) else {"name": k, "type": str(v)} for k, v in spec.items()]
    return [x for x in spec or [] if isinstance(x, dict) and x.get("name")]


def engine_arg_text(x):
    """One arg as a line shows it: `count (whole number 1..100; default 10): how many`."""
    kind = str(x.get("type") or "?")
    bounds = x.get("bounds") if isinstance(x.get("bounds"), dict) else x
    lo = bounds.get("ge", bounds.get("gt"))
    hi = bounds.get("le", bounds.get("lt"))
    if lo is not None or hi is not None:
        kind += " %s..%s" % ("" if lo is None else engine_cell(lo), "" if hi is None else engine_cell(hi))
    default = json.dumps(x.get("default"), ensure_ascii=False) if "default" in x else "none: it must be given"
    text = "%s (%s; default %s)" % (x["name"], kind, default)
    return text + (": " + one_line(x["description"], 160) if x.get("description") else "")


def engine_incant_line(e):
    """`Steve: "fire ball" → casts fireball cooldown 5s; aliases fireball, fire bowl`, or for one
    bound to a scenario `Steve: "meteor" → starts meteor {"at":"caster"}; …`."""
    if e.get("scenario"):
        text = '%s: "%s" → starts %s %s' % (e.get("player"), e.get("phrase"), e["scenario"],
                                           json.dumps(e.get("args") or {}, ensure_ascii=False, separators=(",", ":")))
    else:
        text = '%s: "%s" → casts %s' % (e.get("player"), e.get("phrase"), e.get("ability"))
    cd = e.get("cooldown_s")
    if isinstance(cd, (int, float)) and not isinstance(cd, bool):
        text += " cooldown %ss" % fmt_s(float(cd))
    text += "; " + ("aliases " + ", ".join(e["aliases"]) if e.get("aliases") else "no aliases")
    if e.get("everyday_aliases"):
        text += "; everyday, not spotted: " + ", ".join(e["everyday_aliases"])
    return text


def engine_places_of(r):
    """The places op's places as rows, [{"name", "dim", "pos", "yaw", "by", "at"}], by name, from a
    list of them or a {name: place} map."""
    got = r.get("places")
    if isinstance(got, dict):
        got = [dict(v, name=k) for k, v in got.items() if isinstance(v, dict)]
    return sorted((p for p in got or [] if isinstance(p, dict) and p.get("name")), key=lambda p: str(p["name"]))


def engine_place_line(p):
    """`castle 197 68 251 overworld (castle_steve)`."""
    pos = p.get("pos") if isinstance(p.get("pos"), (list, tuple)) else []
    dim = str(p.get("dim") or "?").removeprefix("minecraft:")
    return "%s %s %s%s" % (p["name"], " ".join(engine_cell(round(float(c))) if isinstance(c, (int, float))
                                              else "?" for c in pos) or "?", dim,
                           " (%s)" % p["by"] if p.get("by") else "")


def engine_result(reply, scenario=""):
    """A start's answer: (its summary, its facts, whether it still runs) from the engine's reply:
    the scenario's result when it gave one, and "<scenario> is running as <instance>" (what
    engine_stop takes) while it goes on."""
    res = reply.get("result") if isinstance(reply.get("result"), dict) else {}
    facts = dict(res.get("facts") or {}) if isinstance(res.get("facts"), dict) else {}
    # ended within the wait: "ended" says why; still running: "running"; not waited for: neither
    running = bool(reply.get("running")) or "ended" not in reply
    if reply.get("instance"):
        facts.setdefault("instance", reply["instance"])
    summary = str(res.get("summary") or "").strip()
    if running and reply.get("instance"):
        summary = "; ".join(x for x in (summary, "%s is running as %s" % (scenario or "it", reply["instance"])) if x)
    if not summary:
        summary = "%s ended%s" % (reply.get("instance") or "it", " (%s)" % reply["ended"]
                                  if reply.get("ended") not in (None, "", "ended") else "")
    return summary, facts, running


def engine_said(op, args, reply):
    """What a done op did, in words: `granted fireball to Steve`."""
    who = args.get("who") or args.get("player") or ""
    if op == "grant":
        note = reply.get("note")
        return "granted %s to %s%s" % (args["ability"], who, " (%s)" % note if note else "")
    if op == "revoke":
        return "took %s away from %s" % (args["ability"], who)
    if op == "give":
        return "gave %s %s" % (who, args["item"])
    if op == "take":
        return "took every %s from %s" % (args["item"], who)
    if op == "apply":
        return "put %s on %s%s" % (args["mark"], who,
                                   " for %s s" % fmt_s(args["seconds"]) if args.get("seconds") else "")
    if op == "clear":
        return "took %s off %s" % (args["mark"], who)
    if op == "start":
        return engine_result(reply, args.get("scenario") or "")[0]
    if op == "stop":
        what = args.get("instance") or args.get("scenario")
        got = reply.get("stopped") if reply.get("stopped") is not None else reply.get("instance")
        got = [got] if isinstance(got, str) else list(got or [])
        return "stopped %s%s" % (what, " (%s)" % ", ".join(str(g) for g in got) if got and got != [what] else "")
    if op == "spawn":
        return "spawned %s%s" % (args["actor"], " as %s" % reply["uuid"] if reply.get("uuid") else "")
    if op == "unbind":
        return 'removed %s\'s incantation "%s"' % (who, args["phrase"])
    return "%s: done" % op


def engine_id(x, what):
    """An id the engine names a class by, or exit 2."""
    if not isinstance(x, str) or not ENGINE_ID_RE.match(x):
        shown = x if isinstance(x, str) and x.isprintable() else repr(x)
        raise Fail(2, "%s %s is not an engine class's name (a-z, 0-9 and _, starting with a letter), like "
                      "fireball — vfg engine classes" % (what, shown))
    return x


def engine_who(x):
    """A player's name or an actor's uuid, or exit 2."""
    if not isinstance(x, str) or not (PLAYER_RE.match(x) or UUID_RE.match(x)):
        raise Fail(2, "%r is not a player's name or an actor's uuid" % (x,))
    return x


def engine_player(x):
    if not isinstance(x, str) or not PLAYER_RE.match(x):
        raise Fail(2, "%r is not one player's name (letters, digits, _; at most 16): engine bindings, grants and "
                      "gives are per player, never @a" % (x,))
    return x


def engine_words(words):
    """`key=value` words as a scenario's or a mark's args (arg_word: JSON when a value starts with [
    or {, else its text)."""
    out = {}
    for w in words or []:
        k, eq, v = w.partition("=")
        if not eq or not KEY_RE.match(k):
            raise Fail(2, "%r is not key=value" % w)
        if k in out:
            raise Fail(2, "%s is given twice" % k)
        out[k] = arg_word(v)
    return out


def start_wait(cfg):
    """How long a start waits for a one-off scenario's result: VFG_ENGINE_START_WAIT_S, else 15 s,
    at most the engine's 30."""
    return setting(cfg, "VFG_ENGINE_START_WAIT_S", ENGINE_START_WAIT_S, 0.0, 30.0)


def cmd_engine(cfg, a):
    """vfg engine <op>: one of the engine's control ops, in words or with --json as it came."""
    op = a.op
    if op == "config":
        return cmd_engine_config(cfg, a)
    if op == "reload":
        return cmd_engine_reload(cfg, a)
    if op == "migrate":
        return cmd_engine_migrate(cfg, a)
    if op == "bind":
        if a.by is not None:
            check_task(a.by, "--by")
        if a.scenario and a.ability and "=" in a.ability:   # argparse takes the first key=value for the ability
            a.args, a.ability = [a.ability] + list(a.args), None
        if bool(a.ability) == bool(a.scenario):
            raise Fail(2, "bind to an ability (vfg engine bind <player> <phrase> <ability>) or a scenario "
                          "(--scenario <id> key=value …), one of them")
        if a.cooldown is not None and not a.scenario:
            raise Fail(2, "--cooldown is a scenario's incantation's: an ability's cooldown is its Config's "
                          "cooldown_s (vfg engine config get <ability>)")
        reply, said, notes, _ = engine_bind(cfg, a, a.player, a.phrase, ability=a.ability, scenario=a.scenario,
                                            args=engine_words(a.args), by=a.by or "", cooldown_s=a.cooldown)
        for n in notes if reply.get("ok") else ():   # a failure is one line on stderr
            warn(n)
        return engine_show(a, reply, said)
    if op == "status":
        return engine_show(a, engine_one(cfg, a, "status", {}), engine_status_text)
    if op == "classes":
        return engine_show(a, engine_one(cfg, a, "classes", {}), lambda r: engine_classes_text(cfg, r))
    if op == "overview":
        return engine_show(a, engine_overview(cfg, a), lambda r: "\n\n".join((
            engine_classes_text(cfg, r), engine_instances_text(r),
            "\n".join(engine_place_line(p) for p in engine_places_of(r)) or "no saved place",
            "\n".join(engine_incant_line(e) for e in r.get("incantations") or [] if isinstance(e, dict))
            or "no incantation")))
    if op == "meta":
        args = {"id": engine_id(a.id, "meta")} if a.id else {}
        return engine_show(a, engine_one(cfg, a, "meta", args), engine_meta_text)
    if op == "world":
        return engine_show(a, engine_one(cfg, a, "world", {}), engine_world_text)
    if op == "places":   # --json: the places as rows by name, as `overview` gives them
        reply = engine_one(cfg, a, "places", {})
        if reply.get("ok"):
            reply = dict(reply, places=engine_places_of(reply))
        return engine_show(a, reply, lambda r: "\n".join(engine_place_line(p) for p in r["places"]) or "none")
    if op == "instances":
        args = {}
        if a.kind:
            if a.kind not in ENGINE_KINDS:
                raise Fail(2, "--kind is one of %s" % ", ".join(ENGINE_KINDS))
            args["kind"] = a.kind
        if a.user:
            args["user"] = engine_who(a.user)
        return engine_show(a, engine_one(cfg, a, "instances", args), engine_instances_text)
    if op == "log":
        if not 1 <= a.n <= 1000:
            raise Fail(2, "-n is 1 to 1000")
        return engine_show(a, engine_one(cfg, a, "log", {"n": a.n}), engine_log_text)
    if op == "incantations":
        args = {"player": engine_player(a.player)} if a.player else {}
        return engine_show(a, engine_one(cfg, a, "incantations", args),
                           lambda r: "\n".join(engine_incant_line(e) for e in r.get("incantations") or []
                                               if isinstance(e, dict)) or "none")
    args = engine_args(op, a, cfg)
    reply = engine_one(cfg, a, op, args, timeout=ENGINE_TIMEOUT_S + float(args.get("wait_s") or 0))
    return engine_show(a, reply, lambda r: engine_said(op, args, r))


def engine_overview(cfg, a):
    """`engine overview`: the engine as the brain's world shows it, in one SSH call: {"ok",
    "classes", "instances", "places", "incantations"}, each as its own op gives it (`places` and
    `incantations` as lists). One the engine refused is left out and named in `error`, the others
    kept."""
    asked = (("classes", "classes"), ("instances", "instances"), ("places", "places"),
             ("incantations", "incantations"))
    replies = engine_ask(cfg, a, [(op, {}) for op, _ in asked])["replies"]
    got, errors = {"ok": True}, []
    for (op, key), reply in zip(asked, replies):
        if reply.get("ok") and isinstance(reply.get(key), (list, dict)):
            got[key] = engine_places_of(reply) if key == "places" else reply[key]
        else:
            errors.append("%s: %s" % (op, engine_error(reply)))
    if errors:
        got.update(ok=False, error="; ".join(errors))
    return got


def engine_args(op, a, cfg):
    """The args of grant, revoke, give, take, apply, clear, start, stop, spawn and unbind, from
    the command line, checked."""
    if op in ("grant", "revoke"):
        return {"who": engine_who(a.who), "ability": engine_id(a.ability, "ability")}
    if op in ("give", "take"):
        args = {"player": engine_player(a.player), "item": engine_id(a.item, "item")}
        if op == "give" and a.base:
            if not re.match(r"^(minecraft:)?[a-z0-9_]{1,64}\Z", a.base):
                raise Fail(2, "--base %s is not an item id, like carrot_on_a_stick" % a.base)
            args["base"] = a.base
        return args
    if op in ("apply", "clear"):
        args = {"who": engine_who(a.who), "mark": engine_id(a.mark, "mark")}
        if op == "apply":
            if a.seconds is not None:
                if not (0 < a.seconds <= 86400) or math.isnan(a.seconds):
                    raise Fail(2, "--seconds is more than 0, at most a day (86400)")
                args["seconds"] = a.seconds
            given = engine_words(a.args)
            if given:
                args["args"] = given
        return args
    if op == "start":
        wait = start_wait(cfg) if a.wait is None else a.wait
        if not 0 <= wait <= 30 or math.isnan(wait):
            raise Fail(2, "--wait is 0 to 30 seconds")
        args = {"scenario": engine_id(a.scenario, "scenario"), "args": engine_words(a.args)}
        return dict(args, wait_s=wait) if wait else args
    if op == "stop":
        if bool(a.scenario) == bool(a.instance):
            raise Fail(2, "stop what? a scenario's name, or --instance <instance> — vfg engine instances")
        if a.instance:
            if not ENGINE_INSTANCE_RE.match(a.instance):
                raise Fail(2, "--instance %r is not an instance's name — vfg engine instances" % a.instance)
            return {"instance": a.instance}
        return {"scenario": engine_id(a.scenario, "scenario")}
    if op == "spawn":
        args = {"actor": engine_id(a.actor, "actor")}
        if a.at and a.near:
            raise Fail(2, "--at or --near, not both")
        if a.at:
            try:
                at = [float(x) for x in a.at]
            except ValueError:
                raise Fail(2, "--at takes three numbers: x y z")
            if any(math.isnan(x) or math.isinf(x) for x in at):
                raise Fail(2, "--at takes three numbers: x y z")
            args["at"] = at
        elif a.near:
            args["near"] = engine_player(a.near)
        return args
    if op == "unbind":
        try:
            phrase = incantations_module().check_phrase(a.phrase)
        except ValueError as e:
            raise Fail(2, "phrase=%s: %s" % (a.phrase, e))
        return {"player": engine_player(a.player), "phrase": phrase}
    raise Fail(2, "unknown engine op %s" % op)


# ---- incantations

def engine_bind(cfg, a, player, phrase, ability="", scenario="", args=None, by="", cooldown_s=None):
    """A binding: `phrase`, for one player, casts `ability`, or starts `scenario` with `args` set
    once (an arg left as "caster" filled with whoever casts it): the spec's Incantations, per player,
    never @a. The phrase is checked and normalised as the kit does; the alias call runs in a thread
    while one SSH call reads the engine's classes, the player's bindings and the player's abilities;
    then the code's aliases and checks, the bind warnings against the player's other phrases, the
    everyday note, and one when the player has not been granted the ability; then the engine's bind
    op. (the reply, its words, the notes, the facts: its id, the binding as the engine stored it,
    and the alias call's)."""
    inc = incantations_module()
    if not player:
        raise Fail(2, "whose incantation? player=<the player who asked>: one player, never @a")
    player = engine_player(player)
    try:
        phrase = inc.check_phrase(phrase)
    except ValueError as e:
        raise Fail(2, "phrase=%s: %s" % (phrase, e))
    if bool(ability) == bool(scenario):
        raise Fail(2, "what does it do? ability=<an ability under ENGINE> to cast one, or scenario=<a scenario "
                      "under ENGINE> with its args to start one — one of them")
    kind, target = ("ability", ability) if ability else ("scenario", scenario)
    engine_id(target, kind)
    if ability and args:
        raise Fail(2, "an ability takes no args: its numbers are its Config, the same for everyone")
    import threading
    answer = []
    caller = threading.Thread(target=lambda: answer.append(incant_alias_call(cfg, phrase)), daemon=True)
    caller.start()
    got = engine_ask(cfg, a, [("classes", {}), ("incantations", {"player": player}),
                              ("instances", {"kind": "ability", "user": player})])
    classes, mine, granted = got["replies"]
    if not classes.get("ok"):
        return classes, "", [], {}
    have = sorted(str(c.get("id")) for c in classes.get("classes") or [] if isinstance(c, dict)
                  and c.get("kind") == kind)
    if target not in have:
        return {"ok": False, "error": "the engine has no %s %s (its %s: %s) — vfg engine classes"
                % (kind, target, "abilities" if ability else "scenarios", ", ".join(have) or "none")}, "", [], {}
    caller.join()
    variants, marked, everyday, why, call = answer[0] if answer else (
        [], [], False, "aliases from code only: the alias call failed", None)
    notes = [why] if why else []
    aliases, marks, dropped = incant_aliases(inc, phrase, variants, marked)
    if call is not None:
        call["dropped"] = dropped
    bound = [e for e in (mine.get("incantations") or []) if isinstance(e, dict)] if mine.get("ok") else []
    notes += incant_warnings(inc, phrase, aliases, player, bound)
    if everyday:
        notes.append('"%s" is everyday talk, so it will fire whenever it is said in conversation.' % phrase)
    if ability and granted.get("ok") and not any(isinstance(i, dict) and i.get("id") == ability
                                                 for i in granted.get("instances") or []):
        notes.append("%s does not have %s yet: saying it casts nothing until it is granted (engine_grant)"
                     % (player, ability))
    old = incant_find(inc, bound, player, phrase)
    if old:
        notes.append('replaces %s\'s "%s", which %s' % (old.get("player") or player, phrase,
                                                      "started %s" % old["scenario"] if old.get("scenario")
                                                      else "cast %s" % old.get("ability")))
    sent = {"player": player, "phrase": phrase, kind: target, "aliases": aliases, "everyday_aliases": marks,
            "by": by or ""}
    if scenario:
        sent["args"] = dict(args or {})
        if cooldown_s is not None:
            sent["cooldown_s"] = float(cooldown_s)
    reply = engine_one(cfg, a, "bind", sent)
    facts = {"alias_call": call} if call is not None else {}
    if not reply.get("ok"):
        return reply, "", notes, facts
    # The binding as the engine stored it (its `entry`, the incantations op's row): its aliases as
    # it kept them and its cooldown; what was sent, for an engine whose reply has none.
    entry = reply.get("entry") if isinstance(reply.get("entry"), dict) else {}
    row = dict((k, entry.get(k, sent.get(k))) for k in ("player", "phrase", kind, "aliases", "everyday_aliases"))
    row.update(id=entry.get("id") or reply.get("id"), cooldown_s=entry.get("cooldown_s"))
    if scenario:
        row["args"] = entry.get("args", sent["args"])
    facts.update(id=row["id"], entry=row)
    said = '"%s" for %s now %s; %s' % (row["phrase"], row["player"],
                                       "casts %s" % row["ability"] if ability else "starts %s%s" % (
                                           row["scenario"], " %s" % json.dumps(row["args"], ensure_ascii=False,
                                                                                separators=(",", ":"))
                                           if row.get("args") else ""),
                                       "aliases " + ", ".join(row["aliases"]) if row["aliases"] else "no aliases")
    return reply, said, notes, facts


# ---- the menu's engine actions

# The fields of an engine action whose op names them otherwise: grant's player is the op's who.
ENGINE_ARGS = {"grant": {"player": "who"}, "revoke": {"player": "who"}, "apply": {"player": "who"},
               "clear": {"player": "who"}}
ENGINE_NEEDS = {
    "grant": ("player", "ability"), "revoke": ("player", "ability"), "give": ("player", "item"),
    "take": ("player", "item"), "apply": ("player", "mark"), "clear": ("player", "mark"),
    "start": ("scenario",), "unbind": ("player", "phrase"),
}


def run_engine_action(cfg, a, name, va, cls, given, task=None):
    """An engine action (actions/engine_*.py), as vfg action run runs it: its values checked as any
    action's, then its op through the engine (a start waiting for a one-off's result, a bind with
    its aliases, a config through the rewrite): the one JSON line's dict, `running` true only for a
    scenario that goes on. The engine taking a request and not answering in time is
    exit 124, as an action that may still have happened."""
    cfg.require_ssh()
    op = va.engine_op(cls)
    try:
        checked = va.check_values(cls, given)
    except ValueError as e:
        raise Fail(2, str(e))
    v, notes = checked.values, list(checked.notes)
    running = False
    try:
        if op == "bind":
            reply, said, more, facts = engine_bind(cfg, a, v.get("player"), v.get("phrase"), ability=v.get("ability"),
                                                   scenario=v.get("scenario"), args=v.get("args"), by=task or "",
                                                   cooldown_s=v.get("cooldown_s"))
        elif op == "config":
            reply, said, more, facts = engine_config_set(cfg, a, v.get("class_id"), v.get("config"), by=task)
        else:
            for k in ENGINE_NEEDS.get(op, ()):
                if incant_blank(v.get(k)):
                    raise Fail(2, "%s needs %s=<%s>" % (name, k, "a player's name" if k == "player"
                                                        else "its name under ENGINE"))
            args = dict((ENGINE_ARGS.get(op, {}).get(k, k), x) for k, x in v.items()
                        if not incant_blank(x) and x != {} and not (k == "seconds" and not x))
            if op == "stop" and len([k for k in ("scenario", "instance") if k in args]) != 1:
                raise Fail(2, "engine_stop needs scenario=<its name> or instance=<its instance>, one of them")
            if op == "unbind":
                try:
                    args["phrase"] = incantations_module().check_phrase(args["phrase"])
                except ValueError as e:
                    raise Fail(2, "phrase=%s: %s" % (args["phrase"], e))
            if op == "start":
                args.setdefault("args", {})
                if start_wait(cfg):
                    args["wait_s"] = start_wait(cfg)
            reply = engine_one(cfg, a, op, args, timeout=ENGINE_TIMEOUT_S + float(args.get("wait_s") or 0))
            more = []
            if op == "start" and reply.get("ok"):
                said, facts, running = engine_result(reply, args.get("scenario") or "")
            else:
                said = engine_said(op, args, reply) if reply.get("ok") else ""
                facts = dict((k, x) for k, x in reply.items() if k not in ("ok", "error"))
    except EngineLate as f:
        raise Fail(124, "timed out: %s; it may still have happened" % f.msg)
    line = {"ok": bool(reply.get("ok")), "action": name, "running": running, "summary": said,
            "facts": facts, "notes": notes + more}
    if not reply.get("ok"):
        line["error"] = engine_error(reply)
    return line


# ---- content: the deploy and the reload

def content_dir(cfg):
    """made/<server>/content/ on this PC: where the engine's content classes are written."""
    return os.path.join(cfg.repo, "made", server_name(cfg), "content")


def content_rel(cfg, path):
    """A path in content_dir, as made/<server>/content/<rel> shows it."""
    return os.path.relpath(path, cfg.repo)


def engine_deploy(cfg, a, reload_, timeout=ENGINE_RELOAD_S):
    """made/<server>/content/ deployed whole to the box, then, with `reload_` (its files, by their
    paths in the folder, or "all"), reloaded there: remote/engine.py's object, its "deployed" and
    its "replies" (the reload's), with "down" or "timeout" when the engine did not answer."""
    folder = content_dir(cfg)
    if not os.path.isdir(folder):
        raise Fail(1, "no made/%s/content/ in %s: nothing to deploy" % (server_name(cfg), tilde(cfg.repo)))
    tar, _ = pack(["content"], os.path.dirname(folder))
    return engine_remote(cfg, a, {"op": "deploy", "server": server_name(cfg), "tar": tar, "reload": reload_,
                                  "timeout": timeout}, timeout)


def deployed_text(d):
    if not isinstance(d, dict):
        return "deployed nothing"
    if not d.get("swapped"):
        return "deployed %s: unchanged, %d files" % (d.get("folder"), d.get("files") or 0)
    bits = []
    if d.get("changed"):
        bits.append("changed " + ", ".join(d["changed"]))
    if d.get("removed"):
        bits.append("removed " + ", ".join(d["removed"]))
    return "deployed %s: %d files%s" % (d.get("folder"), d.get("files") or 0, "; " + "; ".join(bits) if bits else "")


def reload_text(cfg, r):
    """A reload's reply in words: what loaded, which check failed and why, how many instances
    switched, which stopped."""
    lines = ["loaded: " + (", ".join(str(x) for x in r.get("loaded") or []) or "nothing")]
    for e in r.get("errors") or []:
        if isinstance(e, dict):
            lines.append("refused %s%s: %s failed: %s — the old version keeps running" % (
                engine_file(cfg, e.get("file")) or "?", " (%s)" % e["class"] if e.get("class") else "",
                e.get("check") or "a check", one_line(e.get("error") or "", 600)))
        else:
            lines.append("refused: %s" % one_line(e, 600))
    switched = r.get("switched")
    lines.append("switched: %s running instance%s" % (engine_cell(switched), "" if switched == 1 else "s"))
    for s in r.get("stopped") or []:
        if isinstance(s, dict):
            lines.append("stopped %s: %s" % (s.get("instance"), one_line(s.get("reason") or "", 300)))
    return "\n".join(lines)


def problems_text(problems, most=400):
    """Problems in one line: one as it is; several numbered, (1) …; (2) …, as a problem may hold a
    semicolon of its own."""
    texts = [one_line(p, most) for p in problems]
    return texts[0] if len(texts) == 1 else "; ".join("(%d) %s" % (i + 1, t) for i, t in enumerate(texts))


def reload_refused(r):
    """Why a reload's reply is a refusal, or None: each check that failed and why (the engine's
    reply says only how many in its error), else its error when it is not ok."""
    errors = r.get("errors") or []
    if errors:
        return problems_text(["%s%s failed: %s" % ("%s's " % e["class"] if e.get("class") else "",
                                                   e.get("check") or "a check", e.get("error") or "")
                              if isinstance(e, dict) else e for e in errors], 600)
    if not r.get("ok"):
        return engine_error(r)
    return None


def cmd_engine_reload(cfg, a):
    """vfg engine reload [id …]: made/<server>/content/ deployed, then those files reloaded (every
    content dir when none is named): what loaded, what each failed check said, how many instances
    switched and which stopped. Exit 1 when a check failed."""
    folder = content_dir(cfg)
    files = []
    for x in a.ids:
        if not ENGINE_FILE_RE.match(x):
            raise Fail(2, "%r is not a content file's name: made/%s/content/<name>.py, like fireball"
                       % (x, server_name(cfg)))
        if not os.path.isfile(os.path.join(folder, x + ".py")):
            raise Fail(2, "there is no made/%s/content/%s.py" % (server_name(cfg), x))
        files.append(x + ".py")
    got = engine_deploy(cfg, a, files or "all")
    engine_faults(got, deployed_text(got.get("deployed")))
    reply = got["replies"][0]
    if a.json:
        out(json.dumps(dict(reply, deployed=got.get("deployed")), ensure_ascii=False))
    else:
        out(deployed_text(got.get("deployed")))
        if reply.get("ok") or "errors" in reply:
            out(reload_text(cfg, reply))
    why = reload_refused(reply)
    if why:
        raise Fail(1, why)
    return 0


# ---- a class's Config, rewritten

def rewrite_module():
    """engine/vfg_engine/rewrite.py, the engine's own (standard library only), loaded by its path
    once: find_config(source, class_name), splice(source, class_name, new_config) and
    static_checks(old_source, new_source, class_name)."""
    if not _REWRITE:
        import importlib.util
        if not os.path.isfile(REWRITE):
            raise Fail(3, "not configured: there is no engine/vfg_engine/rewrite.py beside this toolkit")
        spec = importlib.util.spec_from_file_location("vfg_engine_rewrite", REWRITE)
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod
        spec.loader.exec_module(mod)
        _REWRITE.append(mod)
    return _REWRITE[0]


def snake(name):
    """FireStaff -> fire_staff, IceQueenBoss -> ice_queen_boss: a class's id when it sets none, as the
    engine makes it (vfg_engine/content.py's snake)."""
    s = re.sub(r"(.)([A-Z][a-z]+)", r"\1_\2", name)
    return re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", s).lower()


def class_id(node):
    """A content class's id as the engine gives it (vfg_engine/content.py): the `id = "…"` its body
    sets (`id: ClassVar[str] = "…"` too), else its name in snake case."""
    import ast
    for b in node.body:
        targets = b.targets if isinstance(b, ast.Assign) else [b.target] if isinstance(b, ast.AnnAssign) else []
        if any(isinstance(t, ast.Name) and t.id == "id" for t in targets) \
                and isinstance(b.value, ast.Constant) and isinstance(b.value.value, str):
            return b.value.value
    return snake(node.name)


def content_class(source, wanted, line=None):
    """The name of the class in `source` whose Config is `wanted`'s: the top-level class that holds
    line `line` (where the engine says the Config is), else the one whose id (class_id) or name is
    `wanted`, else the only one with a Config. None when none fits, or two do."""
    import ast
    try:
        tree_ = ast.parse(source)
    except SyntaxError:
        return None
    classes = [n for n in tree_.body if isinstance(n, ast.ClassDef)
               and any(isinstance(b, ast.ClassDef) and b.name == "Config" for b in n.body)]
    if line is not None:
        for n in classes:
            if n.lineno <= line <= (n.end_lineno or n.lineno):
                return n.name
    hits = [n.name for n in classes if class_id(n) == wanted or n.name == wanted]
    if len(hits) == 1:
        return hits[0]
    return classes[0].name if len(classes) == 1 and not hits else None


def config_lines(source, start, end):
    """Lines start to end (1-based, both in) of `source`, as written."""
    return "".join(source.splitlines(True)[start - 1:end])


def fit_config(new, source, start):
    """The new Config class indented as the old one is in `source` (line `start`), whatever
    indentation it came with: its own dedented, then that indentation before each line that has
    anything on it; one line end at the end."""
    import textwrap
    lines = source.splitlines()
    first = lines[start - 1] if 0 < start <= len(lines) else ""
    indent = first[:len(first) - len(first.lstrip())]
    body = textwrap.dedent(new.expandtabs(4) if "\t" in new and "\t" not in indent else new).strip("\n")
    return "".join((indent + l if l.strip() else "") + "\n" for l in body.split("\n"))


class Target(object):
    """A class's Config, found: where the engine runs it, and where it is written on this PC.

    `path` is always this server's file, made/<server>/content/<rel>; `lib` the library's file of
    the same name on this PC (engine/library/<rel>) when the library has one; `from_library` true
    while the server has no version of its own yet, so `source` is the library's and a rewrite
    first copies it into `path`, which then shadows the library's (the engine runs a made class in
    place of the library's of the same id)."""

    def __init__(self, wanted, box, path, rel, source, name, start, end, lib=None, from_library=False):
        self.wanted, self.box, self.path, self.rel = wanted, box, path, rel
        self.source, self.name, self.start, self.end = source, name, start, end
        self.lib, self.from_library = lib, from_library

    @property
    def config(self):
        return config_lines(self.source, self.start, self.end)

    def shown(self, cfg):
        """The file the Config is read from, and whose: `engine/library/fireball.py (the library's)`,
        `made/main/content/fireball.py (this server's, over the library's)`, or the made file alone."""
        if self.from_library:
            return "%s (the library's)" % os.path.relpath(self.lib, cfg.repo)
        return content_rel(cfg, self.path) + (" (this server's, over the library's)" if self.lib else "")


def library_dir(cfg):
    """engine/library/ on this PC: the library's classes, which the box runs from <vfg>/engine/library/."""
    return os.path.join(cfg.repo, "engine", "library")


def config_target(cfg, a, wanted):
    """`wanted`'s Config: the engine says which file holds it (config_get), and this PC's copy of
    that file is read, its class found and the Config's lines in it (rewrite.find_config). A class
    the engine runs from made/<server>/content/ is read there; one it runs from the library is read
    from this server's own version of that file when there is one (not deployed yet: a warning),
    else from engine/library/ (from_library). (Target, None), or (None, the engine's refusal as a
    reply)."""
    if not isinstance(wanted, str) or not ENGINE_CLASS_RE.match(wanted):
        raise Fail(2, "%r is not an engine class's name, like fireball — vfg engine classes" % (wanted,))
    box = engine_one(cfg, a, "config_get", {"class": wanted})
    if not box.get("ok"):
        return None, box
    root = "%s/made/%s/content/" % (cfg.rvfg, server_name(cfg))
    lib_root = "%s/engine/library/" % cfg.rvfg
    where = str(box.get("file") or "")
    if where.startswith(root):
        rel = where[len(root):]
    elif where.startswith(lib_root):
        rel = where[len(lib_root):]
    else:
        raise Fail(1, "%s's Config is in %s, neither the library's nor in made/%s/content/: only those are "
                      "rewritten here" % (wanted, engine_file(cfg, where) or "a file the engine did not name",
                                          server_name(cfg)))
    path = os.path.join(content_dir(cfg), *rel.split("/"))
    lib = os.path.join(library_dir(cfg), *rel.split("/"))
    lib = lib if os.path.isfile(lib) else None
    from_library = where.startswith(lib_root) and not os.path.isfile(path)
    if where.startswith(lib_root) and not from_library:
        warn("the box runs the library's %s: this server's own, %s, is not deployed yet — vfg engine reload %s "
             "deploys it" % (wanted, content_rel(cfg, path), os.path.splitext(rel)[0]))
    read_from = lib if from_library else path
    try:
        if read_from is None:
            raise OSError(errno.ENOENT, "no such file")
        source = read_text(read_from)
    except OSError as e:
        raise Fail(1, "the engine runs %s from %s, which this PC does not have (%s): vfg made restore, or write it "
                      "there" % (wanted, engine_file(cfg, where) if from_library else content_rel(cfg, path),
                                 e.strerror or e))
    start = box.get("start") if isinstance(box.get("start"), int) else None
    same = isinstance(box.get("source"), str) and start is not None and \
        config_lines(source, start, box.get("end") or start) == box["source"]
    # The engine names the class (config_get's "class"); else it is found in the file.
    name = box.get("class") if isinstance(box.get("class"), str) and ENGINE_CLASS_RE.match(box["class"]) \
        else content_class(source, wanted, start if same else None)
    if name is None:
        raise Fail(1, "no class in %s holds %s's Config" % (content_rel(cfg, path), wanted))
    try:
        s, e = rewrite_module().find_config(source, name)
    except (ValueError, SyntaxError, LookupError) as err:
        raise Fail(1, "%s: %s's Config cannot be found: %s" % (os.path.relpath(read_from, cfg.repo), name, err))
    return Target(wanted, box, path, rel, source, name, s, e, lib, from_library), None


def history_dir(cfg):
    return os.path.join(content_dir(cfg), ".history")


LIBRARY_KEPT = ".library.py"   # a kept version that is the library's: undoing to it removes the server's copy


def keep_version(cfg, t):
    """The file as it is before a change to `t`'s Config, kept: .history/<file>/<time>-<Class>.py,
    or <time>-<Class>.library.py when it is the library's (the first rewrite of a library class)."""
    folder = os.path.join(history_dir(cfg), *os.path.splitext(t.rel)[0].split("/"))
    os.makedirs(folder, exist_ok=True)
    d = datetime.now(timezone.utc)
    path = os.path.join(folder, "%s-%06d-%s%s" % (d.strftime("%Y%m%d-%H%M%S"), d.microsecond, t.name,
                                                  LIBRARY_KEPT if t.from_library else ".py"))
    atomic_write(path, t.source, 0o644)
    return path


def kept_versions(cfg, t):
    """The kept versions of the file `t` is in, holding a change of `t`'s class, oldest first."""
    folder = os.path.join(history_dir(cfg), *os.path.splitext(t.rel)[0].split("/"))
    try:
        names = sorted(n for n in os.listdir(folder)
                       if n.endswith("-%s.py" % t.name) or n.endswith("-%s%s" % (t.name, LIBRARY_KEPT)))
    except OSError:
        return []
    return [os.path.join(folder, n) for n in names]


def history_log(cfg, row):
    """One line of .history/log.jsonl: every change, and every one refused."""
    try:
        os.makedirs(history_dir(cfg), exist_ok=True)
        append_line(os.path.join(history_dir(cfg), "log.jsonl"), json.dumps(dict({"at": now_iso()}, **row),
                                                                            ensure_ascii=False) + "\n", 0o644)
    except OSError as e:
        warn("the content history's log not written: %s" % e)


def engine_change(cfg, a, t, new_source, how, by=None, kept=None):
    """`t`'s file as `new_source` on this PC (None: removed, the library's version running again),
    deployed and reloaded; when the box refuses it, or does not answer, the file put back as it was
    (removed again, for a library class's first rewrite) and deployed again, and the refusal
    returned: (the reply, ok with the reload's, or a refusal; notes)."""
    notes = []
    if new_source is None:
        os.remove(t.path)
    else:
        os.makedirs(os.path.dirname(t.path), exist_ok=True)
        atomic_write(t.path, new_source, 0o644)
    # A file there is reloaded alone; a file gone needs the full reload, which unloads it and runs
    # the library's version again.
    reload_new = [t.rel] if new_source is not None else "all"
    reload_old = "all" if t.from_library else [t.rel]

    def put_back(why, code=None, reload_old_too=False):
        if t.from_library:
            try:
                os.remove(t.path)
            except OSError:
                pass
        else:
            atomic_write(t.path, t.source, 0o644)
        if kept:
            try:
                os.remove(kept)
            except OSError:
                pass
        history_log(cfg, {"op": how, "class": t.wanted, "class_name": t.name, "file": content_rel(cfg, t.path),
                          "ok": False, "error": why, "by": by})
        said = "%s; %s is %s on this PC" % (why, content_rel(cfg, t.path),
                                            "removed again" if t.from_library else "put back as it was")
        try:
            again = engine_deploy(cfg, a, reload_old if reload_old_too else None, ENGINE_CONFIG_S)
            if reload_old_too:
                engine_faults(again)
            said += ", and on the box: the old version keeps running"
        except Fail as f:
            said += ", but could not be deployed again (%s): vfg engine reload %s deploys it" % (
                f.msg, os.path.splitext(t.rel)[0])
        if code is not None:
            raise Fail(code, said)
        return {"ok": False, "error": said}

    try:
        got = engine_deploy(cfg, a, reload_new, ENGINE_CONFIG_S)
    except Fail as f:
        return put_back("the deploy failed (%s)" % f.msg, f.code), notes
    if got.get("down"):
        return put_back("deployed, but %s" % got["down"], ENGINE_DOWN), notes
    if got.get("timeout"):
        return put_back("deployed, but %s" % got["timeout"], 4, reload_old_too=True), notes
    reply = got["replies"][0]
    why = reload_refused(reply)
    if why:
        return put_back("the engine refused %s's new Config: %s" % (t.wanted, why)), notes
    history_log(cfg, {"op": how, "class": t.wanted, "class_name": t.name, "file": content_rel(cfg, t.path),
                      "ok": True, "kept": os.path.relpath(kept, content_dir(cfg)) if kept else None, "by": by,
                      **({"library": True} if t.from_library or new_source is None else {})})
    if t.from_library:
        notes.append("%s was the library's: %s now holds this server's own version, which runs in its place "
                     "(vfg engine config undo puts the library's back)" % (t.wanted, content_rel(cfg, t.path)))
    return dict(reply, deployed=got.get("deployed")), notes


def config_said(t, reply, what):
    switched = reply.get("switched")
    bits = ["%s for everyone" % what]
    if isinstance(switched, int):
        bits.append("%d running instance%s switched" % (switched, "" if switched == 1 else "s"))
    stopped = [s.get("instance") for s in reply.get("stopped") or [] if isinstance(s, dict)]
    if stopped:
        bits.append("stopped: " + ", ".join(str(s) for s in stopped))
    return "; ".join(bits)


def engine_config_set(cfg, a, wanted, new_config, by=None):
    """`config set`: the whole new Config class of `wanted` spliced into its file on this PC in
    place of the old one (rewrite.splice), the static checks run (rewrite.static_checks), the old
    file kept, then deployed and reloaded (engine_change). (the reply, its words, notes, facts);
    a refusal is a reply whose ok is false, its error the check's or the engine's, and nothing changed."""
    if not isinstance(new_config, str) or not new_config.strip():
        raise Fail(2, "the new Config is empty: the whole class Config, as Python, from its class Config line on")
    cfg.ensure_home()
    with flocked(os.path.join(cfg.home, "engine.lock")):
        t, refused = config_target(cfg, a, wanted)
        if refused is not None:
            return refused, "", [], {}
        rw = rewrite_module()
        try:
            new_source = rw.splice(t.source, t.name, fit_config(new_config, t.source, t.start))
        except (ValueError, SyntaxError, LookupError) as e:
            return {"ok": False, "error": "%s's new Config could not be put in place: %s; nothing changed"
                    % (wanted, one_line(e, 600))}, "", [], {}
        problems = rw.static_checks(t.source, new_source, t.name)
        if problems:
            history_log(cfg, {"op": "set", "class": wanted, "class_name": t.name, "file": content_rel(cfg, t.path),
                              "ok": False, "error": problems_text(problems), "by": by})
            return {"ok": False, "error": "%s's new Config was refused before it was sent: %s; nothing changed, the "
                    "old version keeps running" % (wanted, problems_text(problems))}, "", [], {}
        if new_source == t.source:
            return {"ok": True, "changed": []}, "%s's Config is already as written: nothing changed" % wanted, [], \
                {"changed": []}
        kept = keep_version(cfg, t)
        reply, notes = engine_change(cfg, a, t, new_source, "set", by, kept)
    if not reply.get("ok"):
        return reply, "", notes, {}
    facts = dict((k, reply.get(k)) for k in ("loaded", "switched", "stopped", "errors") if k in reply)
    facts.update(changed=[wanted], file=content_rel(cfg, t.path), kept=os.path.relpath(kept, content_dir(cfg)))
    if t.from_library:
        facts["copied_from"] = os.path.relpath(t.lib, cfg.repo)
    return reply, config_said(t, reply, "%s's new Config is in%s, " % (
        wanted, " (this server's own copy of the library's)" if t.from_library else "") + "and reloaded"), notes, facts


def engine_config_undo(cfg, a, wanted, by=None):
    """`config undo`: the Config of `wanted`'s last kept version spliced back into its file, the
    static checks run, deployed and reloaded as a set is; then that version moved to undone/, so
    the next undo goes one further back. A refusal changes nothing and keeps the version."""
    cfg.ensure_home()
    with flocked(os.path.join(cfg.home, "engine.lock")):
        t, refused = config_target(cfg, a, wanted)
        if refused is not None:
            return refused, ""
        versions = kept_versions(cfg, t)
        if not versions:
            return {"ok": False, "error": "no kept version of %s's Config to put back: none was rewritten with vfg "
                    "engine config set" % wanted}, ""
        last = versions[-1]
        if last.endswith(LIBRARY_KEPT):
            # the first rewrite of a library class: undoing it removes this server's copy, and the
            # library's version runs again
            reply, _ = engine_change(cfg, a, t, None, "undo", by)
            said = config_said(t, reply, "%s's Config is the library's again (%s removed), " % (
                wanted, content_rel(cfg, t.path)) + "and reloaded") if reply.get("ok") else ""
            if reply.get("ok"):
                undone = os.path.join(os.path.dirname(last), "undone")
                os.makedirs(undone, exist_ok=True)
                os.replace(last, os.path.join(undone, os.path.basename(last)))
            return reply, said
        rw = rewrite_module()
        old = read_text(last)
        try:
            s, e = rw.find_config(old, t.name)
            new_source = rw.splice(t.source, t.name, fit_config(config_lines(old, s, e), t.source, t.start))
        except (ValueError, SyntaxError, LookupError) as err:
            return {"ok": False, "error": "%s's kept Config (%s) could not be put back: %s" % (
                wanted, os.path.relpath(last, history_dir(cfg)), one_line(err, 600))}, ""
        problems = rw.static_checks(t.source, new_source, t.name)
        if problems:
            return {"ok": False, "error": "%s's kept Config (%s) no longer fits its class as it is now: %s; nothing "
                    "changed" % (wanted, os.path.relpath(last, history_dir(cfg)), problems_text(problems))}, ""
        if new_source == t.source:
            reply, said = {"ok": True, "changed": []}, "%s's Config is already as kept: nothing changed" % wanted
        else:
            reply, _ = engine_change(cfg, a, t, new_source, "undo", by)
            said = config_said(t, reply, "%s's Config is back as it was (%s), " % (
                wanted, os.path.basename(last)) + "and reloaded") if reply.get("ok") else ""
        if reply.get("ok"):
            undone = os.path.join(os.path.dirname(last), "undone")
            os.makedirs(undone, exist_ok=True)
            os.replace(last, os.path.join(undone, os.path.basename(last)))
    return reply, said


def cmd_engine_config(cfg, a):
    """vfg engine config get|set|undo <class>."""
    if a.config_op == "get":
        t, refused = config_target(cfg, a, a.cls)
        if refused is not None:
            return engine_show(a, refused, "")
        box = t.box
        if isinstance(box.get("source"), str) and box["source"] != t.config and not (
                t.lib and not t.from_library and str(box.get("file") or "").startswith(cfg.rvfg + "/engine/")):
            warn("the box runs another version of this Config than %s holds: this PC's is shown, which vfg engine "
                 "reload %s deploys" % (t.shown(cfg).split(" ")[0], os.path.splitext(t.rel)[0]))
        if a.json:
            out(json.dumps({"ok": True, "class": t.wanted, "class_name": t.name,
                            "file": os.path.relpath(t.lib, cfg.repo) if t.from_library else content_rel(cfg, t.path),
                            "whose": "library" if t.from_library else "server", "library": bool(t.lib),
                            "start": t.start, "end": t.end, "source": t.config}, ensure_ascii=False))
            return 0
        out("%s, lines %d to %d: the Config of %s, as written\n%s" % (t.shown(cfg), t.start, t.end, t.name,
                                                                     t.config.rstrip("\n")))
        return 0
    if a.config_op == "set":
        reply, said, notes, facts = engine_config_set(cfg, a, a.cls, sys.stdin.read())
        for n in notes if reply.get("ok") else ():
            warn(n)
        return engine_show(a, dict(reply, **facts) if reply.get("ok") else reply, said)
    reply, said = engine_config_undo(cfg, a, a.cls)
    return engine_show(a, reply, said)


# ---- the one-time move off the old system

# The old system kept places in Minecraft's command storage everhear:places and incantations in
# /opt/vfg/incantations.json, each bound to an action (the game engine spec, part 2: Jesse,
# 2026-10-13, "one single place"). `vfg engine migrate` moves both into the engine once: the places
# through `places_import`, and each binding onto an engine binding of the class that took its
# action over, by lib/migrate_map.py's table: an ability cast, or a scenario started with the
# binding's own values translated into its args (a caster field left as "caster"). An action with
# no row, or one the table refuses, is reported and left, never guessed; an @a binding is split over
# the players named (--players), else every player another binding names.

def migrate_plan(store, players):
    """The old store's bindings as engine binds: ([{"from", "player", "phrase", "kind", "id", "args",
    "aliases", "everyday_aliases", "by", "cooldown_s", "notes"}], [{"from", "why"}] left behind)."""
    table = lib_module("migrate_map")
    rows = [e for e in store.get("incantations") or [] if isinstance(e, dict)]
    named = sorted(set(str(e.get("player")) for e in rows if PLAYER_RE.match(str(e.get("player") or ""))),
                   key=str.lower)
    plan, left = [], []
    for e in rows:
        source = "%s \"%s\" (%s)" % (e.get("player"), e.get("phrase"), e.get("action"))
        try:
            kind, cid, args, notes = table.translate(str(e.get("action") or ""), e)
        except table.Refused as r:
            left.append({"from": source, "why": str(r)})
            continue
        who = [str(e.get("player"))] if e.get("player") != "@a" else list(players or named)
        if not who:
            left.append({"from": source, "why": "it is everyone's (@a) and no player is named to split it over: "
                                                "give --players"})
            continue
        for p in who:
            plan.append({"from": source, "player": p, "phrase": e.get("phrase"), "kind": kind, "id": cid,
                         "args": dict(args), "aliases": list(e.get("aliases") or []),
                         "everyday_aliases": list(e.get("everyday_aliases") or []), "by": e.get("by") or "",
                         "cooldown_s": e.get("cooldown_s"), "notes": list(notes)})
    return plan, left


def cmd_engine_migrate(cfg, a):
    """vfg engine migrate [--players a,b] [--dry-run] [--json]: the old places and incantations
    moved into the engine, once (lib/migrate_map.py). One SSH call reads them (remote/migrate.py), then
    one `places_import` and one bind a binding; with --dry-run, only what it would do. Exit 1 when
    anything was left behind or refused; the rest still moves."""
    players = []
    if a.players:
        players = [p.strip() for p in a.players.split(",") if p.strip()]
        for p in players:
            engine_player(p)
    rc, o, e = remote(cfg, a, "migrate.py", {}, 60, libs=("places.py",))
    if rc != 0:
        finish(rc, b"", e)
    try:
        old = json.loads(o.decode("utf-8").strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise Fail(1, "remote/migrate.py answered something that is not JSON")
    places = [dict(v, name=k) for k, v in sorted((old.get("places") or {}).items()) if isinstance(v, dict)]
    plan, left = migrate_plan(old.get("store") or {}, players)
    for key in ("places_error", "store_error"):
        if old.get(key):
            left.append({"from": "the old places" if key == "places_error" else "the old incantations",
                         "why": old[key]})
    report = {"ok": True, "dry_run": bool(a.dry_run), "places": {"found": len(places)}, "bindings": [],
              "left": left}
    if not a.dry_run and places:
        reply = engine_one(cfg, a, "places_import", dict({"places": places}, **({"force": True} if a.force else {})))
        report["places"].update(dict((k, v) for k, v in reply.items() if k != "ok"), ok=reply.get("ok"))
    for b in plan:
        row = dict((k, b[k]) for k in ("from", "player", "phrase", "kind", "id", "args", "notes"))
        if not a.dry_run:
            sent = {"player": b["player"], "phrase": b["phrase"], b["kind"]: b["id"], "aliases": b["aliases"],
                    "everyday_aliases": b["everyday_aliases"], "by": b["by"]}
            if b["kind"] == "scenario":
                sent["args"] = b["args"]
                if isinstance(b["cooldown_s"], (int, float)) and not isinstance(b["cooldown_s"], bool):
                    sent["cooldown_s"] = float(b["cooldown_s"])
            reply = engine_one(cfg, a, "bind", sent)
            row["ok"] = bool(reply.get("ok"))
            if not reply.get("ok"):
                row["error"] = engine_error(reply)
        report["bindings"].append(row)
    failed = [b for b in report["bindings"] if b.get("ok") is False]
    if left or failed or report["places"].get("ok") is False:
        report["ok"] = False
    if a.json:
        out(json.dumps(report, ensure_ascii=False))
    else:
        verb = "would move" if a.dry_run else "moved"
        lines = ["places: %d found%s" % (len(places), "" if a.dry_run or not places else
                                         ", imported" if report["places"].get("ok") else
                                         ", refused: %s" % report["places"].get("error"))]
        for b in report["bindings"]:
            what = "%s %s%s" % ("casts" if b["kind"] == "ability" else "starts", b["id"],
                                " %s" % json.dumps(b["args"], ensure_ascii=False, separators=(",", ":"))
                                if b["args"] else "")
            state = "" if a.dry_run or b.get("ok") else " — refused: %s" % b.get("error")
            lines.append('%s %s: %s "%s" %s%s' % (verb, b["from"], b["player"], b["phrase"], what, state))
            lines += ["  note: %s" % n for n in b["notes"]]
        lines += ["left %s: %s" % (x["from"], x["why"]) for x in left]
        out("\n".join(lines))
    if not report["ok"]:
        raise Fail(1, "%d left behind, %d refused%s" % (len(left), len(failed),
                                                        "; the places import was refused" if
                                                        report["places"].get("ok") is False else ""))
    return 0


# ------------------------------------------------------------------- made

# What this server's implementers made, made/<server>/ (content/, the engine's classes, and
# tests/), is kept out of git; `vfg made save` copies it after a run into a new folder
# $VFG_MADE_ARCHIVE/<save>/, named to the second (2026-10-10-142301), and never deletes one; `vfg
# made restore <save>` puts one back, and `vfg made restore <date>` that day's latest.
MADE_ARCHIVE = "/var/home/jm/Documents/EverHear/Internal/made"
SAVE_RE = re.compile(r"^[0-9][0-9A-Za-z_.-]{0,63}$")
DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def copy_tree(src, dest):
    """src copied to dest whole (no caches, no dotfiles), through dest's temp twin; files copied."""
    import shutil
    tmp = os.path.join(os.path.dirname(dest), ".%s.new-%d" % (os.path.basename(dest), os.getpid()))
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, ignore=shutil.ignore_patterns("__pycache__", ".*", "*.pyc"))
    n = sum(len(files) for _, _, files in os.walk(tmp))
    old = None
    if os.path.lexists(dest):
        old = os.path.join(os.path.dirname(dest), ".%s.old-%d" % (os.path.basename(dest), os.getpid()))
        os.rename(dest, old)
    os.rename(tmp, dest)
    return n, old


def saves(archive):
    """The saves in the archive, oldest first: their names sort as their times."""
    try:
        names = os.listdir(archive)
    except OSError:
        return []
    return sorted(d for d in names if SAVE_RE.match(d) and os.path.isdir(os.path.join(archive, d)))


def save_named(archive, name):
    """A save by its full name, or a date's latest (a folder named by the day alone, as an
    older vfg saved, counts as that day's earliest); None when there is none."""
    have = saves(archive)
    if name in have:
        return name
    if DAY_RE.match(name):
        day = [d for d in have if d == name or d.startswith(name + "-")]
        if day:
            return day[-1]
    return None


MADE_FOLDERS = ("content", "tests")   # what made/<server>/ holds for the engine: its classes and their tests


def cmd_made(cfg, a):
    """vfg made save|restore: made/<server>/content/ and tests/ (the engine's classes this server's
    implementers wrote, and their tests) copied whole to a new save in the archive, or back from
    one. A save from before the engine (scripts and actions only) restores nothing."""
    server = server_name(cfg)
    here = os.path.join(cfg.repo, "made", server)
    archive = os.path.expanduser(cfg.get("VFG_MADE_ARCHIVE") or MADE_ARCHIVE)
    if a.op == "save":
        have = [f for f in MADE_FOLDERS if os.path.isdir(os.path.join(here, f)) and os.listdir(os.path.join(here, f))]
        if not have:
            raise Fail(1, "nothing to save: made/%s/ has no content/ or tests/" % server)
        os.makedirs(archive, exist_ok=True)
        # A new folder each time, named to the second: one saved this second already waits for the next.
        while True:
            dest = os.path.join(archive, datetime.now().strftime("%Y-%m-%d-%H%M%S"))
            if not os.path.lexists(dest):
                break
            time.sleep(0.2)
        os.makedirs(dest)
        n = sum(copy_tree(os.path.join(here, f), os.path.join(dest, f))[0] for f in have)
        out("saved made/%s/%s to %s: %d file%s" % (server, " and ".join(f + "/" for f in have), tilde(dest), n,
                                                   "" if n == 1 else "s"))
        return 0
    name = save_named(archive, a.save) if SAVE_RE.match(a.save) else None
    if name is None:
        raise Fail(1, "no save %s in %s; saved: %s" % (a.save, tilde(archive), ", ".join(saves(archive)) or "none"))
    src = os.path.join(archive, name)
    have = [f for f in MADE_FOLDERS if os.path.isdir(os.path.join(src, f))]
    if not have:
        raise Fail(1, "save %s holds no content/ or tests/: it is from before the engine (its scripts and actions "
                      "are not engine classes)" % name)
    os.makedirs(here, exist_ok=True)
    n, replaced = 0, []
    # What it replaces is kept, hidden, until someone deletes it: in a folder of its own, one a
    # restore earlier this second already took getting -2, -3 ...
    keep = os.path.join(cfg.repo, "made", ".replaced", "%s-%s" % (server, time.strftime("%Y%m%d-%H%M%S")))
    k, first = 2, keep
    while os.path.lexists(keep):
        keep, k = "%s-%d" % (first, k), k + 1
    for f in have:
        got, old = copy_tree(os.path.join(src, f), os.path.join(here, f))
        n += got
        if old:
            base = os.path.join(keep, f)
            os.makedirs(keep, exist_ok=True)
            os.rename(old, base)
            replaced.append(os.path.relpath(base, cfg.repo))
    line = "restored made/%s/%s from %s: %d file%s" % (server, " and ".join(f + "/" for f in have), tilde(src), n,
                                                       "" if n == 1 else "s")
    if replaced:
        line += "; what it replaced is in %s" % ", ".join(replaced)
    out(line + "; vfg engine reload loads it")
    return 0


