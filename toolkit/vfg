def read_settings(path):
    """KEY=value lines (export allowed, quotes taken off), as Config reads ~/.vfg/config."""
    found = {}
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            if line.startswith("export "):
                line = line[7:].lstrip()
            key, value = (x.strip() for x in line.split("=", 1))
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            found[key] = value
    return found


class TestBox(Config):
    """The live config, with the test box's keys (TEST_BOX_KEYS) from VFG_TEST_BOX's file over it."""

    def __init__(self, path):
        Config.__init__(self)
        self.box_file = path
        self.box = dict((k, v) for k, v in read_settings(path).items() if k in TEST_BOX_KEYS and v)

    def get(self, key):
        if key in self.box:
            value = self.box[key]
            return os.path.expanduser(value) if key in self.PATHS and value.startswith("~") else value
        return Config.get(self, key)


def test_box(cfg):
    """The test server's config; Fail 3 when there is none, or when it is the live box itself."""
    path = os.path.expanduser(cfg.get("VFG_TEST_BOX"))
    if not path:
        raise Fail(3, "no test server: VFG_TEST_BOX names none (a file of its box's settings); "
                      "check it on the live server with one vfg engine start, grant, give or apply instead")
    try:
        box = TestBox(path)
    except OSError as e:
        raise Fail(3, "not configured: VFG_TEST_BOX's file cannot be read (%s)" % (e.strerror or e))
    if box.get("VFG_SSH_HOST") == cfg.get("VFG_SSH_HOST") and (box.rvfg == cfg.rvfg or box.rmc == cfg.rmc):
        raise Fail(3, "not configured: VFG_TEST_BOX names the live server itself (%s on %s); a test never "
                      "runs there" % (box.rvfg if box.rvfg == cfg.rvfg else box.rmc, box.get("VFG_SSH_HOST")))
    return box


# What a test changed since its last run, shown before its results (visibility only: the test is
# the implementer's to change). The last run's file is kept on this PC, $VFG_HOME/tests/<server>/<name>.py;
# the changes are read from its t.check(...) calls, the things it puts on the stage and how it sets
# the content off.
TEST_STAGE = ("mob", "blocks", "ground", "region", "player", "stand_in")
TEST_TRIGGER = ("cast", "use", "start", "apply", "grant", "give", "bind", "spawn", "sneak", "look")


def test_memory(cfg, name):
    return os.path.join(cfg.home, "tests", server_name(cfg), name + ".py")


def _test_calls(tree_):
    """(checks {(item, n): verdict node}, stage {key: call}, trigger [call]) of a test's AST."""
    import ast
    checks, stage, trigger, seen = {}, {}, [], {}
    named = dict((id(n.value), n.targets[0].id) for n in ast.walk(tree_)
                 if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name))
    calls = sorted((n for n in ast.walk(tree_) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)),
                   key=lambda n: (n.lineno, n.col_offset))
    for n in calls:
        attr = n.func.attr
        if attr == "check" and len(n.args) >= 2:
            item = n.args[0].value if isinstance(n.args[0], ast.Constant) else ast.unparse(n.args[0])
            k = seen[("c", item)] = seen.get(("c", item), -1) + 1
            checks[(str(item), k)] = n.args[1]
        elif attr in TEST_STAGE and isinstance(n.func.value, ast.Name):
            what = named.get(id(n)) or "%s %s" % (attr, n.args[0].value if n.args and isinstance(n.args[0], ast.Constant)
                                                  else "")
            k = seen[("s", what)] = seen.get(("s", what), -1) + 1
            stage[(what.strip(), k)] = n
        elif attr in TEST_TRIGGER and isinstance(n.func.value, ast.Name):
            trigger.append(ast.unparse(n))
    return checks, stage, trigger


def _numbers(node):
    """(the node's source with each number as #, its numbers in order)."""
    import ast
    import copy
    nums, node = [], copy.deepcopy(node)
    for n in ast.walk(node):
        if isinstance(n, ast.UnaryOp) and isinstance(n.op, ast.USub) and isinstance(n.operand, ast.Constant) \
                and isinstance(n.operand.value, (int, float)) and not isinstance(n.operand.value, bool):
            n.operand.value = -n.operand.value
            n.op = ast.UAdd()
    for n in ast.walk(node):
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)) and not isinstance(n.value, bool):
            nums.append(n.value)
            n.value = 0
    return ast.unparse(node), nums


def test_changes(old, new):
    """One line per meaningful change from the test `old` to `new`: a check removed, added or
    renamed, a bar lowered or raised (a number in a check's call smaller or larger), a check
    changed otherwise, a target moved or changed or removed, the trigger changed. [] when either
    does not parse."""
    import ast
    try:
        (oc, os_, ot), (nc, ns, nt) = _test_calls(ast.parse(old)), _test_calls(ast.parse(new))
    except SyntaxError:
        return []
    short = lambda n: (lambda t: t if len(t) <= 120 else t[:117] + "...")(ast.unparse(n))  # noqa: E731
    lines = []
    gone = [k for k in oc if k not in nc]
    came = [k for k in nc if k not in oc]
    for k in list(gone):   # the same verdict under another item: renamed
        same = [c for c in came if ast.unparse(nc[c]) == ast.unparse(oc[k])]
        if same:
            lines.append('check renamed: "%s" -> "%s"' % (k[0], same[0][0]))
            gone.remove(k)
            came.remove(same[0])
    lines += ['check removed: "%s" (%s)' % (k[0], short(oc[k])) for k in gone]
    lines += ['check added: "%s" (%s)' % (k[0], short(nc[k])) for k in came]
    for k in oc:
        if k not in nc or ast.unparse(oc[k]) == ast.unparse(nc[k]):
            continue
        (shape0, n0), (shape1, n1) = _numbers(oc[k]), _numbers(nc[k])
        if shape0 == shape1:
            down, up = any(b < a for a, b in zip(n0, n1)), any(b > a for a, b in zip(n0, n1))
            word = "bar lowered" if down and not up else "bar raised" if up and not down else "bars changed"
        else:
            word = "check changed"
        lines.append('%s: "%s": %s -> %s' % (word, k[0], short(oc[k]), short(nc[k])))
    for k, call in os_.items():
        if k not in ns:
            lines.append("target removed: %s (%s)" % (k[0], short(call)))
            continue
        if ast.unparse(call) == ast.unparse(ns[k]):
            continue
        pos0 = [ast.unparse(x) for x in call.args] + [ast.unparse(w) for w in call.keywords
                                                       if w.arg in ("right", "up", "forward", "size")]
        pos1 = [ast.unparse(x) for x in ns[k].args] + [ast.unparse(w) for w in ns[k].keywords
                                                        if w.arg in ("right", "up", "forward", "size")]
        lines.append("target %s: %s: %s -> %s" % ("moved" if pos0 != pos1 else "changed", k[0], short(call),
                                                  short(ns[k])))
    if ot != nt:
        lines.append("trigger: %s -> %s" % ("; ".join(ot)[:150] or "none", "; ".join(nt)[:150] or "none"))
    return lines


def test_bindings(cfg, a, name):
    """The bindings the task made on the live server, as livetest's --bindings takes them: [{player,
    phrase, ability | scenario and args, aliases, everyday_aliases}]. Its bindings are those its row
    records (made.bindings, the engine's ids) and any the engine says it made (`by`); [] with a
    note when the live engine cannot be read."""
    try:
        reply = engine_one(cfg, a, "incantations", {})
    except Fail as f:
        warn("the live engine's bindings were not read (%s): the test's engine has only its own" % f.msg)
        return []
    ids = set()
    if TASK_RE.match(name):
        try:
            rows = task_read(cfg, {"open": False, "name": name}, ENGINE_TIMEOUT_S)
        except Fail:
            rows = []
        made = rows[0].get("made") if rows and isinstance(rows[0].get("made"), dict) else {}
        ids = set(str(x) for x in made.get("bindings") or [])
    keep = ("player", "phrase", "ability", "scenario", "args", "aliases", "everyday_aliases")
    return [dict((k, e[k]) for k in keep if e.get(k) not in (None, "", {})) for e in reply.get("incantations") or []
            if isinstance(e, dict) and (e.get("by") == name or e.get("id") in ids)]


def cmd_test(cfg, a):
    """vfg test <name>: the test of a task's content, made/<server>/tests/<name>.py, on the test
    server's own engine (livetest), its report printed; exit 0 when no check failed. With no test
    yet, it gets the skeleton."""
    name = a.name
    if not TASK_RE.match(name or "") and not ENGINE_ID_RE.match(name or ""):
        raise Fail(2, "%s is not a task's or a class's name" % name)
    if a.n is not None and not 0 <= a.n <= 500:
        raise Fail(2, "-n is a number of the engine's log lines, 0 to 500")
    timeout = a.test_timeout if a.test_timeout is not None else setting(cfg, "VFG_TEST_TIMEOUT_S", TEST_TIMEOUT, 5, 600)
    if not 5 <= timeout <= 600:
        raise Fail(2, "--timeout is 5 to 600 seconds")
    made = os.path.join(cfg.repo, "made", server_name(cfg))
    path = os.path.join(made, "tests", name + ".py")
    if not os.path.isfile(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        atomic_write(path, TEST_SKELETON.format(name=name), 0o644)
        raise Fail(1, "no test for %s yet: wrote the skeleton %s; fill in one check per DONE WHEN item, then vfg "
                      "test %s" % (name, os.path.relpath(path, cfg.repo), name))
    box = test_box(cfg)
    text = read_text(path)
    bindings = test_bindings(cfg, a, name)
    memory = test_memory(cfg, name)
    try:
        last = read_text(memory)
    except (OSError, Fail):
        last = None
    if last is not None and last != text:
        changed = test_changes(last, text)
        if changed:
            out("\n".join("CHANGED    %s" % ln for ln in ["since the last run of this test:"] + changed))
    args = {"op": "test", "server": server_name(cfg), "name": name, "bindings": bindings, "timeout": timeout,
            "boot": TEST_BOOT_S, "tail": 15 if a.n is None else a.n,
            "tests": pack(["tests"], made)[0],
            "content": pack(["content"], made)[0] if os.path.isdir(os.path.join(made, "content")) else None}
    if box.get("VFG_SSH_HOST") == cfg.get("VFG_SSH_HOST"):
        # the same machine: the box checks itself that its server is not the live one under another path
        args["live"] = {"vfg": cfg.rvfg, "mc": cfg.rmc}
    rc, o, e = Ssh(box).call(program("engine.py", dict(args, vfg=box.rvfg, mc=box.rmc)),
                             timeout + TEST_BOOT_S + 60, keep_master=True)
    if rc != 0:
        finish(rc, o, e)
    try:
        got = json.loads(o.decode("utf-8", "replace").strip().splitlines()[-1])
        ran = got["test"]
    except (ValueError, IndexError, KeyError, TypeError):
        raise Fail(1, "the test server answered something that is not the test's end")
    try:   # it ran: what it was is the next run's to compare with
        os.makedirs(os.path.dirname(memory), mode=0o700, exist_ok=True)
        atomic_write(memory, text)
    except OSError as x:
        warn("this test's last run was not kept (%s): the next run shows no changes" % (x.strerror or x))
    lines = str(ran.get("out") or "").rstrip("\n").split("\n")
    try:
        end = json.loads(lines[-1])
        lines = lines[:-1]
    except (ValueError, IndexError):
        end = {}
    if any(x.strip() for x in lines):
        out("\n".join(lines))
    code = ran.get("code")
    if code != 0 and ran.get("log"):
        out("\n".join("LOG        %s" % ln for ln in ran["log"]))
    why = str(end.get("error") or "").strip() or (str(ran.get("err") or "").strip().splitlines() or [""])[-1]
    if code == 0:
        return 0
    if code == 1:
        failed = [c.get("item") for c in end.get("checks") or [] if isinstance(c, dict) and c.get("ok") is False]
        raise Fail(1, "the test failed: %d of %d checks%s" % (len(failed), len(end.get("checks") or []),
                                                             ": " + "; ".join(map(str, failed)) if failed else ""))
    if code == 2:
        raise Fail(1, "the test could not run as written: %s" % (why or "see its lines above"))
    if code == 3:
        raise Fail(3, "not a test server: %s" % (why or "the test box's server has no .vfg-test-server marker"))
    if code == 4:
        errors = ["%s: %s: %s" % (x.get("file"), x.get("check"), x.get("error"))
                  for x in (end.get("engine") or {}).get("errors") or [] if isinstance(x, dict)]
        raise Fail(1, "the test's engine did not start or load the content: %s" % ("; ".join(errors) or why))
    if code == 5:
        raise Fail(1, "the test ran past its %g s and was stopped: shorten its waits, or --timeout" % timeout)
    raise Fail(1, "the test did not finish (exit %s): %s" % (code, why or "no output"))


# ------------------------------------------------------------------ watch

def is_vfg_watch(pid):
    """Is `pid` a person's `vfg watch`, with no --tail and no --after? Never pkill -f: it matches us."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            argv = [x.decode("utf-8", "replace") for x in f.read().split(b"\0") if x]
    except OSError:
        return False
    for i, arg in enumerate(argv):
        if os.path.basename(arg) == "vfg":
            rest = argv[i + 1:]
            return "watch" in rest and not any(r in ("--tail", "--after") or r.startswith(("--tail=", "--after="))
                                               for r in rest)
    return False


def take_watch_lock(cfg):
    """One `vfg watch` at a time, and the newest wins."""
    lock = os.path.join(cfg.home, "watch.lock")
    pidfile = os.path.join(cfg.home, "watch.pid")
    fd = os.open(lock, os.O_RDWR | os.O_CREAT, 0o600)
    start = time.monotonic()
    termed = killed = None
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError as e:
            if e.errno not in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
                raise
        now = time.monotonic()
        pid = read_int(pidfile)
        if pid and pid != os.getpid() and is_vfg_watch(pid):
            try:
                if termed is None:
                    os.kill(pid, signal.SIGTERM)
                    termed = now
                elif killed is None and now - termed >= 3:
                    os.kill(pid, signal.SIGKILL)
                    killed = now
            except ProcessLookupError:
                pass
        if now - start >= 5:
            os.close(fd)
            raise Fail(1, "another vfg watch holds %s and would not give it up"
                       % tilde(lock))
        time.sleep(0.05)
    atomic_write(pidfile, "%d\n" % os.getpid())
    return fd


class Watcher(object):
    """A person's watch (the cursor, the lock and the valve); with `tail`, the last N lines and
    on; with `after`, for code, every line from seq after+1 on, with no cursor and no valve."""
    DELAYS = [1, 2, 4, 8, 15, 30]

    def __init__(self, cfg, tail=None, after=None, fd=1):
        self.cfg = cfg
        self.ssh = Ssh(cfg)
        self.tail = tail
        self.fd = fd
        self.persist = tail is None and after is None
        self.cursor = os.path.join(cfg.home, "cursor")
        self.last = read_int(self.cursor) if self.persist else after
        # A person's watch prints at most the last VFG_WATCH_CATCHUP lines it missed; code's
        # (--after) every one, on its first connection and on every reconnect.
        self.catchup = None if after is not None else cfg.int("VFG_WATCH_CATCHUP")
        self.max_per_min = None if after is not None else cfg.int("VFG_WATCH_MAX_PER_MIN")
        self.silence = float(os.environ.get("VFG_WATCH_SILENCE_S") or 35)
        self.down_after = float(os.environ.get("VFG_WATCH_UNREACHABLE_S") or 60)
        self.proc = None
        self.printed = collections.deque()
        self.held = 0
        self.held_first = self.held_last = None
        self.held_noticed_at = None
        self.down_since = time.time()
        self.down_noticed = False

    # -- output
    def notice(self, text):
        return "SYS#0 %s | vfg watch: %s" % (hms(), text)

    def emit(self, lines):
        if not lines:
            return
        data = memoryview(("\n".join(lines) + "\n").encode("utf-8"))
        try:
            while data:
                n = os.write(self.fd, data)
                data = data[n:]
        except OSError:
            raise _Stop()

    def save_cursor(self):
        if self.persist and self.last is not None:
            try:
                atomic_write(self.cursor, "%d\n" % self.last)
            except OSError as e:
                warn("cannot write the cursor: %s" % e)

    def stdout_closed(self):
        try:
            p = select.poll()
            p.register(self.fd, 0)
            return any(ev & (select.POLLERR | select.POLLHUP | select.POLLNVAL) for _, ev in p.poll(0))
        except (OSError, ValueError):
            return False

    # -- the valve
    def room(self, now):
        if self.max_per_min is None:
            return True
        while self.printed and now - self.printed[0] >= 60:
            self.printed.popleft()
        return len(self.printed) < self.max_per_min

    def tick(self, connected):
        now = time.time()
        lines = []
        if self.held and (self.held_noticed_at is None or now - self.held_noticed_at >= 60):
            lines.append(self.notice("held back %d lines (seq %d–%d), feed too busy — "
                                     "vfg history --feed has them"
                                     % (self.held, self.held_first, self.held_last)))
            self.held = 0
            self.held_first = self.held_last = None
            self.held_noticed_at = now
        if (not connected and self.down_since is not None and not self.down_noticed
                and now - self.down_since >= self.down_after):
            lines.append(self.notice("EC2 unreachable since %s — retrying" % hms(self.down_since)))
            self.down_noticed = True
        self.emit(lines)
        if self.stdout_closed():
            raise _Stop()

    # -- one batch from follow.py
    def handle(self, raw_lines, first_chunk):
        got_hb = False
        lines = []
        moved = False
        decoded = [r.decode("utf-8", "replace").rstrip("\r") for r in raw_lines]
        if first_chunk and self.down_noticed:
            skipped = any(d.startswith("@skip ") for d in decoded)
            lines.append(self.notice("reconnected" if skipped else "reconnected — nothing missed"))
            self.down_noticed = False
        now = time.time()
        for line in decoded:
            if line == "@hb":
                got_hb = True
            elif line.startswith("@at "):
                try:
                    self.last = int(line[4:])
                    moved = True
                except ValueError:
                    pass
            elif line == "@reset":
                lines.append(self.notice("feed restarted — cursor reset"))
                self.last = 0
                moved = True
            elif line.startswith("@skip "):
                try:
                    first, last, count = [int(x) for x in line.split()[1:4]]
                except ValueError:
                    continue
                lines.append(self.notice("skipped %d lines (seq %d–%d) while away — "
                                         "vfg history --feed has them" % (count, first, last)))
            else:
                m = FEED_LINE_RE.match(line)
                if not m:
                    continue
                seq = int(m.group(2))
                if self.last is not None and seq <= self.last:
                    continue
                self.last = seq
                moved = True
                if self.room(now):
                    if self.max_per_min is not None:
                        self.printed.append(now)
                    lines.append(line)
                else:
                    self.held += 1
                    self.held_first = seq if self.held_first is None else self.held_first
                    self.held_last = seq
        self.emit(lines)  # print first, then move the cursor
        if moved:
            self.save_cursor()
        return got_hb

    # -- one connection
    def kill(self):
        p, self.proc = self.proc, None
        if p is None:
            return
        try:
            p.terminate()
            try:
                p.wait(timeout=2)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        except OSError:
            pass

    def connect(self, first):
        args = {"after": self.last, "catchup": self.catchup, "feed": self.cfg.rvfg + "/feed.log",
                "vfg": self.cfg.rvfg, "mc": self.cfg.rmc}
        if first and self.tail is not None:
            args["after"] = None
            args["tail"] = self.tail
        try:
            self.proc = subprocess.Popen(self.ssh.argv(direct=True), stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                         preexec_fn=_pdeathsig)
        except OSError as e:
            raise Fail(3, "not configured: cannot run %s (%s)"
                       % (self.cfg.get("VFG_SSH"), e.strerror))
        try:
            self.proc.stdin.write(program("follow.py", args))
            self.proc.stdin.close()
        except OSError:
            pass
        outfd, errfd = self.proc.stdout.fileno(), self.proc.stderr.fileno()
        poller = select.poll()
        poller.register(outfd, select.POLLIN | select.POLLHUP | select.POLLERR)
        poller.register(errfd, select.POLLIN | select.POLLHUP | select.POLLERR)
        buf = b""
        connected = got_hb = False
        last_byte = time.monotonic()
        last_wall = time.time()
        err_tail = b""
        open_out = True
        while open_out:
            for fd, ev in poller.poll(250):
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    data = b""
                if fd == errfd:
                    if data:
                        err_tail = (err_tail + data)[-2000:]
                    else:
                        poller.unregister(errfd)
                    continue
                if not data:
                    open_out = False
                    break
                last_byte = time.monotonic()
                last_wall = time.time()
                buf += data
                i = buf.rfind(b"\n")
                if i < 0:
                    continue
                complete, buf = buf[:i].split(b"\n"), buf[i + 1:]
                if self.handle(complete, not connected):
                    got_hb = True
                if not connected:
                    connected = True
                    self.down_since = None
            if open_out and time.monotonic() - last_byte > self.silence:
                break
            self.tick(connected)
        self.kill()
        why = [l for l in err_tail.decode("utf-8", "replace").splitlines() if l.strip()]
        if why and (not self.persist or sys.stderr.isatty()):
            # For a person at a terminal, or a --tail or --after watch: elsewhere the SYS#0 notices say it.
            sys.stderr.write("vfg watch: ssh: %s\n" % why[-1].strip())
            sys.stderr.flush()
        if connected:
            self.down_since = last_wall
        elif self.down_since is None:
            self.down_since = time.time()
        return got_hb

    def pause(self, seconds):
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            time.sleep(min(0.25, max(0.0, end - time.monotonic())))
            self.tick(False)

    def run(self):
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, _raise_stop)
        attempt = 0
        first = True
        try:
            while True:
                if self.connect(first):
                    attempt = 0
                first = False
                self.pause(self.DELAYS[min(attempt, len(self.DELAYS) - 1)])
                attempt += 1
        except _Stop:
            pass
        finally:
            self.kill()
        return 0


def cmd_watch(cfg, a):
    cfg.require_ssh()
    if a.tail is not None and a.tail < 0:
        raise Fail(2, "--tail is 0 or more lines")
    if a.after is not None and a.after < 0:
        raise Fail(2, "--after is a feed seq, 0 or more")
    cfg.ensure_home()
    _prep_pdeathsig()
    w = Watcher(cfg, a.tail, a.after)
    if w.persist:
        w.lockfd = take_watch_lock(cfg)
    return w.run()


