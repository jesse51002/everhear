def cmd_action_show(cfg, a):
    """One action in full, as an implementer's brief gives it (menu.describe): its line, its
    script, how it runs, and every value with its type, limits, default and description. From the
    actions cache, built again first when an action file is newer, so an action saved a minute ago
    is there. An action that is not there exits 1 with why, or the names near it."""
    va = actions_lib()
    try:
        data = va.cache(cfg.repo, server_name(cfg), cfg.home)
    except Exception as e:
        raise Fail(1, "the actions cache could not be read: %s: %s" % (type(e).__name__, one_line(str(e))))
    acts = data.get("actions") or {}
    menu = lib_module("menu")
    entry = acts.get(a.name)
