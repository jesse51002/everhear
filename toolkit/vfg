def rewrite_argv(argv):
    """Two words argparse would misread.

    `vfg script run …`: everything after `run` goes behind one `--`, so
    cmd_script_run parses it by hand (a bare `--wait`, or `--wait` after the
    name). `--since -10m` -> `--since=-10m` (argparse reads -10m as an option)."""
    i = 0
    while i < len(argv) and argv[i].startswith("--timeout"):
        i += 2 if argv[i] == "--timeout" else 1
    if argv[i:i + 2] == ["script", "run"] and argv[i + 2:i + 3] not in (["-h"], ["--help"]):
        return argv[:i + 2] + ["--"] + argv[i + 2:]
    if "history" not in argv:
        return argv
    out_, i = [], 0
    while i < len(argv):
        tok = argv[i]
        if tok == "--":
            out_.extend(argv[i:])
            break
        if tok in ("--since", "--until") and i + 1 < len(argv) and argv[i + 1].startswith("-"):
            out_.append(tok + "=" + argv[i + 1])
            i += 2
            continue
        out_.append(tok)
        i += 1
    return out_


