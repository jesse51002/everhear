# A player's incantations: words or phrases, each bound to an action and its values,
# which fire the moment that player says one, with no model on the path (the spec
# Specs/2026-10-10-Prototype_Voice_Triggers). They live in the box's store, the kit's
# incantations.Store (<vfg>/incantations.json), which the bridge reads as players cast. The
# incantation_create, _edit and _remove actions change it through their box script,
# scripts/incantations/, once run_incantation has checked everything here. This PC keeps the
# store for everyone who asks, the brain's world context first: $VFG_HOME/incantations.json,
# {"fetched_at": <epoch s>, "version", "incantations": [its entries]}, written atomically under
# incantations.lock. `vfg incantation list` answers from it while it is younger than
# VFG_INCANT_TTL_S (30 s), else fetches the store (remote/incantations.py); every incantation_*
# run writes through.
INCANT_ACTIONS = ("incantation_create", "incantation_edit", "incantation_remove")
INCANT_TTL_S = 30.0
INCANT_STANDIN = "Caster"  # what a caster field holds while its values are checked: any valid name
# The alias call: one structured() call as an incantation is made, on Gemini 3.8 Flash at light
# thinking, OpenRouter picking the host, unless VFG_INCANT_ALIAS_MODEL names another (off: no
# call). Its prompt is this one, filled with the phrase, each word's pronunciation (CMUdict's, or
# the kit's letter-to-sound guess for a made-up word: incantations.pronunciation) and the count:
# exactly INCANT_ALIAS_COUNT variants, each with its sounds, the likeliest first. On the
# 2026-10-12 bench of alias prompts and models (seven phrases from the play sessions), Gemini at
# light thinking made 20 every time, at a median 6.0 s and at most 9.7 s, $0.0036 a create, where
# DeepSeek V4 Flash with no thinking made at most six, some of them other words; 20 kept Layer
# 2's recall on both sessions (79% and 96%, with lines of at most 6 words) for 31 false casts on
# the 843 lines of 10-08's talk, against 7 with the six stored. The code then checks each
# variant (incantations.checked_variants: the phrase itself, repeats, one 3 speech sounds longer
# or more, an H weighed 0.25 and an "uh" 0.5, one more than 0.35 from it in sound), and what it
# drops goes in the line's facts.alias_call.dropped, never in a note.
# It also says whether the phrase is everyday talk, which casts whenever it is said in
# conversation (a note), as a word list cannot without flagging made-up words: CMUdict holds
# kamehameha, nova and umbra. And it marks each variant that is a common phrase of its own
# (common_phrase), the entry's everyday_aliases, which the keyword spotter leaves out (scripts/
# _lib/incantations.py): on 2026-10-12 "ice cream", "i scream", "nice beam" and "eyes beam" for
# ice beam fired the widened spotter on ordinary talk ("i scream" alone 17 times an hour; the
# four took false casts from 47 to 18 an hour), while speech to text wrote "Ice cream." for "ice
# beam" 10 times in one session, which Layer 2 caught through the alias. A flag on each variant,
# not a list of them after: as a list DeepSeek marked "juicy stake" and "destroyed everything"
# too, carrying the phrase's own everyday talk over. Word frequencies cannot tell them apart: in
# Google Books (2010-2019) "destroyed everything", which the spotter needs, is 23 times as common
# as "eyes beam" and 460 times "nice beam", and "ice been" 8 times "nice beam".
INCANT_ALIAS_MODEL = "google/gemini-3.8-flash"
INCANT_ALIAS_REASONING = "low"
INCANT_ALIAS_TIMEOUT_S = 20.0
INCANT_ALIAS_COUNT = 20
INCANT_ALIAS_PROMPT = """\
A player in a voice-controlled Minecraft game casts a spell by saying its incantation. Two programs \
listen and both mishear: a keyword spotter, which hears sounds and writes the words those sounds most \
often are, and speech to text, which writes down whole lines. List how the incantation is likely to be \
WRITTEN when the player says it, so the spell still fires.

The incantation: "%(phrase)s"
How it sounds (the CMU pronouncing dictionary, ARPAbet, stress left out):
%(sounds)s

Rules for every variant:
1. Said aloud it sounds almost the same as the incantation: the same sounds in the same order, with at \
most one or two changed: a vowel for a near vowel (IY/IH, EY/EH, AA/AO, AH/UH), a consonant for a near \
one (B/P, D/T, G/K, M/N, S/Z, F/V, TH/F), or a weak sound dropped or added at the end of a word (S, Z, \
D, T, H).
2. The same length: never a word added before or after it ("... now", "... out", "the ..."), never a \
word dropped, never extra syllables ("steakhouse").
3. Written the way a recognizer writes: real English words that make those sounds ("ice been", "juicy \
stake"), the words run together or split ("icebeam", "fire ball"), or for a made-up word, plain \
English syllables or words for how it is said ("come a hammer ha" for kamehameha).
4. Never the incantation itself, never one that means the same but sounds different ("destroy all"), \
no repeats.
5. The likeliest first: what a recognizer most often writes for these sounds. Always exactly %(count)d, \
the likeliest first.
For each variant give its sounds in ARPAbet too.

Mark each variant common_phrase when its words, as written, are a common phrase of their own that \
people say in conversation meaning something else, so a player would say it while not casting the \
spell. For ice beam, "ice cream", "i scream", "nice beam" and "eyes beam" are. Not a common phrase: a \
mishearing people do not say ("ice been", "juicy stake", "hot fire bowl", "speed ash", "fire bal"), \
even when the spell's own phrase is common, and the spell's own words in another form, run together, \
split, plural or in another tense ("fireball", "fire balls", "destroyed everything").

Then say whether the incantation itself is everyday talk: a word or words people often say in \
ordinary conversation, as "heal", "shield" or "come here". A made-up word, as kamehameha, or a \
spell's name, as "fire ball", is not.
"""
_INCANT = []


def incantations_module():
    """scripts/_lib/incantations.py, loaded once by its path: the store, the phrase rules, the
    aliases and the bind checks, this PC's and the box's alike."""
    if not _INCANT:
        import importlib.util
        path = os.path.join(KIT_LIB, "incantations.py")
        if not os.path.isfile(path):
            raise Fail(3, "not configured: there is no scripts/_lib/incantations.py")
        spec = importlib.util.spec_from_file_location("vfg_incantations", path)
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod
        spec.loader.exec_module(mod)
        _INCANT.append(mod)
    return _INCANT[0]


def incant_cache_path(cfg):
    return os.path.join(cfg.home, "incantations.json")


def read_incant_cache(cfg):
    """(the cache, its age in seconds), or None when there is no readable one."""
    try:
        with open(incant_cache_path(cfg), encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data.get("incantations"), list):
            return None
        return data, time.time() - float(data["fetched_at"])
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None


def write_incant_cache(cfg, version, rows, fetched_at):
    cfg.ensure_home()
    atomic_write(incant_cache_path(cfg), json.dumps({"fetched_at": fetched_at, "version": version,
                                                     "incantations": rows}, ensure_ascii=False) + "\n")


def incant_ttl(cfg):
    raw = cfg.get("VFG_INCANT_TTL_S")
    try:
        return max(0.0, float(raw)) if raw else INCANT_TTL_S
    except ValueError:
        raise Fail(3, "not configured: VFG_INCANT_TTL_S must be a number of seconds")


def fetch_incantations(cfg, a, stamps=None):
    """The box's store, written to the cache, and of `stamps` ([{"root", "stamps"}], as
    stamps_for makes them) the folders the box does not have as stamped: (store, stale). One
    SSH call."""
    rc, o, e = remote(cfg, a, "incantations.py", {"op": "list", "stamps": stamps or []}, 30)
    if rc != 0:
        finish(rc, b"", e)  # raises Fail with the remote's one line
    try:
        got = json.loads(o.decode("utf-8").strip().splitlines()[-1])
        store = got["store"]
        rows, stale = store["incantations"], got["stale"]
        if not (isinstance(rows, list) and isinstance(stale, list)):
            raise TypeError
    except (ValueError, KeyError, IndexError, TypeError):
        raise Fail(1, "the box's incantation store is not JSON")
    cfg.ensure_home()
    with flocked(os.path.join(cfg.home, "incantations.lock")):
        write_incant_cache(cfg, store.get("version") or 0, rows, time.time())
    return store, stale


def note_incantations(cfg, put=(), drop=(), version=None):
    """Write a run through to the cache, keeping its age: the entries it stored or changed, by
    id, and the ids it removed. No cache, nothing to update: a few entries would pass for the
    whole store."""
    try:
        cfg.ensure_home()
        with flocked(os.path.join(cfg.home, "incantations.lock")):
            cached = read_incant_cache(cfg)
            if cached is None:
                return
            data, age = cached
            gone = set(drop) | set(e.get("id") for e in put)
            rows = [e for e in data["incantations"] if e.get("id") not in gone] + list(put)
            write_incant_cache(cfg, data.get("version") if version is None else version, rows, time.time() - age)
    except OSError as e:
        warn("incantations.json not written: %s" % e)


def incant_whose(player):
    return "everyone's" if player == "@a" else player + "'s"


def incant_find(inc, rows, player, phrase):
    """The entry of `player` (its exact key, in any case) for the normalised phrase, or None."""
    for e in rows:
        if str(e.get("player") or "").lower() == player.lower() and inc.normalize(e.get("phrase") or "") == phrase:
            return e
    return None


def incant_warnings(inc, phrase, aliases, players, rows, skip=None):
    """bind_warnings for each player against that player's other incantations (everyone's, for
    @a): a warning every player gets is said once, the others with the player's name first."""
    per = []
    for p in players:
        others = [e for e in rows if e is not skip and not incant_find(inc, [e], p, phrase)
                  and (p == "@a" or inc.applies_to(e, p))]
        per.append((p, inc.bind_warnings(phrase, aliases, others)))
    common = [w for w in per[0][1] if all(w in ws for _, ws in per)] if per else []
    out_ = list(common)
    for p, ws in per:
        out_ += [("%s: %s" % (p, w) if len(per) > 1 else w) for w in ws if w not in common]
    return list(dict.fromkeys(out_))


def incant_sounds(inc, phrase):
    """The prompt's pronunciation lines, one a word: `  beam = B IY M`, or for a word CMUdict
    lacks, `  galick = not in the dictionary (a made-up word); a guess from its letters: …`."""
    return "\n".join("  %s = %s" % (w, ph) if known else
                     "  %s = not in the dictionary (a made-up word); a guess from its letters: %s. "
                     "Think how a player would say it." % (w, ph) for w, ph, known in inc.pronunciation(phrase))


def incant_alias_call(cfg, phrase):
    """How `phrase` is likely said or misheard, from one structured() call: (variants, those of
    them that are everyday talk, whether the phrase is everyday talk, a note when the call failed,
    {"model", "cost", "ms"} when it answered). The variants are the model's as it wrote them, the
    code's checks still to come (incantations.checked_variants). A failure is a note, never a
    refusal: the code's aliases stand. The call queues its own usage row, component alias and the
    phrase its ref, and `vfg usage flush` sends it, nobody waiting."""
    model = (cfg.get("VFG_INCANT_ALIAS_MODEL") or INCANT_ALIAS_MODEL).strip()
    if model.lower() == "off":
        return [], [], False, None, None
    asked = False
    try:
        actions_lib()  # lib/py on sys.path
        import asyncio
        import logging
        import vfg_llm
        from pydantic import BaseModel, Field
        logging.getLogger("vfg_llm").addHandler(logging.NullHandler())
        logging.getLogger("vfg_llm").propagate = False

        class Variant(BaseModel):
            text: str = Field(description="lowercase words and spaces, as a recognizer writes it")
            sounds: str = Field(description="its ARPAbet sounds")
            common_phrase: bool = Field(description="whether these words are a common phrase people say meaning "
                                                    "something else")

        class Variants(BaseModel):
            variants: list[Variant] = Field(description="exactly %d, the likeliest first, each sounding almost the "
                                                        "same as the incantation and the same length"
                                                        % INCANT_ALIAS_COUNT)
            everyday: bool

        prompt = INCANT_ALIAS_PROMPT % {"phrase": phrase, "sounds": incant_sounds(incantations_module(), phrase),
                                        "count": INCANT_ALIAS_COUNT}
        asked = True
        got = asyncio.run(vfg_llm.structured(prompt, Variants, component="alias", call_id=phrase[:64], model=model,
                                             reasoning=INCANT_ALIAS_REASONING, timeout=INCANT_ALIAS_TIMEOUT_S))
    except Exception as e:  # noqa: BLE001 — an LlmError, no key, no httpx: the code's aliases stand
        if asked:
            flush_usage_later(cfg)
        return [], [], False, "aliases from code only: the alias call failed (%s)" % (str(e) or type(e).__name__), None
    flush_usage_later(cfg)
    variants = got.value.variants
    return [x.text for x in variants], [x.text for x in variants if x.common_phrase is True], \
        got.value.everyday is True, None, {"model": model, "cost": round(got.cost, 6), "ms": got.ms}


def incant_aliases(inc, phrase, variants, marked):
    """A new incantation's aliases from the alias call's variants and the code's: (aliases, its
    everyday_aliases, what was dropped, ["fire ball now: 6 speech sounds longer"]). The variants
    go through the code's checks (incantations.checked_variants), then merge_aliases after the
    code's own, the phrase joined and split. The everyday ones are those the call marked among
    the aliases kept, never the code's: the spotter leaves them out."""
    code = inc.code_aliases(phrase)
    kept, dropped = inc.checked_variants(phrase, variants)
    aliases = inc.merge_aliases(phrase, code, kept)
    dropped += [(x, "fewer than %d speech sounds" % inc.MIN_ALIAS_PHONES
                 if len(inc.phones(x)) < inc.MIN_ALIAS_PHONES else "past the %d" % inc.ALIAS_CAP)
                for x in kept if x not in aliases and x not in code]
    marks = inc.everyday(aliases, [m for m in marked if inc.normalize(m) not in code])
    return aliases, marks, ["%s: %s" % d for d in dropped]


def incant_player_fields(va, cls):
    """The fields of an action a caster can fill: its player and players fields it does not fix."""
    T = va._types(cls)
    return [k for k, f in cls.model_fields.items()
            if k not in cls.fixed and T.kind(f.annotation, f.metadata) in ("player", "players")]


def incant_blank(x):
    return x is None or (isinstance(x, str) and not x.strip())


def incant_bound(cfg, name):
    """The action a phrase may fire: (vfg_actions, its catalog, its class); exit 2 for one that
    is not on the menu, or one an incantation cannot fire."""
    if not name:
        raise Fail(2, "which action does it fire? action=<its name on the menu> — vfg action list")
    if name in ("edit", "stop") or name.startswith("incantation_"):
        raise Fail(2, "action=%s: an incantation fires an action that does something in the game, not %s" % (name, name))
    try:
        return action_class(cfg, name)
    except Fail as f:
        raise Fail(2, "action=%s: %s" % (name, f.msg))


def incant_deploy(cfg, a, home, folders):
    """The bound script and the kit, deployed as a run of its action would send them (tars_for)."""
    rc, o, e = remote(cfg, a, "scripts.py", {"op": "deploy", "tars": tars_for(cfg, home, folders)}, 30,
                      libs=SCRIPTS_LIBS)
    if rc != 0:
        finish(rc, b"", e)


def incant_given(given):
    """values= as a JSON object, as the dispatcher and the brain give a dict on the command line,
    and values.<name>=<value> words gathered into it as their text: (given, the names given as
    words), read once the bound action's fields are known (incant_typed)."""
    vals = given.get("values")
    if isinstance(vals, str):
        try:
            vals = json.loads(vals) if vals.strip() else {}
        except ValueError:
            raise Fail(2, "values= is a JSON object of the action's values, such as values='{\"power\": 4}', "
                          "or give each as values.<name>=<value>")
    inner = dict((k.split(".", 1)[1], given[k]) for k in given if k.startswith("values."))
    if inner:
        if vals is not None and not isinstance(vals, dict):
            raise Fail(2, "values= is a JSON object of the action's values")
        vals = dict(vals or {}, **inner)
    if vals is not given.get("values") or inner:
        given = dict(((k, x) for k, x in given.items() if not k.startswith("values.")), values=vals)
    return given, set(inner)


def incant_word(x):
    """A values.<name>= word's value for a field that does not take text: JSON when it reads as
    JSON (6, true, ["give Steve bread"]), else the text itself, for the field to read (a,b,c)."""
    try:
        return json.loads(x)
    except ValueError:
        return x


def incant_takes_text(va, cls, f):
    """Whether field `f` of action `cls` takes text as it is: text, a kind of text (a player, a
    block, a command ...), or one of some words."""
    T = va._types(cls)
    t, _ = T.unwrap(f.annotation, f.metadata)
    if t is str:
        return True
    opts = T.choices(f.annotation, f.metadata)
    return T.kind(f.annotation, f.metadata) == "enum" and bool(opts) and all(isinstance(o, str) for o in opts)


def incant_typed(va, cls, vals, words):
    """The values for bound action `cls`, those given as values.<name>= words read now that its
    fields are known: a field that takes text keeps the word as it is (values.title=1 is the
    text "1"), any other gets it read as JSON (incant_word). A name it has no field for stays,
    for the check to refuse."""
    out = dict(vals)
    for k in words:
        f = cls.model_fields.get(k)
        if k in out and isinstance(out[k], str) and f is not None and not incant_takes_text(va, cls, f):
            out[k] = incant_word(out[k])
    return out


def run_incantation(cfg, a, name, given, as_=None, task=None):
    """The incantation_create, _edit and _remove actions: everything checked here (the phrase,
    the players, the bound action and its values, the aliases, the bind warnings), then the
    incantations script run on the box with {"op", "entries"}, and the store written through to
    the cache. The JSON line's dict, its notes carrying the clamps, the warnings and any failed
    alias call."""
    cfg.require_ssh()
    inc = incantations_module()
    va, cat, cls = action_class(cfg, name)
    given, words = incant_given(given)
    try:
        own = va.check_values(cls, given)
    except ValueError as e:
        raise Fail(2, str(e))
    v = own.values
    if incant_blank(v["player"]):
        raise Fail(2, "whose incantation? player=<the player who asked> (several separated by commas, "
                      "or @a when someone asks for everyone)")
    try:
        players = inc.split_players(v["player"])
    except ValueError as e:
        raise Fail(2, "player=%s: %s" % (v["player"], e))
    try:
        phrase = inc.check_phrase(v["phrase"])
    except ValueError as e:
        raise Fail(2, "phrase=%s: %s" % (v["phrase"], e))
    mine = {"player": ",".join(players), "phrase": phrase}
    if name == "incantation_remove":
        line = run_action(cfg, a, name, mine, as_, task,
                          extra={"op": "remove", "entries": [{"player": p, "phrase": phrase} for p in players]})
        if line["ok"]:
            note_incantations(cfg, drop=line["facts"].get("ids") or [], version=line["facts"].get("version"))
        return line
    if name == "incantation_edit":
        return edit_incantation(cfg, a, inc, va, given, words, v, players, phrase, mine, own.notes, as_, task)

    # create: the bound action and its values, checked as a run of it would check them, every
    # player field left out or empty filled with a stand-in: the caster's, as it is cast.
    _, bcat, bcls = incant_bound(cfg, v["action"])
    v = dict(v, values=incant_typed(va, bcls, v["values"], words))
    caster = [k for k in incant_player_fields(va, bcls) if incant_blank(v["values"].get(k))]
    try:
        checked = checked_values(cfg, a, va, bcls, dict(v["values"], **dict((k, INCANT_STANDIN) for k in caster)))
    except Fail as f:
        raise Fail(f.code, "values for %s: %s" % (v["action"], f.msg))
    notes = own.notes + checked.notes
    home = script_home(cfg, bcat.source(v["action"]), bcls.script)
    # The bound script with the kit; a library one with this action's own script too, so a box
    # that needs them all gets them in one deploy.
    folders = [bcls.script] + (["incantations"] if home == "library" else [])
    # The alias call (about 6 s, at most INCANT_ALIAS_TIMEOUT_S) runs in a thread while the store
    # and the stamps are read, so neither waits for the other; a daemon, so a failed read is not
    # held up by it.
    import threading
    answer = []
    caller = threading.Thread(target=lambda: answer.append(incant_alias_call(cfg, phrase)), daemon=True)
    caller.start()
    store, stale = fetch_incantations(cfg, a, stamps_for(cfg, home, folders))
    caller.join()
    variants, marked, everyday, why, call = answer[0] if answer else (
        [], [], False, "aliases from code only: the alias call failed", None)
    if why:
        notes.append(why)
    aliases, marked, dropped = incant_aliases(inc, phrase, variants, marked)
    if call is not None:
        call["dropped"] = dropped   # what the code left out of the model's, for whoever looks
    rows = store["incantations"]
    notes += incant_warnings(inc, phrase, aliases, players, rows)
    if everyday:
        notes.append('"%s" is everyday talk, so it will fire whenever it is said in conversation.' % phrase)
    for p in players:
        old = incant_find(inc, rows, p, phrase)
        if old:
            notes.append('replaces %s "%s", which fired %s' % (incant_whose(old["player"]), phrase, old.get("action")))
    if stale:
        incant_deploy(cfg, a, home, folders)
    stored = dict(checked.values, **dict((k, "") for k in caster))
    # What was asked, apart from the caster fields: the rest follows the action's defaults when
    # they change (refresh_incantations).
    asked = dict((k, checked.values[k]) for k in v["values"] if k not in caster and k in checked.values)
    made = now_iso()
    entries = [{"player": p, "phrase": phrase, "aliases": aliases, "everyday_aliases": marked,
                "action": v["action"], "script": bcls.script,
                "source": home, "server": server_name(cfg) if home == "made" else "", "values": stored, "asked": asked,
                "live": list(checked.live), "runs": bcls.runs, "caster_fields": caster,
                "cooldown_s": float(v["cooldown_s"]), "created": made, "by": task or ""} for p in players]
    line = run_action(cfg, a, name, dict(mine, action=v["action"], values=v["values"], cooldown_s=v["cooldown_s"]),
                      as_, task, extra={"op": "put", "entries": entries})
    line["notes"] = notes + line["notes"]
    if call:
        line["facts"]["alias_call"] = call
    ids = line["facts"].get("ids") or []
    if line["ok"] and len(ids) == len(entries):
        note_incantations(cfg, put=[dict(e, id=i) for e, i in zip(entries, ids)], version=line["facts"].get("version"))
    return line


def incant_remade(va, bcls, e):
    """An entry made again from what was asked ("asked") over its action's defaults as they are
    now, its caster fields kept the caster's: (what changes, {"values", "live", "asked"} whole,
    or None when the entry holds them already; why it keeps its values, or None). No SSH: a
    saved place in what was asked was checked when it was asked, and a fixed field asked for
    by an edit, which may change one, stays asked."""
    caster = [k for k in e.get("caster_fields") or [] if k in bcls.model_fields]
    asked = dict((k, x) for k, x in (e.get("asked") or {}).items() if k in bcls.model_fields and k not in caster)
    try:
        checked = va.check_values(bcls, dict(asked, **dict((k, INCANT_STANDIN) for k in caster)), allow_fixed=True)
    except ValueError as err:
        return None, '"%s" for %s keeps its values: %s' % (e.get("phrase"), e.get("player"), err)
    sets = {"values": dict(checked.values, **dict((k, "") for k in caster)), "live": list(checked.live),
            "asked": asked}
    if sets == {"values": e.get("values"), "live": list(e.get("live") or []), "asked": e.get("asked")}:
        return None, None
    return sets, None


def refresh_incantations(cfg, a, name):
    """After a run of action `name` that went well (vfg action run has just deployed its script
    as it is here): each incantation bound to it made again from what was asked over the
    action's defaults as they are now (incant_remade), so a fix to the action reaches the
    phrase too. Decided from the cache alone: while every binding of it there holds what it
    would be made again, nothing is sent. When one would change, the store is read (one SSH
    call), each binding of the action made again from the box's own entry, and each that
    changes updated, its values, live and asked replaced whole, so a value the action no longer
    has goes from the box and the cache alike. An entry from before "asked" was kept stays as
    it is. Its notes, one when there is no cache to decide from; never raises: the run that
    called it stands."""
    cached = read_incant_cache(cfg)
    if cached is None:
        return ["incantations of %s not checked: no cache of them on this PC (vfg incantation list --fresh)"
                % name]
    mine = [e for e in cached[0]["incantations"] if isinstance(e, dict) and e.get("action") == name and "asked" in e]
    if not mine:
        return []
    try:
        va = actions_lib()
        _, _, bcls = incant_bound(cfg, name)
    except Fail as f:
        return ["incantations of %s not refreshed: %s" % (name, f.msg)]
    local = [incant_remade(va, bcls, e) for e in mine]
    if not any(sets for sets, _ in local):
        return [why for _, why in local if why]
    try:
        rows = fetch_incantations(cfg, a)[0]["incantations"]
    except Fail as f:
        return ["incantations of %s not refreshed: %s" % (name, f.msg)]
    notes = []
    for e in rows:
        if not isinstance(e, dict) or e.get("action") != name or "asked" not in e:
            continue
        sets, why = incant_remade(va, bcls, e)
        if why:
            notes.append(why)
        if not sets:
            continue
        try:
            line = run_action(cfg, a, "incantation_edit", {"player": e["player"], "phrase": e["phrase"]},
                              extra={"op": "update", "entries": [{"player": e["player"], "phrase": e["phrase"],
                                                                   "set": sets, "replace": True}]})
        except Fail as f:
            notes.append('"%s" for %s not refreshed: %s' % (e.get("phrase"), e.get("player"), f.msg))
            continue
        if line["ok"]:
            note_incantations(cfg, put=[dict(e, **sets)], version=line["facts"].get("version"))
            notes.append('"%s" for %s now follows %s as it is' % (e.get("phrase"), e.get("player"), name))
        else:
            notes.append('"%s" for %s not refreshed: %s' % (e.get("phrase"), e.get("player"), line.get("error")))
    return notes


def incant_marks(inc, aliases, e, v, change, notes):
    """An edited entry's everyday aliases, among `aliases`, its aliases after the edit: those
    everyday_aliases= gives, a note for any that is not one of them, else the entry's own still
    among them."""
    if "everyday_aliases" not in change:
        return inc.everyday(aliases, e.get("everyday_aliases"))
    asked = [x for x in dict.fromkeys(inc.normalize(x) for x in v["everyday_aliases"]) if x]
    marks = inc.everyday(aliases, asked)
    left = [x for x in asked if x not in marks]
    note = "left out of the everyday aliases (not among its aliases): " + ", ".join(left)
    if left and note not in notes:
        notes.append(note)
    return marks


def edit_incantation(cfg, a, inc, va, given, words, v, players, phrase, mine, notes, as_, task):
    """incantation_edit: each player's entry read from the box (never the cache: two edits close
    together must both see what the other did), its values (values.<name>= words read for its
    action, incant_typed) checked against its action over the ones it has, its aliases
    normalised and bind-checked again; then the box updates what changed. The values and what
    was asked go as only the keys given, with the keys that became the caster's to drop from
    asked, and the caster fields only when they change, all merged over what the store holds as
    it writes, so two edits of different values both land; the cache gets each entry as the box
    makes it (incantations.updated). New aliases keep the everyday marks still among them;
    everyday_aliases= replaces the marks whole (empty: none), each one of its aliases."""
    change = [k for k in ("cooldown_s", "aliases", "everyday_aliases") if k in given] + \
        (["values"] if given.get("values") else [])
    if not change:
        raise Fail(2, "nothing to change: give values=, cooldown_s=, aliases= or everyday_aliases=")
    rows = fetch_incantations(cfg, a)[0]["incantations"]
    found = [incant_find(inc, rows, p, phrase) for p in players]
    missing = [p for p, e in zip(players, found) if e is None]
    if missing:
        raise Fail(1, 'no incantation "%s" for %s — vfg incantation list'
                   % (phrase, " and ".join("everyone (@a)" if p == "@a" else p for p in missing)))
    notes, entries, after = list(notes), [], []
    for e in found:
        sets, drop = {}, []
        if "values" in change:
            _, _, bcls = incant_bound(cfg, e.get("action") or "")
            vals = incant_typed(va, bcls, v["values"], words)
            # A player field given empty becomes the caster's; one given a name is not any more.
            was = [k for k in e.get("caster_fields") or [] if k in bcls.model_fields]
            caster = [k for k in incant_player_fields(va, bcls)
                      if (incant_blank(vals[k]) if k in vals else k in was)]
            now = dict(e.get("values") or {}, **dict((k, INCANT_STANDIN) for k in was))
            new = dict(vals, **dict((k, INCANT_STANDIN) for k in caster if k in vals))
            try:
                ed = with_places(cfg, a, lambda places: va.check_edit(bcls, now, new, places=places))
            except Fail as f:
                raise Fail(f.code, "values for %s: %s" % (e.get("action"), f.msg))
            notes += [n for n in ed.notes if n not in notes]
            sets["values"] = dict((k, "" if k in caster else ed.values[k]) for k in vals)
            if caster != list(e.get("caster_fields") or []):
                sets["caster_fields"] = caster
            if "asked" in e:
                sets["asked"] = dict((k, ed.values[k]) for k in vals if k not in caster)
                drop = [k for k in vals if k in caster]
        if "cooldown_s" in change:
            sets["cooldown_s"] = float(v["cooldown_s"])
        if "aliases" in change:
            sets["aliases"] = inc.merge_aliases(phrase, v["aliases"])
            left = [x for x in dict.fromkeys(inc.normalize(x) for x in v["aliases"]) if x and x not in sets["aliases"]]
            if left and not [n for n in notes if n.startswith("left out of the aliases")]:
                notes.append("left out of the aliases (the phrase itself, too short to tell apart, or past %d): %s"
                             % (inc.ALIAS_CAP, ", ".join(left)))
            notes += [w for w in incant_warnings(inc, phrase, sets["aliases"], [e["player"]], rows, skip=e)
                      if w not in notes]
        if "everyday_aliases" in change or ("aliases" in change and e.get("everyday_aliases")):
            sets["everyday_aliases"] = incant_marks(inc, sets.get("aliases", e.get("aliases")), e, v, change, notes)
        entries.append(dict({"player": e["player"], "phrase": e["phrase"], "set": sets},
                            **({"drop_asked": drop} if drop else {})))
        after.append(inc.updated(e, sets, merge=True, drop_asked=drop))
    line = run_action(cfg, a, "incantation_edit", dict(mine, **dict((k, v[k]) for k in change)), as_, task,
                      extra={"op": "update", "entries": entries})
    line["notes"] = notes + line["notes"]
    if line["ok"]:
        note_incantations(cfg, put=after, version=line["facts"].get("version"))
    return line


def incant_shown(e, acts):
    """An entry's values as a list shows them: those that differ from its action's when nothing
    is given (all of them when the action is not in the actions cache), its caster fields left out."""
    info = acts.get(e.get("action")) or {}
    values = e.get("values") or {}
    if info:
        base = dict((f, d.get("default")) for f, d in (info.get("fields") or {}).items())
        base.update(info.get("defaults") or {})
        base.update(info.get("fixed") or {})
        values = differs(base, values)
    caster = set(e.get("caster_fields") or [])
    return dict((k, x) for k, x in values.items() if k not in caster)


def incant_line(e, acts):
    """`Steve: "fire ball" → command {"commands":[...]} cooldown 3s; aliases fireball, fire bowl`,
    a caster field as player=<caster>, and its everyday aliases when it has any (`; everyday,
    not spotted: ice cream`)."""
    text = '%s: "%s" → %s %s' % (e.get("player"), e.get("phrase"), e.get("action"),
                                 json.dumps(incant_shown(e, acts), ensure_ascii=False, separators=(",", ":")))
    for k in e.get("caster_fields") or []:
        text += " %s=<caster>" % k
    text += " cooldown %ss" % fmt_s(float(e.get("cooldown_s") or 0))
    text += "; " + ("aliases " + ", ".join(e["aliases"]) if e.get("aliases") else "no aliases")
    if e.get("everyday_aliases"):
        text += "; everyday, not spotted: " + ", ".join(e["everyday_aliases"])
    return text


def cmd_incantation(cfg, a):
    """vfg incantation list [--player P] [--json] [--fresh]: from the cache while it is younger
    than VFG_INCANT_TTL_S, else fetched; a failed fetch with any cache prints it, warns, exits 0."""
    if a.player is not None and not PLAYER_RE.match(a.player):
        raise Fail(2, "--player must be a player name (letters, digits, _; at most 16)")
    cached = read_incant_cache(cfg)
    if cached is not None and not a.fresh and 0 <= cached[1] < incant_ttl(cfg):
        rows = cached[0]["incantations"]
    else:
        try:
            rows = fetch_incantations(cfg, a)[0]["incantations"]
        except Fail as f:
            if cached is None:
                raise
            warn("incantations from %d s ago: %s" % (max(0, round(cached[1])), f.msg))
            rows = cached[0]["incantations"]
    rows = [e for e in rows if isinstance(e, dict)]
    if a.player is not None:
        inc = incantations_module()
        rows = [e for e in rows if inc.applies_to(e, a.player)]
    rows.sort(key=lambda e: (e.get("player") == "@a", str(e.get("player") or "").lower(), e.get("phrase") or ""))
    acts = actions_cache(cfg).get("actions") or {}
    if a.json:
        out(json.dumps([{"player": e.get("player"), "phrase": e.get("phrase"), "action": e.get("action"),
                         "values": incant_shown(e, acts), "cooldown_s": e.get("cooldown_s"),
                         "aliases": e.get("aliases") or [], "everyday_aliases": e.get("everyday_aliases") or []}
                        for e in rows], ensure_ascii=False))
    else:
        out("\n".join(incant_line(e, acts) for e in rows) if rows else "none")
    return 0


