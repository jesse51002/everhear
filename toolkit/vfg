class Fail(Exception):
    """Exit with `code`, and `msg` as the one line on stderr."""

    def __init__(self, code, msg=None):
        Exception.__init__(self, msg)
        self.code = code
        self.msg = msg


class TimedOut(Fail):
    """EC2 did not answer in time: exit 4 (vfg action run makes it 124)."""


# ------------------------------------------------------------------ helpers

def now_iso(t=None):
    if t is None:
        t = time.time()
    d = datetime.fromtimestamp(t, timezone.utc)
    return d.strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (d.microsecond // 1000)


def hms(t=None):
    return datetime.fromtimestamp(time.time() if t is None else t, timezone.utc).strftime("%H:%M:%S")


def tilde(path):
    home = os.path.expanduser("~")
    if home not in ("", "/") and (path == home or path.startswith(home + "/")):
        return "~" + path[len(home):]
    return path


def warn(msg):
    sys.stderr.write("vfg: " + msg + "\n")
    sys.stderr.flush()


def out(text):
    if text:
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
        sys.stdout.flush()


def out_bytes(data):
    if data:
        sys.stdout.flush()
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()


def fmt_s(s):
    return ("%d" % s) if float(s).is_integer() else ("%g" % s)


def atomic_write(path, data, mode=0o600):
    if isinstance(data, str):
        data = data.encode("utf-8")
    tmp = "%s.tmp.%d" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def append_line(path, line, mode=0o600):
    """One O_APPEND write, so concurrent writers never interleave."""
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, mode)
    try:
        os.write(fd, line.encode("utf-8"))
    finally:
        os.close(fd)


def read_jsonl(path):
    rows = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if isinstance(obj, dict):
                    rows.append(obj)
    except FileNotFoundError:
        pass
    return rows


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def pid_with_marker(pid, marker):
    try:
        with open("/proc/%d/environ" % pid, "rb") as f:
            return marker.encode() in f.read().split(b"\0")
    except (OSError, ValueError):
        return False


def clean_text(text):
    """Newlines and control characters become spaces, then trim."""
    return "".join(" " if unicodedata.category(c) == "Cc" else c for c in text).strip()


def check_home(words):
    home = os.environ.get("HOME", "")
    if home in ("", "/"):
        return
    for w in words:
        if w == home or w.startswith(home + "/"):
            raise Fail(2, "an argument is your home folder — your shell expanded a ~; quote it: '~'")


class flocked(object):
    def __init__(self, path):
        self.path = path

    def __enter__(self):
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


_LIBC = None


def _prep_pdeathsig():
    global _LIBC
    try:
        import ctypes
        _LIBC = ctypes.CDLL(None, use_errno=True)
    except Exception:
        _LIBC = None


def _pdeathsig():
    # PR_SET_PDEATHSIG = 1: the ssh dies with the vfg that started it.
    if _LIBC is not None:
        _LIBC.prctl(1, signal.SIGTERM, 0, 0, 0)


