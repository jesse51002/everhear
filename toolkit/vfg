def feed_post(cfg, a, typ, fields, text):
    """Run vfg_feed.py post over SSH; returns (rc, stdout, stderr)."""
    if typ not in TYPES:
        raise Fail(2, "TYPE is one of %s" % ", ".join(TYPES))
    if "|" in fields or "\n" in fields or "\r" in fields:
        raise Fail(2, "fields hold no | and no newline")
    if typ == "SYS" and fields != "":
        raise Fail(2, "SYS lines have no fields")
    if typ == "AI" and not AI_FIELDS_RE.match(fields):
        raise Fail(2, "AI fields are '<%s> <name|->', a task's name or -, like 'task galick_gun_styrk' "
                      "or 'action -'" % "|".join(AI_KINDS))
    # ssh carries no environment, and vfg_feed.py finds its files by VFG_DB and
    # VFG_FEED (default /opt/vfg), so they are set here; `env` keeps them
    # assignments however shlex quotes them.
    cmd = shlex.join(["env", "VFG_DB=" + cfg.rvfg + "/vfg.db", "VFG_FEED=" + cfg.rvfg + "/feed.log",
                      box_python(cfg), cfg.rvfg + "/lib/vfg_feed.py", "post", typ, fields, text])
    timeout = a.timeout if a.timeout is not None else 30
    return Ssh(cfg).call(b"", timeout, remote_cmd=cmd)


