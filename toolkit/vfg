def box_python(cfg):
    """The box's Python 3.12: /opt/vfg/python/bin/python3, under VFG_REMOTE_VFG."""
    return cfg.rvfg + "/python/bin/python3"


def read_text(path):
    with open(path, encoding="utf-8") as f:
        return f.read()


# Ahead of a program that uses libraries: each one's source becomes a module of its
# own, in sys.modules and bound to its name, so its names never shadow the program's.
LIBRARY = '''
def _library(name, source):
    import types
    mod = types.ModuleType(name)
    mod.__file__ = name + ".py"
    sys.modules[name] = mod
    exec(compile(source, mod.__file__, "exec"), mod.__dict__)
    return mod

'''


def lib_source(lib):
    """A library a program ships with: scripts/_lib/<lib> (deployed with the kit too), else remote/<lib>."""
    path = os.path.join(KIT_LIB, lib)
    return read_text(path if os.path.isfile(path) else os.path.join(REMOTE, lib))


def program(name, args, libs=()):
    """remote/common.py, then ARGS, then each of `libs` (lib_source) as a module
    (places.py becomes `places`), then the program: what goes on stdin."""
    text = read_text(os.path.join(REMOTE, "common.py"))
    text += "\nARGS = json.loads(" + repr(json.dumps(args)) + ")\n"
    if libs:
        text += LIBRARY
        for lib in libs:
            mod = os.path.splitext(lib)[0]
            text += "%s = _library(%r, %r)\n" % (mod, mod, lib_source(lib))
    return (text + "\n" + read_text(os.path.join(REMOTE, name))).encode("utf-8")


class Ssh(object):
    def __init__(self, cfg):
        cfg.require_ssh()
        self.cfg = cfg
        self.host = cfg.get("VFG_SSH_HOST")
        self.dest = "%s@%s" % (cfg.get("VFG_SSH_USER"), self.host)
        self.sockdir = os.path.join(cfg.home, "ssh")
        # The box's Python 3.12, which uv put in /opt/vfg/python (bridge/deploy/python.sh), reading
        # the program from stdin.
        self.remote_cmd = shlex.quote(box_python(cfg)) + " -u -"

    def base(self):
        return [self.cfg.get("VFG_SSH"), "-T", "-i", self.cfg.get("VFG_SSH_KEY"),
                "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
                "-o", "LogLevel=ERROR", "-o", "StrictHostKeyChecking=accept-new",
                "-o", "UserKnownHostsFile=" + os.path.join(self.cfg.home, "known_hosts")]

    def ctl(self):
        return ["-o", "ControlPath=" + os.path.join(self.sockdir, "%C")]

    def argv(self, remote_cmd=None, direct=False):
        remote_cmd = remote_cmd or self.remote_cmd
        if direct:
            return self.base() + ["-o", "ControlPath=none", self.dest, remote_cmd]
        return self.base() + self.ctl() + ["-o", "ControlMaster=no", self.dest, remote_cmd]

    def ensure_master(self, deadline):
        """Is a shared master up? If not, start one on its own, output closed."""
        self.cfg.ensure_home()
        os.makedirs(self.sockdir, mode=0o700, exist_ok=True)

        def left(cap):
            if deadline is None:
                return cap
            return max(0.1, min(cap, deadline - time.monotonic()))
        try:
            r = subprocess.run(self.base() + self.ctl() + ["-O", "check", self.dest],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=left(5))
            if r.returncode == 0:
                return True
        except (subprocess.TimeoutExpired, OSError):
            return False
        try:
            p = subprocess.Popen(self.base() + self.ctl() + ["-o", "ControlMaster=yes",
                                 "-o", "ControlPersist=10m", "-f", "-N", self.dest],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            raise Fail(3, "not configured: cannot run %s (%s)" % (self.cfg.get("VFG_SSH"), e.strerror))
        try:
            return p.wait(timeout=left(10)) == 0
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
            return False

    def exit_master(self):
        try:
            subprocess.run(self.base() + self.ctl() + ["-O", "exit", self.dest],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=5)
        except (subprocess.TimeoutExpired, OSError):
            pass

    def unreachable(self, err):
        lines = [l.strip() for l in err.decode("utf-8", "replace").splitlines() if l.strip()]
        text = "\n".join(lines)
        if "REMOTE HOST IDENTIFICATION HAS CHANGED" in text or "Host key verification failed" in text:
            return Fail(4, "host key for %s changed — if the instance was relaunched: "
                           "ssh-keygen -R %s -f ~/.vfg/known_hosts" % (self.host, self.host))
        return Fail(4, "cannot reach EC2 (%s): %s" % (self.dest, lines[-1] if lines else "ssh exited 255"))

    def _run(self, argv, data, timeout, deadline, stream, keep_master):
        try:
            p = subprocess.Popen(argv, stdin=subprocess.PIPE,
                                 stdout=None if stream else subprocess.PIPE,
                                 stderr=subprocess.PIPE,
                                 preexec_fn=_pdeathsig if stream else None)
        except OSError as e:
            raise Fail(3, "not configured: cannot run %s (%s)" % (argv[0], e.strerror))
        try:
            left = None if deadline is None else max(0.1, deadline - time.monotonic())
            o, e = p.communicate(data, timeout=left)
        except subprocess.TimeoutExpired:
            p.kill()
            p.communicate()
            if not keep_master:
                self.exit_master()
            raise TimedOut(4, "EC2 did not answer within %s s" % fmt_s(timeout))
        except BaseException:
            p.kill()
            p.wait()
            raise
        return p.returncode, o or b"", e or b""

    def call(self, data, timeout, remote_cmd=None, stream=False, keep_master=False):
        """One SSH call: (exit code, stdout, stderr). SSH failures raise.

        A timeout closes the shared master, taken for a dead link; with keep_master
        it stays up, for a call that may just be slow (an action) while others share it."""
        deadline = None if timeout is None else time.monotonic() + timeout
        via_master = self.ensure_master(deadline)
        rc, o, e = self._run(self.argv(remote_cmd), data, timeout, deadline, stream, keep_master)
        if rc == 255 and via_master:
            txt = e.decode("utf-8", "replace")
            if "Host key verification failed" not in txt and "IDENTIFICATION HAS CHANGED" not in txt:
                rc, o, e = self._run(self.argv(remote_cmd, direct=True), data, timeout, deadline, stream,
                                     keep_master)
        if rc == 255:
            raise self.unreachable(e)
        return rc, o, e


def finish(rc, o, e):
    """Pass a remote answer through: stdout, then exit code and one line."""
    out_bytes(o)
    if rc == 0:
        if e:
            sys.stderr.buffer.write(e)
            sys.stderr.flush()
        return 0
    lines = [l.strip() for l in e.decode("utf-8", "replace").splitlines() if l.strip()]
    line = lines[-1] if lines else "the remote program exited %d" % rc
    if line.startswith("vfg: "):
        line = line[5:]
    raise Fail(rc, line)


def remote(cfg, a, name, args, timeout, stream=False, libs=()):
    args = dict(args)
    args.setdefault("vfg", cfg.rvfg)
    args.setdefault("mc", cfg.rmc)
    if a.timeout is not None and timeout is not None:
        timeout = a.timeout
    return Ssh(cfg).call(program(name, args, libs), timeout, stream=stream)


