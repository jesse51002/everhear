def day_phase(t):
    t %= 24000
    return "day" if t < 12000 else "dusk" if t < 13000 else "night" if t < 23000 else "dawn"


def touches(item, info, cur, online):
    """Who an instance acts on: its player-type values (a list of players too); for a
    script without VALUES, the online players its arguments name."""
    vals = item.values if item is not None and isinstance(item.values, dict) else None
    out_ = []
    if vals is None:
        names = dict((p.lower(), p) for p in online)
        for w in info.get("args") or []:
            if w.lower() in names and names[w.lower()] not in out_:
                out_.append(names[w.lower()])
        return out_
    full = dict((k, e.get("default")) for k, e in vals.items() if isinstance(e, dict))
    full.update(cur)
    for k, e in vals.items():
        if not isinstance(e, dict):
            continue
        v = full.get(k)
        if e.get("type") == "player" and isinstance(v, str):
            got = [x.strip() for x in v.split(",") if x.strip()]
        elif e.get("type") == "list" and e.get("of") == "player" and isinstance(v, list):
            got = [x for x in v if isinstance(x, str)]
        else:
            continue
        for x in got:
            if x not in out_:
                out_.append(x)
    return out_


def cmd_state(cfg, a):
    """Who is online, where, the time, the weather and every running instance: one SSH call."""
    t0 = time.monotonic()
    library, lib = load_library(cfg)
    rc, o, e = remote(cfg, a, "scripts.py", {"op": "state"}, 30)
    if rc not in (0, 5):
        finish(rc, o, e)
    try:
        world = json.loads(o.decode("utf-8"))
    except ValueError:
        finish(rc, o, e)
        raise Fail(1, "scripts.py answered something that is not JSON")
    names = [p["name"] for p in world.get("online") or []]
    running = []
    for info in world.get("instances") or []:
        item = instance_item(cfg, library, info)
        cur = current_values(item, info)
        vals = item.values if item is not None and isinstance(item.values, dict) else None
        full = library.defaults(vals) if vals is not None else {}
        full.update(cur)
        running.append({"instance": info["instance"], "script": info.get("script"),
                        "source": info.get("source"), "task": info.get("task"), "pid": info.get("pid"),
                        "since": info.get("since"), "started": info.get("started"),
                        "values": full, "changed": library.differs(vals, cur) if vals is not None else cur,
                        "args": info.get("args") or [], "touches": touches(item, info, cur, names)})
    weather = None
    if world.get("raining") is not None:
        weather = "thunder" if world.get("thundering") else "rain" if world.get("raining") else "clear"
    daytime = world.get("daytime")
    result = {"online": world.get("online") or [],
              "time": {"daytime": daytime, "day": world.get("day"),
                       "phase": day_phase(daytime) if isinstance(daytime, int) else None},
              "weather": weather, "instances": running, "rcon": world.get("rcon"),
              "ms": int((time.monotonic() - t0) * 1000)}
    if a.json:
        out(json.dumps(result, ensure_ascii=False))
    else:
        rows = []
        if world.get("rcon"):
            rows.append(("minecraft", world["rcon"]))
        else:
            people = ["%s %s %s" % (p["name"], " ".join(str(c) for c in p["pos"]) if p.get("pos") else "?",
                                    p.get("dimension") or "?") for p in result["online"]]
            rows.append(("online", ", ".join(people) if people else "nobody"))
            t = result["time"]
            rows.append(("time", "%s (%s)%s" % (t["phase"] or "?", "?" if daytime is None else daytime,
                                                ", day %d" % t["day"] if isinstance(t["day"], int) else "")))
            rows.append(("weather", weather or "unknown"))
        for r in running:
            bits = []
            if r["script"] != r["instance"] or r["source"] == "made":
                bits.append(r["script"] + (" (made)" if r["source"] == "made" else ""))
            if r["task"]:
                bits.append(r["task"])
            if r["changed"]:
                bits.append(library.show(r["changed"]))
            if r["args"]:
                bits.append(" ".join(r["args"]))
            line = r["instance"] + (" — " + ", ".join(bits) if bits else "")
            if r["touches"]:
                line += "; touches " + ", ".join(r["touches"])
            rows.append(("running", line))
        if not running:
            rows.append(("running", "nothing"))
        out("\n".join("%-10s%s" % row for row in rows))
    if rc == 5:
        finish(rc, b"", e)
    return 0


class _Stop(Exception):
    pass


def _raise_stop(signum, frame):
    raise _Stop()


def follow_call(cfg, data):
    """A follow mode with no timeout; SIGTERM, SIGINT or SIGHUP end it with 0."""
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, _raise_stop)
    try:
        rc, o, e = Ssh(cfg).call(data, None, stream=True)
    except _Stop:
        return 0
    return finish(rc, o, e)


# ---------------------------------------------------------------- actions

ACTION_TIMEOUT = 30.0
REFS_TIMEOUT = 300.0


def command_list(fields):
    """The `command` action's commands, each checked as vfg cmd checks one."""
    extra = sorted(set(fields) - {"commands"})
    if extra:
        raise Fail(2, "command takes only commands, not %s" % ", ".join(extra))
    cmds = fields.get("commands")
    if not isinstance(cmds, list) or not cmds or not all(isinstance(c, str) for c in cmds):
        raise Fail(2, "commands is a list of at least one command")
    clean = []
    for c in cmds:
        c = c.strip()
        if c.startswith("/"):
            c = c[1:].strip()
        if not c:
            raise Fail(2, "empty command")
        check_home(c.split())
        n = len(c.encode("utf-8"))
        if n > RCON_MAX:
            raise Fail(1, "command is %d bytes; RCON takes at most %d — put it in a script" % (n, RCON_MAX))
        clean.append(c)
    return clean


def result_line(o):
    """The one JSON line remote/action.py prints, or None."""
    lines = o.decode("utf-8", "replace").strip().splitlines()
    if len(lines) != 1:
        return None
    try:
        r = json.loads(lines[0])
    except ValueError:
        return None
    return r if isinstance(r, dict) and isinstance(r.get("ok"), bool) else None


def cmd_action_run(cfg, a):
    """actions/<name>/handler.py runs on EC2 as a module, with places.py; `command`
    has no handler and runs its commands. pydantic checked the fields on the PC;
    this checks only their shape."""
    if not NAME_RE.match(a.name):
        raise Fail(2, "%s is not an action name" % a.name)
    if not TASK_RE.match(a.task):
        raise Fail(2, "--task is T<n>, like T7")
    try:
        fields = json.loads(a.fields)
    except ValueError:
        raise Fail(2, "--args is not JSON")
    if not isinstance(fields, dict):
        raise Fail(2, "--args is a JSON object of the action's fields")
    if fields.pop("action", a.name) != a.name:
        raise Fail(2, "--args is not for %s" % a.name)
    timeout = a.action_timeout if a.action_timeout is not None else a.timeout
    timeout = ACTION_TIMEOUT if timeout is None else timeout
    if not timeout > 0:
        raise Fail(2, "--timeout is seconds, more than 0")
    folder = os.path.join(cfg.repo, "actions", a.name)
    handler = os.path.join(folder, "handler.py")
    if not os.path.isdir(folder):
        raise Fail(1, "no actions/%s/ in %s" % (a.name, tilde(cfg.repo)))
    if os.path.isfile(handler):
        args = {"mode": "handler", "name": a.name, "task": a.task, "args": fields,
                "handler": read_text(handler), "places": read_text(os.path.join(REMOTE, "places.py"))}
    elif a.name == "command":
        args = {"mode": "commands", "task": a.task, "commands": command_list(fields)}
    else:
        raise Fail(1, "actions/%s/ has no handler.py, and only command runs without one" % a.name)
    args.update(vfg=cfg.rvfg, mc=cfg.rmc)
    try:
        rc, o, e = Ssh(cfg).call(program("action.py", args, ACTION_LIBS), timeout, keep_master=True)
    except TimedOut:
        raise Fail(124, "timed out: %s did not finish within %s s" % (a.name, fmt_s(timeout)))
    if rc == 0 and result_line(o) is None:
        out_bytes(o)
        raise Fail(1, "%s printed no result line" % a.name)
    return finish(rc, o, e)


def cmd_action_refs(cfg, a):
    if a.version_only:
        return finish(*remote(cfg, a, "refs.py", {"op": "version"}, 30))
    timeout = a.timeout if a.timeout is not None else REFS_TIMEOUT
    # The generator is stopped before the call gives up, so EC2 always cleans up.
    limit = timeout - 10 if timeout > 20 else timeout / 2
    return finish(*remote(cfg, a, "refs.py", {"op": "commands", "limit": limit}, REFS_TIMEOUT))


def cmd_action(cfg, a):
    return {"run": cmd_action_run, "refs": cmd_action_refs}[a.op](cfg, a)


# ----------------------------------------------------------------- places

# The saved places, cached on this PC for everyone who asks (the dispatcher, the
# orchestrator's brief hook, implementers, the conversation): $VFG_HOME/places.json,
# {"fetched_at": <epoch s>, "places": {name: {"pos", "dim", "by"}}}, mode 600, written
# atomically under places.lock. `vfg place list` answers from it while it is younger than
# VFG_PLACES_TTL_S, else fetches; save and forget write their entry through.

def places_module():
    """remote/places.py, for its line(): the same text the remote list prints."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("vfg_places", os.path.join(REMOTE, "places.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def places_cache_path(cfg):
    return os.path.join(cfg.home, "places.json")


def read_places_cache(cfg):
    """(places, age in seconds), or None when there is no readable cache."""
    try:
        with open(places_cache_path(cfg), encoding="utf-8") as f:
            data = json.load(f)
        found, at = data["places"], float(data["fetched_at"])
        if not isinstance(found, dict):
            return None
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return found, time.time() - at


def write_places_cache(cfg, found, fetched_at):
    os.makedirs(cfg.home, mode=0o700, exist_ok=True)
    atomic_write(places_cache_path(cfg), json.dumps({"fetched_at": fetched_at, "places": found},
                                                    sort_keys=True, ensure_ascii=False) + "\n")


def places_ttl(cfg):
    try:
        return max(0.0, float(cfg.get("VFG_PLACES_TTL_S")))
    except ValueError:
        raise Fail(3, "not configured: VFG_PLACES_TTL_S must be a number of seconds")


def show_places(found, as_json):
    if as_json:
        out(json.dumps(found, sort_keys=True, ensure_ascii=False))
    elif not found:
        out("none")
    else:
        line = places_module().line
        out("\n".join(line(name, found[name]) for name in sorted(found)))


def cmd_place_list(cfg, a):
    ttl = places_ttl(cfg)
    cached = read_places_cache(cfg)
    if cached is not None and not a.fresh and 0 <= cached[1] < ttl:
        show_places(cached[0], a.json)
        return 0
    try:
        rc, o, e = remote(cfg, a, "place.py", {"op": "list", "json": True}, 30, libs=["places.py"])
        if rc != 0:
            finish(rc, b"", e)  # raises Fail with the remote's one line
        found = json.loads(o.decode("utf-8"))
        if not isinstance(found, dict):
            raise Fail(1, "the place list is not a JSON object")
    except Fail as f:
        if cached is None:
            raise
        warn("saved places from %d s ago: %s" % (max(0, round(cached[1])), f.msg))
        show_places(cached[0], a.json)
        return 0
    with flocked(os.path.join(cfg.home, "places.lock")):
        write_places_cache(cfg, found, time.time())
    show_places(found, a.json)
    return 0


def update_places_cache(cfg, name, entry):
    """Write one place through to the cache (entry None: forgotten), keeping its age. No
    cache, nothing to update: a list of one would pass for the whole list."""
    with flocked(os.path.join(cfg.home, "places.lock")):
        cached = read_places_cache(cfg)
        if cached is None:
            return
        found = dict(cached[0])
        if entry is None:
            found.pop(name, None)
        else:
            found[name] = entry
        write_places_cache(cfg, found, time.time() - cached[1])


SAVED_RE = re.compile(r"^saved (\S+) at (-?\d+) (-?\d+) (-?\d+) in (\S+)$")


def cmd_place(cfg, a):
    if a.op == "list":
        return cmd_place_list(cfg, a)
    if not PLACE_RE.match(a.name):
        raise Fail(2, "%s is not a place name (a-z, 0-9 and _, at most 32)" % a.name)
    if a.op == "forget":
        rc = finish(*remote(cfg, a, "place.py", {"op": "forget", "name": a.name}, 30, libs=["places.py"]))
        update_places_cache(cfg, a.name, None)
        return rc
    if a.player is not None and not PLAYER_RE.match(a.player):
        raise Fail(2, "--player must be a player name (letters, digits, _; at most 16)")
    if a.at is not None and not all(COORD_RE.match(v) for v in a.at):
        raise Fail(2, "--at is three numbers, x y z")
    dim = None if a.dim is None else a.dim.strip().lower()
    if dim is not None and (a.at is None or not DIM_RE.match(dim)):
        raise Fail(2, "--dim goes with --at: overworld, the_nether or the_end")
    if a.by is not None and not TASK_RE.match(a.by):
        raise Fail(2, "--by is a task id, like T7")
    args = {"op": "save", "name": a.name, "player": a.player, "at": a.at, "dim": dim, "by": a.by or ""}
    rc, o, e = remote(cfg, a, "place.py", args, 30, libs=["places.py"])
    code = finish(rc, o, e)
    m = SAVED_RE.match(o.decode("utf-8", "replace").strip())
    if m:  # the server confirmed: write it through
        d = m.group(5)
        update_places_cache(cfg, m.group(1), {"pos": [int(m.group(2)), int(m.group(3)), int(m.group(4))],
                                              "dim": d if ":" in d else "minecraft:" + d, "by": a.by or ""})
    return code


