def cmd_up(cfg, a):
    ssh = Ssh(cfg)
    timeout = a.timeout if a.timeout is not None else 120
    rc, o, e = ssh.call(program("up.py", {"vfg": cfg.rvfg, "mc": cfg.rmc, "wait": 90}), timeout)
