    w.add_argument("--fresh", action="store_true", help="fetch from the server, whatever the cache's age")
    w = ps.add_parser("forget", help="remove a place; exit 1 if there was none")
    w.add_argument("name")

    s = sub.add_parser("incantation", help="list the players' incantations, the phrases that fire an action "
                       "the moment they are said (made, changed and removed by the incantation_create, "
                       "incantation_edit and incantation_remove actions)")
    ins = s.add_subparsers(dest="op", metavar="list")
    ins.required = True
    w = ins.add_parser("list", help="one line per incantation: player, phrase, action, its values, cooldown, "
                       "aliases and the everyday ones the spotter skips; or none. From the cache in "
                       "$VFG_HOME/incantations.json while it is younger than VFG_INCANT_TTL_S")
    w.add_argument("--player", metavar="P", help="only those P can cast: P's own and everyone's (@a)")
    w.add_argument("--json", action="store_true", help="a JSON list of {player, phrase, action, values, "
                   "cooldown_s, aliases, everyday_aliases}")
    w.add_argument("--fresh", action="store_true", help="fetch from the box, whatever the cache's age")

    s = sub.add_parser("usage", help="write a usage row, or send the queued ones; queued locally when EC2 is down")
    us = s.add_subparsers(dest="op", metavar="add|flush")
    us.required = True
    us.add_parser("flush", help="send the queued rows, structured()'s own among them; none queued, nothing sent")
    w = us.add_parser("add", help="write one row, after the queued ones")
    w.add_argument("--component", required=True, choices=COMPONENTS)
    w.add_argument("--model", required=True)
    w.add_argument("--in", dest="in_", type=int, required=True, metavar="N")
    w.add_argument("--out", type=int, required=True, metavar="N")
    w.add_argument("--cost", type=float, metavar="X")
    w.add_argument("--ref", metavar="REF", help="what the row is for: a task's name, a line's #seq; at most 64")
    w.add_argument("--cache-read", type=int, metavar="N", help="input tokens read from the cache")
    w.add_argument("--cache-write", type=int, metavar="N", help="input tokens written to the cache")
    w.add_argument("--largest", type=int, metavar="N", help="the run's largest request, in tokens: its input, "
                   "cached or not (an implementer's run)")
    return p


def rewrite_argv(argv):
    """Two words argparse would misread.

    `vfg action run …`: everything after `run` goes behind one `--`, so action_words parses
    it by hand (`--task` before or after the action, `as=`, values that start with -).
    `--since -10m` -> `--since=-10m` for history and context (argparse reads -10m as an option)."""
    i = 0
    while i < len(argv) and argv[i].startswith("--timeout"):
        i += 2 if argv[i] == "--timeout" else 1
    if argv[i:i + 2] == ["action", "run"] and argv[i + 2:i + 3] not in (["-h"], ["--help"]):
        return argv[:i + 2] + ["--"] + argv[i + 2:]
    if "history" not in argv and "context" not in argv:
        return argv
    out_, i = [], 0
    while i < len(argv):
        tok = argv[i]
        if tok == "--":
            out_.extend(argv[i:])
            break
        if tok in ("--since", "--until") and i + 1 < len(argv) and argv[i + 1].startswith("-"):
            out_.append(tok + "=" + argv[i + 1])
            i += 2
            continue
        out_.append(tok)
        i += 1
    return out_


