LIB = os.path.join(HERE, "lib")


def lib_module(name):
    """A module from toolkit/lib/, imported on first use."""
    if LIB not in sys.path:
        sys.path.insert(0, LIB)
    return __import__(name)


def task_record(cfg, tid):
    """(task, context) for `tid` from the orchestrator's records, or None.

    Its entry in state.json, else its line in inbox.jsonl (Contracts §9). The
    one place vfg route reads the runner's files, so a change of their shape
    is one change here."""
    try:
        with open(os.path.join(cfg.orch, "state.json"), encoding="utf-8") as f:
            t = (json.load(f).get("tasks") or {}).get(tid)
        if isinstance(t, dict) and t.get("task"):
            return t.get("task") or "", t.get("context") or ""
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    for r in read_jsonl(os.path.join(cfg.orch, "inbox.jsonl")):
        if r.get("id") == tid:
            return r.get("task") or "", r.get("context") or ""
    return None


def setting(cfg, key, default, lo, hi):
    """A number setting within [lo, hi]; an empty one is the default."""
    raw = cfg.get(key)
    try:
        v = float(raw) if raw else default
    except ValueError:
        raise Fail(3, "not configured: %s must be a number" % key)
    if not lo <= v <= hi:
        raise Fail(3, "not configured: %s must be from %s to %s" % (key, fmt_s(lo), fmt_s(hi)))
    return v


def jev_ask(cfg, state, questions, budget):
    """One Jev call through remote/jev.py, everything within `budget` seconds.

    Raises route.JevFailed for anything short of an answer: not configured,
    EC2 unreachable, Jev down or refusing, or no answer in time. A late answer
    is never waited for, and the shared SSH master is left up for the next."""
    route = lib_module("route")
    deadline = time.monotonic() + budget
    spent = route.estimate(state, questions)
    try:
        ssh = Ssh(cfg)
    except Fail as f:
        raise route.JevFailed(f.msg)
    via_master = ssh.ensure_master(deadline)
    for direct in ([False, True] if via_master else [True]):
        left = deadline - time.monotonic()
        if left <= 0.05:
            raise route.JevFailed("jev did not answer within %s s" % fmt_s(budget), tokens=spent)
        data = program("jev.py", {"vfg": cfg.rvfg, "mc": cfg.rmc, "state": state,
                                  "questions": questions, "timeout": round(max(0.2, left - 0.05), 2)})
        try:
            p = subprocess.Popen(ssh.argv(direct=direct), stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        except OSError as e:
            raise route.JevFailed("cannot run %s (%s)" % (cfg.get("VFG_SSH"), e.strerror))
        try:
            o, e = p.communicate(data, timeout=left)
        except subprocess.TimeoutExpired:
            p.kill()
            p.communicate()
            raise route.JevFailed("jev did not answer within %s s" % fmt_s(budget), tokens=spent)
        if p.returncode == 255 and not direct:
            txt = e.decode("utf-8", "replace")
            if "Host key verification failed" not in txt and "IDENTIFICATION HAS CHANGED" not in txt:
                continue
        break
    if p.returncode == 255:
        raise route.JevFailed(ssh.unreachable(e).msg)
    if p.returncode != 0:
        lines = [l.strip() for l in e.decode("utf-8", "replace").splitlines() if l.strip()]
        line = lines[-1] if lines else "jev.py exited %d" % p.returncode
        line = line[5:] if line.startswith("vfg: ") else line
        if line.startswith("jev did not answer within"):
            # the box gave up first, on what was left of the budget
            raise route.JevFailed("jev did not answer within %s s" % fmt_s(budget), tokens=spent)
        raise route.JevFailed(line)
    try:
        got = json.loads(o.decode("utf-8"))
    except ValueError:
        raise route.JevFailed("jev.py answered something that is not JSON")
    if not isinstance(got, dict):
        raise route.JevFailed("jev.py answered something that is not an object")
    return got


def usage_later(cfg, ref, tokens):
    """The router's usage row, by `vfg usage add` in its own session: the picks
    are printed without waiting for it, and it queues the row if EC2 is down."""
    cost = "%.9f" % (tokens * 0.000000042)   # $42 per billion input tokens, output free
    argv = [sys.executable, os.path.join(HERE, "vfg"), "usage", "add", "--component", "jev",
            "--model", "jev-latest", "--in", str(tokens), "--out", "0", "--cost", cost]
    if ref:
        argv += ["--ref", ref]
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    except OSError as e:
        warn("usage row not written: cannot run vfg (%s)" % e.strerror)


def cmd_route(cfg, a):
    """The example scripts and presets for one implementer's brief, as JSON."""
    t0 = time.monotonic()
    if a.task is not None and not TASK_RE.match(a.task):
        raise Fail(2, "--task is T<n>, like T7")
    ref = a.ref if a.ref is not None else a.task
    if ref is not None and not 0 < len(ref) <= 64:
        raise Fail(2, "--ref is 1 to 64 characters")
    if sys.stdin is None or sys.stdin.isatty():
        raise Fail(2, "the brief goes on stdin: vfg route --task T7 < brief.txt")
    brief = sys.stdin.buffer.read().decode("utf-8", "replace").strip()
    task, context = "", ""
    if a.task:
        found = task_record(cfg, a.task)
        if found is None:
            warn("%s is in neither state.json nor inbox.jsonl — routing on the brief alone" % a.task)
        else:
            task, context = found
    if not brief and not task:
        raise Fail(2, "no brief on stdin")
    budget = setting(cfg, "VFG_ROUTE_TIMEOUT_S", 3.0, 0.1, 60)
    load = setting(cfg, "VFG_ROUTE_LOAD", 0.3, 0.0, 1.0)
    route = lib_module("route")
    cards = route.load_cards(cfg.repo, server_name(cfg))
    result = route.route(cards, brief, a.task, task, context,
                         lambda st, qs, b: jev_ask(cfg, st, qs, b), load, budget, t0)
    out(json.dumps(result, ensure_ascii=False))
    usage_later(cfg, ref, result["tokens"])
    sys.stderr.write(route.log_line(result) + "\n")
    sys.stderr.flush()
    return 0


def cmd_prefix(cfg, a):
