def ensure_std_fds():
    """`vfg usage add … >&- 2>&-` must still work: give closed fds /dev/null."""
    for fd in (0, 1, 2):
        try:
            os.fstat(fd)
        except OSError:
            nfd = os.open(os.devnull, os.O_RDWR)
            if nfd != fd:
                os.dup2(nfd, fd)
                os.close(nfd)
    if sys.stdout is None:
        sys.stdout = io.TextIOWrapper(io.FileIO(1, "w", closefd=False), encoding="utf-8")
    if sys.stderr is None:
        sys.stderr = io.TextIOWrapper(io.FileIO(2, "w", closefd=False), encoding="utf-8")
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass


def log_invocation(cfg, argv, code, ms):
    try:
        cfg.ensure_home()
        path = os.path.join(cfg.home, "vfg.log")
        try:
            if os.path.getsize(path) > LOG_MAX:
                os.replace(path, path + ".1")
        except OSError:
            pass
        shown = [x if len(x) <= 200 else x[:200] + "…" for x in argv]
        append_line(path, "%s %s exit=%d %dms\n" % (now_iso(), json.dumps(shown, ensure_ascii=False),
                                                    code, ms))
    except Exception:
        pass


def run(argv, started):
    cfg = Config()
    a = build_parser().parse_args(rewrite_argv(argv))
    if a.command == "up":
        return cmd_up(cfg, a)
    if a.command == "watch":
        return cmd_watch(cfg, a)
    if a.command == "say":
        return cmd_say(cfg, a)
    if a.command == "cmd":
        return cmd_cmd(cfg, a)
    if a.command == "history":
        return cmd_history(cfg, a)
    if a.command == "watchers":
        return cmd_watchers(cfg, a)
    if a.command == "lookout":
        return cmd_lookout(cfg, a)
    if a.command == "orch":
        return cmd_orch(cfg, a)
    if a.command == "feed":
        return cmd_feed(cfg, a)
    if a.command == "script":
        return cmd_script(cfg, a)
    if a.command == "action":
        return cmd_action(cfg, a)
    if a.command == "place":
        return cmd_place(cfg, a)
    if a.command == "usage":
        return cmd_usage(cfg, a, started)
    raise Fail(2, "unknown command")


def main(argv=None):
    started = time.time()
    t0 = time.monotonic()
    ensure_std_fds()
    argv = list(sys.argv[1:] if argv is None else argv)
    try:
        code = run(argv, started) or 0
    except Fail as f:
        try:
            sys.stdout.flush()
        except Exception:
            pass
        if f.msg:
            warn(f.msg)
        code = f.code
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else (0 if e.code is None else 2)
    except KeyboardInterrupt:
        code = 130
    except BrokenPipeError:
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
        except OSError:
            pass
        code = 0
    try:
        log_invocation(Config(), argv, code, int((time.monotonic() - t0) * 1000))
    except Exception:
        pass
    return code


if __name__ == "__main__":
    sys.exit(main())
