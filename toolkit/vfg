def cmd_context(cfg, a):
    """The brain's context: the feed rows since then (by default the last
    VFG_BRAIN_HISTORY_HOURS), oldest first, and with --json then {"tasks": [every row of the box's
    tasks table, oldest first]}, the brain's tasks as it starts, and the feed's highest seq last,
    which the brain follows from even when no row is that recent; or `mark`, which sets
    processed_at on the rows it names. One SSH call either way."""
    if a.op == "mark":
        seqs = []
        for s in a.seqs:
            if not s.isdigit() or int(s) < 1:
                raise Fail(2, "%r is not a feed seq (a whole number, 1 or more)" % s)
            seqs.append(int(s))
        return finish(*remote(cfg, a, "context.py", {"op": "mark", "seqs": seqs}, 30))
    hours = setting(cfg, "VFG_BRAIN_HISTORY_HOURS", 6.0, 0.0, 24 * 365)
    since = parse_when(a.since) if a.since else now_iso(time.time() - hours * 3600)
    return finish(*remote(cfg, a, "context.py", {"op": "read", "since": since, "json": bool(a.json)}, 30))


def cmd_watchers(cfg, a):
