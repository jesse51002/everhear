LIB = os.path.join(HERE, "lib")


def lib_module(name):
    """A module from toolkit/lib/, imported on first use."""
    if LIB not in sys.path:
        sys.path.insert(0, LIB)
    return __import__(name)


ROUTE_TASK_S = 1.5   # vfg route's read of its task's row, at most, out of VFG_ROUTE_TIMEOUT_S


def task_record(cfg, a, name, timeout=ROUTE_TASK_S):
    """(task, context) for the task `name`, read from the box's tasks table (task_read): its
    description, else its brief, and `<player> said: <line>` as its context; None when the box
    has no such task. Fail when it cannot be read. The one place vfg route reads the brain's
    tasks, so a change of their shape is one change here."""
    rows = task_read(cfg, {"open": False, "name": name}, timeout, keep_master=True)
    t = rows[0] if rows else None
    text = str((t or {}).get("description") or (t or {}).get("brief") or "")
    if not text:
        return None
    line = str(t.get("line") or "")
    return text, ("%s said: %s" % (t["player"], line) if t.get("player") and line else line)


def setting(cfg, key, default, lo, hi):
    """A number setting within [lo, hi]; an empty one is the default."""
    raw = cfg.get(key)
    try:
        v = float(raw) if raw else default
    except ValueError:
        raise Fail(3, "not configured: %s must be a number" % key)
    if not lo <= v <= hi:
        raise Fail(3, "not configured: %s must be from %s to %s" % (key, fmt_s(lo), fmt_s(hi)))
    return v


def jev_ask(cfg, state, questions, budget, said=None):
    """One Jev call through remote/jev.py, everything within `budget` seconds.

    Raises route.JevFailed for anything short of an answer: not configured,
    EC2 unreachable, Jev down or refusing, or no answer in time, which it says as
    `said` seconds (VFG_ROUTE_TIMEOUT_S, of which `budget` is what was left), else
    `budget`. A late answer is never waited for, and the shared SSH master is left
    up for the next."""
    route = lib_module("route")
    late = "jev did not answer within %s s" % fmt_s(budget if said is None else said)
    deadline = time.monotonic() + budget
    spent = route.estimate(state, questions)
    try:
        ssh = Ssh(cfg)
    except Fail as f:
        raise route.JevFailed(f.msg)
    via_master = ssh.ensure_master(deadline)
    for direct in ([False, True] if via_master else [True]):
        left = deadline - time.monotonic()
        if left <= 0.05:
            raise route.JevFailed(late, tokens=spent)
        data = program("jev.py", {"vfg": cfg.rvfg, "mc": cfg.rmc, "state": state,
                                  "questions": questions, "timeout": round(max(0.2, left - 0.05), 2)})
        try:
            p = subprocess.Popen(ssh.argv(direct=direct), stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        except OSError as e:
            raise route.JevFailed("cannot run %s (%s)" % (cfg.get("VFG_SSH"), e.strerror))
        try:
            o, e = p.communicate(data, timeout=left)
        except subprocess.TimeoutExpired:
            p.kill()
            p.communicate()
            raise route.JevFailed(late, tokens=spent)
        if p.returncode == 255 and not direct:
            txt = e.decode("utf-8", "replace")
            if "Host key verification failed" not in txt and "IDENTIFICATION HAS CHANGED" not in txt:
                continue
        break
    if p.returncode == 255:
        raise route.JevFailed(ssh.unreachable(e).msg)
    if p.returncode != 0:
        lines = [l.strip() for l in e.decode("utf-8", "replace").splitlines() if l.strip()]
        line = lines[-1] if lines else "jev.py exited %d" % p.returncode
        line = line[5:] if line.startswith("vfg: ") else line
        if line.startswith("jev did not answer within"):
            # the box gave up first, on what was left of the budget
            raise route.JevFailed(late, tokens=spent)
        raise route.JevFailed(line)
    try:
        got = json.loads(o.decode("utf-8"))
    except ValueError:
        raise route.JevFailed("jev.py answered something that is not JSON")
    if not isinstance(got, dict):
        raise route.JevFailed("jev.py answered something that is not an object")
    return got


def vfg_later(args, what):
    """`vfg <args>` in its own session, nobody waiting for it; `what` names it in the one warning
    when it cannot start."""
    try:
        subprocess.Popen([sys.executable, os.path.join(HERE, "vfg")] + list(args), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                         close_fds=True)
    except OSError as e:
        warn("%s: cannot run vfg (%s)" % (what, e.strerror))


def usage_later(cfg, ref, tokens):
    """The router's usage row, by `vfg usage add` in its own session: the picks
    are printed without waiting for it, and it queues the row if EC2 is down."""
    cost = "%.9f" % (tokens * 0.000000042)   # $42 per billion input tokens, output free
    args = ["usage", "add", "--component", "jev", "--model", "jev-latest", "--in", str(tokens), "--out", "0",
            "--cost", cost]
    if ref:
        args += ["--ref", ref]
    vfg_later(args, "usage row not written")


def flush_usage_later(cfg):
    """`vfg usage flush` in its own session: the rows structured() queued, sent to the box."""
    vfg_later(["usage", "flush"], "usage rows not sent")


def cmd_route(cfg, a):
    """The example scripts, presets and actions for one implementer's brief, as JSON (lib/route.py:
    at most 3 scripts and 7 actions). With --task, the
    task's row is read from the box first (at most ROUTE_TASK_S, out of the budget): Jev gets its
    description and the player's words beside the brief; without it, or when it cannot be read,
    the brief alone."""
    t0 = time.monotonic()
    if a.task is not None:
        check_task(a.task, "--task")
    ref = a.ref if a.ref is not None else a.task
    if ref is not None and not 0 < len(ref) <= 64:
        raise Fail(2, "--ref is 1 to 64 characters")
    if sys.stdin is None or sys.stdin.isatty():
        raise Fail(2, "the brief goes on stdin: vfg route --task galick_gun_styrk < brief.txt")
    brief = sys.stdin.buffer.read().decode("utf-8", "replace").strip()
    budget = setting(cfg, "VFG_ROUTE_TIMEOUT_S", 3.0, 0.1, 60)
    load = setting(cfg, "VFG_ROUTE_LOAD", 0.3, 0.0, 1.0)
    task, context = "", ""
    if a.task:
        try:
            found = task_record(cfg, a, a.task, min(ROUTE_TASK_S, budget))
        except Fail as f:
            warn("cannot read %s from the box (%s) — routing on the brief alone" % (a.task, f.msg))
        else:
            if found is None:
                warn("%s is not a task on the box — routing on the brief alone" % a.task)
            else:
                task, context = found
    if not brief and not task:
        raise Fail(2, "no brief on stdin")
    route = lib_module("route")
    cards = route.load_cards(cfg.repo, server_name(cfg), actions_cache(cfg))
    # What Jev gets is what is left of the budget: the task's read came out of it.
    result = route.route(cards, brief, a.task, task, context,
                         lambda st, qs, b: jev_ask(cfg, st, qs, b, budget), load,
                         max(0.1, budget - (time.monotonic() - t0)), t0)
    out(json.dumps(result, ensure_ascii=False))
    usage_later(cfg, ref, result["tokens"])
    sys.stderr.write(route.log_line(result) + "\n")
    sys.stderr.flush()
    return 0


def cmd_prefix(cfg, a):
    """The implementer's static system prompt, exactly: the same bytes every time. Its last part is
    the library's actions, from the actions cache (built first when it is stale); when that cannot
    be read, a line saying so stands in for them, and stderr says why."""
    try:
        acts = actions_lib().cache(cfg.repo, server_name(cfg), cfg.home)
    except Fail as f:
        warn("the library's actions are not in the prefix: %s" % f.msg)
        acts = None
    except Exception as e:  # a cache that cannot be built: the prefix still goes
        warn("the library's actions are not in the prefix: %s: %s" % (type(e).__name__, one_line(str(e))))
        acts = None
    out_bytes(lib_module("prefix").build(cfg.repo, acts).encode("utf-8"))
    return 0


