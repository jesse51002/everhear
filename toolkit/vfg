    if a.command == "lookout":
        return cmd_lookout(cfg, a)
    if a.command == "brain":
        return cmd_brain(cfg, a)
    if a.command == "task":
        return cmd_task(cfg, a)
    if a.command == "feed":
        return cmd_feed(cfg, a)
    if a.command == "jev":
        return cmd_jev(cfg, a)
    if a.command == "action":
