def ensure_std_fds():
    """`vfg usage add … >&- 2>&-` must still work: give closed fds /dev/null."""
    for fd in (0, 1, 2):
        try:
            os.fstat(fd)
        except OSError:
            nfd = os.open(os.devnull, os.O_RDWR)
            if nfd != fd:
                os.dup2(nfd, fd)
                os.close(nfd)
    if sys.stdout is None:
        sys.stdout = io.TextIOWrapper(io.FileIO(1, "w", closefd=False), encoding="utf-8")
    if sys.stderr is None:
        sys.stderr = io.TextIOWrapper(io.FileIO(2, "w", closefd=False), encoding="utf-8")
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError, OSError):
            pass


def log_invocation(cfg, argv, code, ms):
    try:
        cfg.ensure_home()
        path = os.path.join(cfg.home, "vfg.log")
        try:
            if os.path.getsize(path) > LOG_MAX:
                os.replace(path, path + ".1")
        except OSError:
            pass
        shown = [x if len(x) <= 200 else x[:200] + "…" for x in argv]
        append_line(path, "%s %s exit=%d %dms\n" % (now_iso(), json.dumps(shown, ensure_ascii=False),
                                                    code, ms))
    except Exception:
        pass


def run(argv, started):
    cfg = Config()
    a = build_parser().parse_args(rewrite_argv(argv))
    if a.command == "up":
        return cmd_up(cfg, a)
