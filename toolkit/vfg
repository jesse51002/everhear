# The commands that may load the actions (pydantic). vfg prefix ends with the library's actions,
# from the cache it builds again when stale; vfg route reads the cache as it is, and builds it only
# when there is none.
NEEDS_ACTIONS = ("action", "cmd", "script", "place", "state", "preset", "incantation", "prefix", "test")


def under_uv(argv):
    """Start again under uv when a command that may load the actions runs where pydantic is
    missing (`python3 vfg …`); with no uv, carry on, and the actions say what is missing."""
    i = 0
    while i < len(argv) and argv[i].startswith("--timeout"):
        i += 2 if argv[i] == "--timeout" else 1
    if os.environ.get("VFG_UNDER_UV") or argv[i:i + 1] == [] or argv[i] not in NEEDS_ACTIONS:
        return
    import importlib.util
    if importlib.util.find_spec("pydantic") is not None:
        return
    env = dict(os.environ, VFG_UNDER_UV="1")
    try:
        os.execvpe("uv", ["uv", "run", "--script", "--quiet", os.path.realpath(__file__)] + list(argv), env)
    except OSError:
        pass


def main(argv=None):
    started = time.time()
    t0 = time.monotonic()
    ensure_std_fds()
    argv = list(sys.argv[1:] if argv is None else argv)
    if __name__ == "__main__":
        under_uv(argv)
    try:
        code = run(argv, started) or 0
    except Fail as f:
        try:
            sys.stdout.flush()
        except Exception:
            pass
        if f.msg:
            warn(f.msg)
        code = f.code
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else (0 if e.code is None else 2)
    except KeyboardInterrupt:
        code = 130
    except BrokenPipeError:
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
        except OSError:
            pass
        code = 0
    try:
        log_invocation(Config(), argv, code, int((time.monotonic() - t0) * 1000))
    except Exception:
        pass
    return code


if __name__ == "__main__":
    sys.exit(main())
