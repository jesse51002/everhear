def cmd_cmd(cfg, a):
    """vfg cmd: one server command, through the command action; prints Minecraft's reply."""
    words = list(a.words)
    if words[:1] == ["--"]:
        words = words[1:]
    check_home(words)
    command = " ".join(words)
    if command.startswith("/"):
        command = command[1:]
    if not command.strip():
        raise Fail(2, "empty command")
    n = len(command.encode("utf-8"))
    if n > RCON_MAX:
        raise Fail(1, "command is %d bytes; RCON takes at most %d — put it in a script" % (n, RCON_MAX))
    line = run_action(cfg, a, "command", {"commands": [command]})
    replies = line["facts"].get("replies")
    if isinstance(replies, list):
        out("\n".join(r for r in replies if isinstance(r, str) and r))
    else:
        out(line["summary"])
    if not line["ok"]:
        raise Fail(1, "minecraft rejected the command" if line["facts"].get("failed") else line.get("error"))
    return 0


def tellraw(target, prefix, text):
    return 'tellraw %s [{"text":""},{"text":%s,"color":"aqua"},{"text":%s}]' % (
        target, json.dumps(prefix, ensure_ascii=False), json.dumps(text, ensure_ascii=False))


def tellraws(target, prefix, text):
    """One tellraw, or several split at spaces, each at most RCON_MAX bytes."""
    def fits(t):
        return len(tellraw(target, prefix, t).encode("utf-8")) <= RCON_MAX
    if fits(text):
        return [tellraw(target, prefix, text)]
    if not fits(""):
        raise Fail(2, "VFG_CHAT_PREFIX is too long")
    chunks, cur = [], None
    for w in text.split(" "):
        cand = w if cur is None else cur + " " + w
        if fits(cand):
            cur = cand
            continue
        if cur is not None and cur.strip():
            chunks.append(cur)
        cur = None
        if fits(w):
            cur = w
            continue
        piece = ""
        for ch in w:
            if fits(piece + ch):
                piece += ch
            else:
                chunks.append(piece)
                piece = ch
        cur = piece
    if cur is not None and cur.strip():
        chunks.append(cur)
    return [tellraw(target, prefix, c) for c in chunks]


def say_words(a):
    """Every word is the message, wherever `--to P` sits; after `--`, all are.

    A model that splits the text on a stray quote still sends the whole line."""
    to, words, rest, i = a.to, [], list(a.text), 0
    while i < len(rest):
        tok = rest[i]
        if tok == "--":
            words.extend(rest[i + 1:])
            break
        if tok == "--to":
            if i + 1 >= len(rest):
                raise Fail(2, "--to needs a player name")
            to = rest[i + 1]
            i += 2
            continue
        if tok.startswith("--to="):
            to = tok[len("--to="):]
        else:
            words.append(tok)
        i += 1
    return to, words


def cmd_say(cfg, a):
    a.to, words = say_words(a)
    text = clean_text(" ".join(words))
    if not text:
        raise Fail(2, "nothing to say")
    if a.to is not None and not PLAYER_RE.match(a.to):
        raise Fail(2, "--to must be a player name (letters, digits, _; at most 16)")
    commands = tellraws(a.to or "@a", cfg.get("VFG_CHAT_PREFIX"), text)
    store = "(to %s) %s" % (a.to, text) if a.to else text
    return finish(*remote(cfg, a, "rcon.py", {"mode": "say", "to": a.to, "commands": commands,
                                              "store": store}, 30))


REL_RE = re.compile(r"^-(\d+)([smhd])$")


def parse_when(s):
    """ISO-8601 or -90s/-10m/-2h/-1d, as YYYY-MM-DDTHH:MM:SS.mmmZ."""
    s = s.strip()
    m = REL_RE.match(s)
    if m:
        unit = {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
        return now_iso(time.time() - int(m.group(1)) * unit)
    try:
        if re.match(r"^\d{4}-\d{2}-\d{2}$", s):
            d = datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=timezone.utc)
        else:
            iso = s[:-1] + "+00:00" if s.endswith(("Z", "z")) else s
            d = datetime.fromisoformat(iso)
            if d.tzinfo is None:
                d = d.replace(tzinfo=timezone.utc)
    except ValueError:
        raise Fail(2, "bad time %r: use ISO-8601 (2026-10-07T18:22:31Z) or -90s, -10m, -2h, -1d" % s)
    d = d.astimezone(timezone.utc)
    return d.strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (d.microsecond // 1000)


def cmd_history(cfg, a):
    what = "events" if a.events else "feed" if a.feed else "lines"
    if what != "lines" and (a.cls or a.source):
        raise Fail(2, "--class and --source go with lines, not --%s" % what)
    if what == "feed" and a.player:
        raise Fail(2, "--player does not go with --feed")
    classes = None
    if a.cls:
        classes = [c.strip() for c in a.cls.split(",") if c.strip()]
        bad = [c for c in classes if c not in CLASSES]
        if bad or not classes:
            raise Fail(2, "--class takes %s" % ", ".join(CLASSES))
    since = parse_when(a.since) if a.since else None
    until = parse_when(a.until) if a.until else None
    if since and until and since > until:
        raise Fail(2, "--since is after --until")
    if not 1 <= a.limit <= 1000:
        raise Fail(2, "--limit is 1 to 1000")
    args = {"what": what, "since": since, "until": until, "player": a.player,
            "classes": classes, "source": a.source, "limit": a.limit}
    return finish(*remote(cfg, a, "history.py", args, 30))


def cmd_watchers(cfg, a):
    if a.op == "show":
        return finish(*remote(cfg, a, "files.py", {"op": "watchers_show"}, 30))
    kinds = [k.strip() for k in a.kinds.split(",") if k.strip()]
    if kinds == ["all"]:
        events = list(KINDS)
    elif kinds == ["none"]:
        events = []
    else:
        bad = [k for k in kinds if k not in KINDS]
        if bad or not kinds:
            raise Fail(2, "kinds are a comma list of %s, or all, or none" % ", ".join(KINDS))
        events = [k for k in KINDS if k in kinds]
    players = []
    if a.players:
        players = [p.strip() for p in a.players.split(",") if p.strip()]
        for p in players:
            if not PLAYER_RE.match(p):
                raise Fail(2, "%r is not a player name" % p)
    contains = list(a.contains or [])
    for rx in contains:
        try:
            re.compile(rx)
        except re.error as e:
            raise Fail(2, "--contains %r does not compile: %s" % (rx, e))
    watch = {"events": events, "players": players, "contains": contains}
    return finish(*remote(cfg, a, "files.py", {"op": "watchers_set", "watch": watch}, 30))


def cmd_lookout(cfg, a):
    if a.op == "show":
        return finish(*remote(cfg, a, "files.py", {"op": "lookout_show"}, 30))
    words = list(a.text)
    if words == ["-"]:
        text = sys.stdin.read()
    else:
        text = " ".join(words)
    text = text.strip()
    if not 1 <= len(text) <= 8000:
        raise Fail(2, "the lookout is 1 to 8000 characters (got %d)" % len(text))
    return finish(*remote(cfg, a, "files.py", {"op": "lookout_set", "text": text}, 30))


def feed_post(cfg, a, typ, fields, text):
    """Run vfg_feed.py post over SSH; returns (rc, stdout, stderr)."""
    if typ not in TYPES:
        raise Fail(2, "TYPE is one of %s" % ", ".join(TYPES))
    if "|" in fields or "\n" in fields or "\r" in fields:
        raise Fail(2, "fields hold no | and no newline")
    if typ == "SYS" and fields != "":
        raise Fail(2, "SYS lines have no fields")
    if typ == "ORCH" and not ORCH_FIELDS_RE.match(fields):
        raise Fail(2, "ORCH fields are '<task> progress|done|failed'")
    # ssh carries no environment, and vfg_feed.py finds its files by VFG_DB and
    # VFG_FEED (default /opt/vfg), so they are set here; `env` keeps them
    # assignments however shlex quotes them.
    cmd = shlex.join(["env", "VFG_DB=" + cfg.rvfg + "/vfg.db", "VFG_FEED=" + cfg.rvfg + "/feed.log",
                      box_python(cfg), cfg.rvfg + "/lib/vfg_feed.py", "post", typ, fields, text])
    timeout = a.timeout if a.timeout is not None else 30
    return Ssh(cfg).call(b"", timeout, remote_cmd=cmd)


def cmd_feed(cfg, a):
    return finish(*feed_post(cfg, a, a.type, a.fields, a.text))


def cmd_usage(cfg, a, started):
    if a.component not in COMPONENTS:
        raise Fail(2, "--component is one of %s" % ", ".join(COMPONENTS))
    if not a.model.strip() or len(a.model) > 200:
        raise Fail(2, "--model is a model name")
    if a.in_ < 0 or a.out < 0:
        raise Fail(2, "--in and --out are whole numbers, 0 or more")
    if (a.cache_read or 0) < 0 or (a.cache_write or 0) < 0:
        raise Fail(2, "--cache-read and --cache-write are whole numbers, 0 or more")
    if a.cost is not None and (a.cost < 0 or math.isnan(a.cost) or math.isinf(a.cost)):
        raise Fail(2, "--cost is a number, 0 or more")
    if a.ref is not None and len(a.ref) > 64:
        raise Fail(2, "--ref is at most 64 characters")
    row = {"at": now_iso(started), "component": a.component, "model": a.model.strip(),
           "input_tokens": a.in_, "output_tokens": a.out, "cost_usd": a.cost, "ref": a.ref,
           "cache_read_tokens": a.cache_read, "cache_write_tokens": a.cache_write}
    cfg.ensure_home()
    pending = Pending(cfg.home)
    rows = pending.claim() + [row]
    try:
        timeout = a.timeout if a.timeout is not None else 15
        rc, o, e = Ssh(cfg).call(program("usage.py", {"vfg": cfg.rvfg, "rows": rows}), timeout)
        if rc != 0:
            pending.requeue(rows)
        else:
            pending.done()
    except BaseException:
        pending.requeue(rows)
        raise
    return finish(rc, o, e)


class Pending(object):
    """usage.pending.jsonl: rows that could not reach EC2, inserted next time.

    A call claims the queue by moving it into usage.sending.<pid>.jsonl, so two
    calls never insert the same row; a crashed caller's file is claimed again."""

    def __init__(self, home):
        self.home = home
        self.queue = os.path.join(home, "usage.pending.jsonl")
        self.lock = os.path.join(home, "usage.pending.lock")
        self.mine = os.path.join(home, "usage.sending.%d.jsonl" % os.getpid())

    def claim(self):
        rows = []
        with flocked(self.lock):
            sources = [self.queue]
            for name in os.listdir(self.home):
                m = re.match(r"^usage\.sending\.(\d+)\.jsonl$", name)
                if m and int(m.group(1)) != os.getpid() and not self._alive(int(m.group(1))):
                    sources.append(os.path.join(self.home, name))
            for path in sources:
                rows.extend(read_jsonl(path))
            if rows:
                atomic_write(self.mine, "".join(json.dumps(r) + "\n" for r in rows))
            for path in sources:
                try:
                    os.remove(path)
                except OSError:
                    pass
        return rows

    @staticmethod
    def _alive(pid):
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def requeue(self, rows):
        with flocked(self.lock):
            if rows:
                append_line(self.queue, "".join(json.dumps(r) + "\n" for r in rows))
            self._drop()

    def done(self):
        self._drop()

    def _drop(self):
        try:
            os.remove(self.mine)
        except OSError:
            pass


# ----------------------------------------------------------------- orch

# The two processes vfg orch runs, in the order a task meets them: `vfg orch send`
# writes the dispatcher's inbox, and the dispatcher hands whatever it cannot do
# quickly to the orchestrator's (`vfg orch hand`), which the runner reads.
Part = collections.namedtuple("Part", "name run folder log pidfile marker")


def parts(cfg):
    return [Part("dispatcher", os.path.join(cfg.repo, "dispatcher", "run"), cfg.dispatch,
                 "dispatcher.log", "dispatcher.pid", "VFG_DISPATCHER=1"),
            Part("orchestrator", os.path.join(cfg.repo, "orchestrator", "run"), cfg.orch,
                 "runner.log", "runner.pid", "VFG_ORCH_RUNNER=1")]


def part_pid(part):
    """Its pid when it is running; a stale pid file is removed."""
    path = os.path.join(part.folder, part.pidfile)
    pid = read_int(path)
    if pid is None:
        return None
    if pid_with_marker(pid, part.marker):
        return pid
    try:
        os.remove(path)
    except OSError:
        pass
    return None


def runner_pid(cfg):
    return part_pid(parts(cfg)[1])


def not_running(names):
    names = ["orchestrator runner" if n == "orchestrator" else n for n in names]
    return "%s %s not running" % (" and ".join(names), "is" if len(names) == 1 else "are")


def task_ids(path):
    """Every T<n> in an inbox, in order, once each."""
    seen, ids = set(), []
    for r in read_jsonl(path):
        tid = r.get("id")
        if isinstance(tid, str) and TASK_RE.match(tid) and tid not in seen:
            seen.add(tid)
            ids.append(tid)
    return ids


def open_tasks(cfg):
    """Every task not yet done or failed, by number, and which of them the orchestrator holds."""
    closed = set(r.get("id") for r in read_jsonl(os.path.join(cfg.orch, "replies.jsonl"))
                 if r.get("status") in ("done", "failed"))
    handed = set(task_ids(os.path.join(cfg.orch, "inbox.jsonl")))
    ids = sorted((set(task_ids(os.path.join(cfg.dispatch, "inbox.jsonl"))) | handed) - closed,
                 key=lambda t: int(t[1:]))
    return ids, [t for t in ids if t in handed]


def cmd_orch_send(cfg, a):
    task = " ".join(a.task).strip()
    if not task:
        raise Fail(2, "empty task")
    os.makedirs(cfg.dispatch, mode=0o700, exist_ok=True)
    inbox = os.path.join(cfg.dispatch, "inbox.jsonl")
    with flocked(os.path.join(cfg.dispatch, "inbox.lock")):
        # The orchestrator's inbox counts too, so a task sent before the dispatcher
        # (or handed with an id of its own) never shares its id with a new one.
        used = task_ids(inbox) + task_ids(os.path.join(cfg.orch, "inbox.jsonl"))
        tid = "T%d" % (max([0] + [int(t[1:]) for t in used]) + 1)
        append_line(inbox, json.dumps({"id": tid, "at": now_iso(), "task": task,
                                       "context": a.context or ""}, ensure_ascii=False) + "\n")
    out(tid)
    down = [p.name for p in parts(cfg) if not part_pid(p)]
    if down:
        warn(not_running(down) + " — vfg orch start")
    return 0


def hand_lines(text):
    """The task lines for `vfg orch hand`, checked, in the inbox's own shape."""
    try:
        rows = json.loads(text)
    except ValueError:
        raise Fail(2, "the task lines are not JSON")
    if not isinstance(rows, list) or not rows:
        raise Fail(2, 'the task lines are a JSON list: [{"id": "T7", "task": "…"}, …]')
    lines = []
    for i, r in enumerate(rows, 1):
        if not isinstance(r, dict):
            raise Fail(2, "line %d is not a JSON object" % i)
        tid, task, at, context = r.get("id"), r.get("task"), r.get("at"), r.get("context")
        if not isinstance(tid, str) or not TASK_RE.match(tid):
            raise Fail(2, "line %d: the id is T<n>, like T7" % i)
        if not isinstance(task, str) or not task.strip():
            raise Fail(2, "%s: empty task" % tid)
        if at is not None and not isinstance(at, str):
            raise Fail(2, "%s: at is an ISO-8601 time" % tid)
        if context is not None and not isinstance(context, str):
            raise Fail(2, "%s: context is text" % tid)
        lines.append({"id": tid, "at": at or now_iso(), "task": task, "context": context or ""})
    return lines


def cmd_orch_hand(cfg, a):
    lines = hand_lines(a.lines)
    os.makedirs(cfg.orch, mode=0o700, exist_ok=True)
    inbox = os.path.join(cfg.orch, "inbox.jsonl")
    said, data = [], []
    with flocked(os.path.join(cfg.orch, "inbox.lock")):
        have = set(task_ids(inbox))
        for line in lines:
            if line["id"] in have:
                said.append("skipped %s (already handed)" % line["id"])
                continue
            have.add(line["id"])
            data.append(json.dumps(line, ensure_ascii=False) + "\n")
            said.append("handed %s" % line["id"])
        if data:
            # One write: the runner sees them arrive together and folds them into one turn.
            append_line(inbox, "".join(data))
    out("\n".join(said))
    if data and not runner_pid(cfg):
        warn("orchestrator runner is not running — vfg orch start")
    return 0


def spawn(cfg, part):
    """Run it detached in a process group of its own, its output appended to its log."""
    os.makedirs(part.folder, mode=0o700, exist_ok=True)
    log = os.path.join(part.folder, part.log)
    append_line(log, "--- vfg orch start %s ---\n" % now_iso())
    env = dict(os.environ)
    for k in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "VFG_ORCH_RUNNER", "VFG_DISPATCHER"):
        env.pop(k, None)
    key, value = part.marker.split("=", 1)
    env[key] = value
    env.setdefault("VFG_ORCH_DIR", cfg.orch)
    env["VFG_DISPATCH_DIR"] = cfg.dispatch
    env.setdefault("VFG_REPO", cfg.repo)
    logf = open(log, "ab")
    try:
        p = subprocess.Popen([part.run], cwd=os.path.dirname(part.run), stdin=subprocess.DEVNULL,
                             stdout=logf, stderr=subprocess.STDOUT, start_new_session=True, env=env)
    finally:
        logf.close()
    atomic_write(os.path.join(part.folder, part.pidfile), "%d\n" % p.pid)
    return p


def cmd_orch_start(cfg, a):
    """Start each that is not running, the orchestrator first so a hand-off has a
    reader; one that exits within 3 s did not start."""
    said, started, failed = {}, [], []
    for part in reversed(parts(cfg)):
        pid = part_pid(part)
        if pid:
            said[part.name] = "running pid %d" % pid
        elif not (os.path.isfile(part.run) and os.access(part.run, os.X_OK)):
            said[part.name] = "not started"
            failed.append("%s is missing or not executable" % tilde(part.run))
        else:
            started.append((part, spawn(cfg, part)))
    deadline = time.monotonic() + 3
    for part, p in started:
        try:
            code = p.wait(timeout=max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            said[part.name] = "started pid %d" % p.pid
            continue
        try:
            os.remove(os.path.join(part.folder, part.pidfile))
        except OSError:
            pass
        said[part.name] = "exited at once (code %d)" % code
        failed.append("%s exited at once (code %d) — see %s"
                      % (part.name, code, tilde(os.path.join(part.folder, part.log))))
    for part in parts(cfg):
        out("%-14s%s" % (part.name, said[part.name]))
    if failed:
        raise Fail(1, "; ".join(failed))
    return 0


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def stop_group(pid):
    """SIGTERM the process group, SIGKILL after 15 s."""
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 15
    while group_alive(pid) and time.monotonic() < deadline:
        time.sleep(0.1)
    if group_alive(pid):
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        end = time.monotonic() + 3
        while group_alive(pid) and time.monotonic() < end:
            time.sleep(0.05)


def cmd_orch_stop(cfg, a):
    """The dispatcher first, waited for: on SIGTERM it hands its unfinished tasks to
    the orchestrator's inbox. Then the orchestrator."""
    for part in parts(cfg):
        pid = part_pid(part)
        if not pid:
            out("%-14snot running" % part.name)
            continue
        stop_group(pid)
        try:
            os.remove(os.path.join(part.folder, part.pidfile))
        except OSError:
            pass
        out("%-14sstopped pid %d" % (part.name, pid))
    return 0


def cmd_orch_status(cfg, a):
    down = []
    for part in parts(cfg):
        pid = part_pid(part)
        if not pid:
            down.append(part.name)
            out("%-14sstopped" % part.name)
            continue
        try:
            since = hms(os.stat(os.path.join(part.folder, part.pidfile)).st_mtime)
        except OSError:
            since = "?"
        out("%-14srunning pid %d since %s" % (part.name, pid, since))
    ids, handed = open_tasks(cfg)
    out("open: " + (" ".join(ids) if ids else "none"))
    out("with the orchestrator: " + (" ".join(handed) if handed else "none"))
    if down:
        raise Fail(1, not_running(down))
    return 0


def cmd_orch_reply(cfg, a):
    if not TASK_RE.match(a.task):
        raise Fail(2, "task is T<n>, like T7")
    if a.status not in STATUSES:
        raise Fail(2, "status is progress, done or failed")
    text = " ".join(a.text)
    replies = os.path.join(cfg.orch, "replies.jsonl")
    closed = [r.get("status") for r in read_jsonl(replies)
              if r.get("id") == a.task and r.get("status") in ("done", "failed")]
    rc, o, e = feed_post(cfg, a, "ORCH", "%s %s" % (a.task, a.status), text)
    finish(rc, o, e)
    seq = o.decode("utf-8", "replace").strip()
    os.makedirs(cfg.orch, mode=0o700, exist_ok=True)
    append_line(replies, json.dumps({"id": a.task, "at": now_iso(), "status": a.status,
                                     "seq": int(seq) if seq.isdigit() else None}) + "\n")
    if closed and a.status in ("done", "failed"):
        warn("%s was already closed (%s) — posted again anyway" % (a.task, closed[0]))
    return 0


def cmd_orch(cfg, a):
    return {"start": cmd_orch_start, "stop": cmd_orch_stop, "status": cmd_orch_status,
            "send": cmd_orch_send, "hand": cmd_orch_hand, "reply": cmd_orch_reply}[a.op](cfg, a)


# --------------------------------------------------------------- scripts

def scripts_dir(cfg):
    return os.path.join(cfg.repo, "scripts")


def server_name(cfg):
    """VFG_SERVER: the server this PC drives, and the name of its folder under made/."""
    name = cfg.get("VFG_SERVER") or "main"
    if not NAME_RE.match(name):
        raise Fail(3, "not configured: VFG_SERVER must be a name (a-z, 0-9, _ and -, at most 48)")
    return name


def made_scripts_dir(cfg):
    return os.path.join(cfg.repo, "made", server_name(cfg), "scripts")


def load_library(cfg):
    """toolkit/lib/library.py, and the library and this server's folder read through it."""
    library = lib_module("library")
    return library, library.Library(cfg.repo, server_name(cfg))


def live_poll(cfg):
    raw = cfg.get("VFG_LIVE_POLL_S") or "0.5"
    try:
        v = float(raw)
    except ValueError:
        v = 0
    if not 0 < v <= 60:
        raise Fail(3, "not configured: VFG_LIVE_POLL_S must be seconds, more than 0")
    return v


def looks_like_script(folder):
    """main.py with a README.md beside it (written the old way), or a main.py that starts with its docstring."""
    main = os.path.join(folder, "main.py")
    if not os.path.isfile(main):
        return False
    if os.path.isfile(os.path.join(folder, "README.md")):
        return True
    try:
        with open(main, encoding="utf-8", errors="replace") as f:
            head = f.read(4096).lstrip()
    except OSError:
        return False
    return head[:1] in ("'", '"') or head[:2].lower() in ('r"', "r'", 'u"', "u'")


def script_problem(cfg, name, root=None):
    """Why <root>/<name> (scripts/ by default) is not a script, or None."""
    root = root or scripts_dir(cfg)
    folder = os.path.join(root, name)
    where = os.path.relpath(folder, cfg.repo)
    if not NAME_RE.match(name):
        return "%s is not a script name (a-z, 0-9, _ and -, at most 48)" % name
    if not os.path.isdir(folder):
        return "no %s/ in %s" % (where, tilde(cfg.repo))
    if not os.path.isfile(os.path.join(folder, "main.py")):
        return "%s/ has no main.py" % where
    if not looks_like_script(folder):
        return "%s/ has no README.md, and its main.py does not start with a docstring" % where
    return None


def tree(root, name):
    """What a deploy sends of <root>/<name>, in its order: (path in the tar, its os.stat, the
    file's bytes, or None for a folder); no caches, no dotfiles, no links."""
    for dirpath, dirnames, filenames in os.walk(os.path.join(root, name)):
        dirnames[:] = sorted(d for d in dirnames
                             if not d.startswith(".") and d != "__pycache__"
                             and not os.path.islink(os.path.join(dirpath, d)))
        rel = os.path.relpath(dirpath, root)
        yield rel, os.stat(dirpath), None
        for fn in sorted(filenames):
            path = os.path.join(dirpath, fn)
            if fn.startswith(".") or fn.endswith(".pyc") or os.path.islink(path) or not os.path.isfile(path):
                continue
            with open(path, "rb") as f:
                yield rel + "/" + fn, os.stat(path), f.read()


def stamp(entries):
    """A folder's stamp: the sha256 of its files' paths, exec bits and bytes as a deploy sends
    them (tree), not of the gzip. The box keeps it in the folder it deployed (.vfg-stamp)."""
    h = hashlib.sha256()
    for path, st, data in entries:
        if data is not None:
            h.update(b"%s\0%d\0%d\0" % (path.encode("utf-8"), bool(st.st_mode & 0o111), len(data)))
            h.update(data)
    return h.hexdigest()


def pack(cfg, names, root=None):
    """The folders as a gzipped tar in memory, base64, and each one's stamp, from the same bytes:
    (tar, {name: stamp})."""
    root = root or scripts_dir(cfg)
    buf = io.BytesIO()
    stamps = {}
    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
        for name in names:
            entries = list(tree(root, name))
            stamps[name] = stamp(entries)
            for path, st, data in entries:
                ti = tarfile.TarInfo(path)
                ti.mode, ti.mtime = stat.S_IMODE(st.st_mode), int(st.st_mtime)
                if data is None:
                    ti.type = tarfile.DIRTYPE
                    tf.addfile(ti)
                else:
                    ti.size = len(data)
                    tf.addfile(ti, io.BytesIO(data))
    data = buf.getvalue()
    if len(data) > DEPLOY_MAX:
        raise Fail(1, "the scripts pack to %d MB; at most 20 MB" % (len(data) // (1024 * 1024)))
    return base64.b64encode(data).decode("ascii"), stamps


def with_lib(cfg, names):
    lib = os.path.join(scripts_dir(cfg), "_lib")
    return (["_lib"] if os.path.isdir(lib) else []) + list(names)


def made_root(cfg):
    """made/<server>/scripts as the box names it, below /opt/vfg."""
    return "made/%s/scripts" % server_name(cfg)


def deployed(cfg, source, names):
    """What one deploy sends, as (the box's root, the folder here, names): _lib/ (with kit/) and
    library scripts into scripts/, made scripts into made/<server>/scripts/."""
    if source == "made":
        lib = [("scripts", scripts_dir(cfg), with_lib(cfg, []))] if with_lib(cfg, []) else []
        return lib + [(made_root(cfg), made_scripts_dir(cfg), list(names))]
    return [("scripts", scripts_dir(cfg), with_lib(cfg, names))]


def tars_for(cfg, source, names):
    """The deploy itself: [{"root", "tar", "stamps"}]."""
    out = []
    for root, here, folders in deployed(cfg, source, names):
        tar, stamps = pack(cfg, folders, here)
        out.append({"root": root, "tar": tar, "stamps": stamps})
    return out


def stamps_for(cfg, source, names):
    """What the box checks before it starts a copy with no deploy: [{"root", "stamps"}], the
    stamps of what tars_for would send, read from the files, never packed."""
    return [{"root": root, "stamps": dict((n, stamp(tree(here, n))) for n in folders)}
            for root, here, folders in deployed(cfg, source, names)]


def scan_scripts(cfg, root):
    names, skipped = [], []
    try:
        listing = sorted(os.listdir(root))
    except OSError:
        return names, skipped
    for name in listing:
        if name.startswith((".", "_")) or not os.path.isdir(os.path.join(root, name)):
            continue
        if script_problem(cfg, name, root):
            skipped.append(os.path.relpath(os.path.join(root, name), scripts_dir(cfg))
                           if root == scripts_dir(cfg) else os.path.relpath(os.path.join(root, name), cfg.repo))
        else:
            names.append(name)
    return names, skipped


def cmd_script_deploy(cfg, a):
    root = scripts_dir(cfg)
    if not os.path.isdir(root):
        raise Fail(1, "no scripts folder at %s" % tilde(root))
    made = made_scripts_dir(cfg)
    skipped, lib_names, made_names = [], [], []
    if a.name:
        if not NAME_RE.match(a.name):
            raise Fail(2, "%s is not a script name" % a.name)
        if not os.path.isdir(os.path.join(root, a.name)) and os.path.isdir(os.path.join(made, a.name)):
            why = script_problem(cfg, a.name, made)
            made_names = [a.name]
        else:
            why = script_problem(cfg, a.name)
            lib_names = [a.name]
        if why:
            raise Fail(1, why)
    else:
        lib_names, skipped = scan_scripts(cfg, root)
        made_names, skipped_made = scan_scripts(cfg, made)
        skipped += skipped_made
    tar, stamps = pack(cfg, with_lib(cfg, lib_names))
    tars = [{"root": "scripts", "tar": tar, "stamps": stamps}]
    if made_names:
        tar, stamps = pack(cfg, made_names, made)
        tars.append({"root": made_root(cfg), "tar": tar, "stamps": stamps})
    rc, o, e = remote(cfg, a, "scripts.py", {"op": "deploy", "tars": tars}, 30, libs=SCRIPTS_LIBS)
    finish(rc, o, e)
    if skipped:
        raise Fail(1, "skipped, not scripts (a script is <name>/main.py starting with its docstring, "
                      "or with a README.md): %s" % ", ".join(skipped))
    return 0


def remote_json(cfg, a, args, timeout=30):
    """A remote op that answers one JSON line, last; anything printed before it is passed on,
    and failures pass through as they are."""
    rc, o, e = remote(cfg, a, "scripts.py", args, timeout, libs=SCRIPTS_LIBS)
    if rc != 0:
        finish(rc, o, e)
    lines = o.decode("utf-8", "replace").rstrip("\n").split("\n")
    try:
        got = json.loads(lines[-1])
    except ValueError:
        raise Fail(1, "scripts.py answered something that is not JSON")
    if len(lines) > 1:
        out("\n".join(lines[:-1]))
    return got


# ------------------------------------------------------------------ actions

# What remote/scripts.py imports: scripts/_lib/instances.py, the code that starts, stops and
# edits a copy, which the box's stop and edit scripts import from the deployed kit too.
SCRIPTS_LIBS = ("instances.py",)
COPY_RE = re.compile(r"^[a-z0-9][a-z0-9_]{0,47}$")
KEY_RE = re.compile(r"^[a-z_][a-z0-9_]{0,47}$")
CHECK_S = 2.0          # an until-stopped copy answers with its first result() or after this check
ACTION_TIMEOUT = 20.0  # VFG_DISPATCH_ACTION_TIMEOUT_S's default: how long a once action is waited for
LIB_PY = os.path.join(os.path.dirname(HERE), "lib", "py")
_CATALOG = {}


def actions_lib():
    """lib/py/vfg_actions.py, the one loader of the actions, imported on first use."""
    if LIB_PY not in sys.path:
        sys.path.insert(0, LIB_PY)
    import logging
    import warnings
    # An action's field may be named as a BaseModel attribute (edit's and stop's `copy`); and an
    # action left out is said by the command that cares (vfg action list, check), not logged.
    warnings.filterwarnings("ignore", message=r'Field name ".*" in ".*" shadows an attribute in parent')
    logging.getLogger("vfg_actions").addHandler(logging.NullHandler())
    logging.getLogger("vfg_actions").propagate = False
    try:
        import vfg_actions
    except ImportError as e:
        raise Fail(3, "not configured: cannot load lib/py/vfg_actions.py (%s): run vfg as it is, "
                      "under uv" % e)
    return vfg_actions


def catalog(cfg):
    """(vfg_actions, the Catalog of the library's actions and this server's), loaded once per run."""
    va = actions_lib()
    key = (cfg.repo, server_name(cfg))
    if key not in _CATALOG:
        _CATALOG[key] = va.Catalog(cfg.repo, server_name(cfg))
    return va, _CATALOG[key]


def action_class(cfg, name):
    """(vfg_actions, the catalog, the action's class), or Fail 1 saying why there is none."""
    va, cat = catalog(cfg)
    cls = cat.get(name)
    if cls is None:
        why = cat.errors().get(name)
        if why:
            raise Fail(1, "action %s did not load: %s" % (name, why))
        raise Fail(1, "no action %s in actions/ or made/%s/actions/ — vfg action list" % (name, server_name(cfg)))
    return va, cat, cls


def action_timeout(cfg):
    raw = cfg.get("VFG_DISPATCH_ACTION_TIMEOUT_S")
    try:
        v = float(raw) if raw else ACTION_TIMEOUT
    except ValueError:
        v = -1
    if not v > 0:
        raise Fail(3, "not configured: VFG_DISPATCH_ACTION_TIMEOUT_S must be seconds, more than 0")
    return v


def script_home(cfg, source, script):
    """Where an action's script is: "made" (made/<server>/scripts/, for a made action, first)
    or "library" (scripts/)."""
    if source == "made" and os.path.isfile(os.path.join(made_scripts_dir(cfg), script, "main.py")):
        return "made"
    if os.path.isfile(os.path.join(scripts_dir(cfg), script, "main.py")):
        return "library"
    raise Fail(1, "its script %s is in neither scripts/ nor made/%s/scripts/" % (script, server_name(cfg)))


def with_places(cfg, a, check):
    """check(places): first with none, which checks everything but whether a saved place
    exists; then with the saved places from the cache, and, when that fails on no cache or one
    older than VFG_PLACES_TTL_S, once more with places fetched now, for a place saved since. A
    ValueError is the check's refusal: exit 2."""
    try:
        check(None)
    except ValueError as e:
        raise Fail(2, str(e))
    cached = read_places_cache(cfg)
    try:
        return check(cached[0] if cached is not None else {})
    except ValueError as e:
        if cached is not None and cached[1] < places_ttl(cfg):
            raise Fail(2, str(e))
        why = e
    try:
        fresh = fetch_places(cfg, a)
    except Fail:
        raise Fail(2, str(why))
    try:
        return check(fresh)
    except ValueError as e:
        raise Fail(2, str(e))


def checked_values(cfg, a, va, cls, given):
    """vfg_actions.check_values, with the saved places: an unknown key, a fixed one or a value
    its field refuses is exit 2."""
    return with_places(cfg, a, lambda places: va.check_values(cls, given, places=places))


def start_copy(cfg, a, name, cls, source, values, live, task, as_=None):
    """Start a copy on the box and wait as its runs says, in one SSH call when the box has the
    action's script and _lib as they are here: the call sends their stamps (stamps_for), and
    the box starts the copy when its own match. When one does not, the box answers that it needs
    them, and a second call sends them (tars_for) with the run. The box's answer: {"copy",
    "pid", "started", "running", "code", "result", "error", "tail"}."""
    owner = cfg.get("VFG_OWNER")
    if owner and not PLAYER_RE.match(owner):
        raise Fail(3, "not configured: VFG_OWNER must be a Minecraft name")
    runs = getattr(cls, "runs", "until_stopped")
    if runs == "once":
        wait = getattr(cls, "timeout_s", None) or action_timeout(cfg)
    else:
        wait = CHECK_S
    script = cls.script
    home = script_home(cfg, source, script)
    args = {"op": "run", "action": name, "script": script, "source": home, "server": server_name(cfg),
            "values": values, "live": live, "runs": runs, "task": task, "as": as_,
            "stamps": stamps_for(cfg, home, [script]), "owner": owner, "poll": live_poll(cfg),
            "wait": wait, "on_result": runs != "once"}
    timeout = a.timeout if getattr(a, "timeout", None) is not None else wait + 30
    deadline = time.monotonic() + timeout

    def call(args):
        try:
            rc, o, e = Ssh(cfg).call(program("scripts.py", dict(args, vfg=cfg.rvfg, mc=cfg.rmc), SCRIPTS_LIBS),
                                     max(0.1, deadline - time.monotonic()), keep_master=True)
        except TimedOut:
            raise Fail(124, "timed out: %s did not answer within %s s; it may still have happened"
                       % (name, fmt_s(timeout)))
        if rc != 0:
            finish(rc, o, e)
        lines = o.decode("utf-8", "replace").rstrip("\n").split("\n")
        try:
            return json.loads(lines[-1])
        except ValueError:
            raise Fail(1, "scripts.py answered something that is not JSON")

    got = call(args)
    if got.get("needs") == "tars":   # nothing was started: the box has another _lib or script
        args.pop("stamps")
        got = call(dict(args, tars=tars_for(cfg, home, [script])))
    got["runs"] = runs
    return got


def answer_of(name, got, notes):
    """The one JSON line vfg action run prints, from the box's answer."""
    copy = got["copy"]
    res = got.get("result") or {}
    facts = res.get("facts") if isinstance(res.get("facts"), dict) else {}
    line = {"ok": True, "copy": copy, "action": name, "running": bool(got["running"]),
            "summary": res.get("summary") or "", "facts": facts, "notes": list(notes)}
    if got["running"]:
        if got["runs"] == "once":  # what it said so far (a countdown started), and that it goes on
            line["summary"] = "; ".join(x for x in (line["summary"], "still running as %s" % copy) if x)
        elif not line["summary"]:
            line["summary"] = "running as %s" % copy
    elif got.get("code"):
        # What it failed with: the error it crashed on (mc.py's <copy>.error), else the result()
        # a script that refused gave before its non-zero exit, else the last line it printed.
        tail = [l for l in got.get("tail") or [] if l.strip()]
        said = got.get("error") or res.get("summary") or (tail[-1].strip() if tail else "")
        line["ok"] = False
        line["error"] = "%s exited with code %d%s" % (copy, got["code"], ": " + said if said else "")
    elif not line["summary"]:
        line["summary"] = "%s ran and ended" % copy
    return line


def run_action(cfg, a, name, given, as_=None, task=None, extra=None):
    """Check the values here, run the action on EC2, write the copy through to running.json:
    the JSON line's dict. Fail for anything that stopped it before it ran. `extra` goes into
    the copy's values as it is, checked already (an edit's values, against its copy's action)."""
    cfg.require_ssh()
    va, cat, cls = action_class(cfg, name)
    checked = checked_values(cfg, a, va, cls, given)
    values = dict(checked.values)
    values.update(extra or {})
    got = start_copy(cfg, a, name, cls, cat.source(name), values, list(checked.live), task, as_)
    line = answer_of(name, got, checked.notes)
    if got["running"]:
        note_copy(cfg, got["copy"], {"action": name, "script": cls.script, "values": values,
                                     "live": list(checked.live), "task": task, "started": got.get("started"),
                                     "runs": got["runs"]})
    else:
        note_copy(cfg, got["copy"], None)
    return line


def edit_words(given):
    """`copy=<name>` and the values to change, as key=value words or as values=<a JSON object>."""
    copy = given.pop("copy", None)
    vals = given.pop("values", None)
    changes = {}
    if vals is not None:
        if isinstance(vals, str):
            try:
                vals = json.loads(vals)
            except ValueError:
                raise Fail(2, "values= is a JSON object of the values to change")
        if not isinstance(vals, dict):
            raise Fail(2, "values= is a JSON object of the values to change")
        changes.update(vals)
    changes.update(given)
    if not copy:
        raise Fail(2, "which copy? edit copy=<name> key=value … — vfg script list")
    return copy, changes


def run_edit(cfg, a, copy, given, task=None):
    """The edit action: the values checked here (check_edit) against the action the copy runs
    and its values now, from running.json; then the `edit` action runs, its script getting
    {"copy", "values": the full new set, "changed", "live_only"}."""
    if not COPY_RE.match(copy) and not NAME_RE.match(copy):
        raise Fail(2, "%s is not a copy's name" % copy)
    if not given:
        raise Fail(2, "nothing to change: %s key=value …" % copy)
    entry = known_copy(cfg, a, copy)
    va, cat, cls = action_class(cfg, entry["action"])
    try:
        ed = with_places(cfg, a, lambda places: va.check_edit(cls, entry.get("values") or {}, given,
                                                              places=places))
    except Fail as f:
        raise Fail(f.code, "%s (%s): %s" % (copy, entry["action"], f.msg))
    if not ed.changed:
        return {"ok": True, "copy": copy, "action": "edit", "running": True,
                "summary": "%s: nothing changed" % copy, "facts": {"copy": copy, "changed": []},
                "notes": list(ed.notes)}
    line = run_action(cfg, a, "edit", {"copy": copy}, task=task,
                      extra={"values": ed.values, "changed": list(ed.changed), "live_only": bool(ed.live_only)})
    line["notes"] = list(ed.notes) + line["notes"]
    if line["ok"]:
        entry = dict(entry, values=ed.values)
        note_copy(cfg, copy, dict((k, entry.get(k)) for k in RUNNING_KEYS))
    return line


def run_stop(cfg, a, copy, as_=None, task=None):
    """The stop action: the copy ends and what carries its tag goes. It leaves running.json when
    the stop ran, or when the box says nothing runs under that name (the stop script's fact
    was_running false); a stop that failed otherwise (refused a permission) leaves it there, as
    the copy may run still."""
    line = run_action(cfg, a, "stop", {"copy": copy}, as_, task)
    if line["ok"] or line["facts"].get("was_running") is False:
        note_copy(cfg, copy, None)
    return line


def known_copy(cfg, a, copy):
    """What this PC knows of a running copy (running.json), else what the box says of it."""
    got = read_running(cfg)
    entry = (got or {}).get("copies", {}).get(copy)
    if isinstance(entry, dict) and entry.get("action"):
        return entry
    try:
        info = remote_json(cfg, a, {"op": "info", "copy": copy})
    except Fail as f:
        if f.code != 1:
            raise
        info = {}
    if not info.get("pid"):
        note_copy(cfg, copy, None)
        raise Fail(1, "%s is not running — vfg script list" % copy)
    return info


def action_words(words):
    """`<action> key=value … [as=<name>] [--task T7]`, in any order: (action, given, as, task)."""
    if words[:1] == ["--"]:
        words = words[1:]
    name, given, as_, task = None, {}, None, None
    i = 0
    while i < len(words):
        w = words[i]
        if w == "--task":
            if i + 1 >= len(words):
                raise Fail(2, "--task takes the task, like --task T7")
            task = words[i + 1]
            i += 2
            continue
        if w.startswith("--task="):
            task = w[len("--task="):]
        elif name is None and "=" not in w:
            name = w
        elif "=" in w:
            k, v = w.split("=", 1)
            if k == "as":
                as_ = v
            elif not KEY_RE.match(k):
                raise Fail(2, "%r is not key=value" % w)
            elif k in given:
                raise Fail(2, "%s is given twice" % k)
            else:
                given[k] = v
        else:
            raise Fail(2, "%r is not key=value" % w)
        i += 1
    if name is None:
        raise Fail(2, "which action? vfg action run <action> key=value … [as=<name>] [--task T7]")
    if not NAME_RE.match(name):
        raise Fail(2, "%s is not an action name" % name)
    if task is not None and not TASK_RE.match(task):
        raise Fail(2, "--task is T<n>, like T7")
    if as_ is not None and not COPY_RE.match(as_):
        raise Fail(2, "as=%s is not a copy name (a-z, 0-9 and _, at most 48)" % as_)
    check_home(given.values())
    return name, given, as_, task


def run_named(cfg, a, name, given, as_=None, task=None):
    """Any action, as vfg action run and its shortcuts run it: edit through run_edit and stop
    through run_stop, which write the copy they name through to running.json; the rest
    through run_action."""
    if name == "edit":
        copy, changes = edit_words(given)
        return run_edit(cfg, a, copy, changes, task)
    if name == "stop" and set(given) == {"copy"} and isinstance(given["copy"], str):
        return run_stop(cfg, a, given["copy"], as_, task)
    return run_action(cfg, a, name, given, as_, task)


def cmd_action_run(cfg, a):
    """vfg action run: ONE JSON line, whatever happens; exit 0 when ok."""
    name, task = None, None
    try:
        name, given, as_, task = action_words(list(a.rest))
        line = run_named(cfg, a, name, given, as_, task)
    except Fail as f:
        out(json.dumps({"ok": False, "copy": "", "action": name or "", "running": False, "summary": "",
                        "facts": {}, "notes": [], "error": f.msg or "failed"}, ensure_ascii=False))
        raise
    out(json.dumps(line, ensure_ascii=False))
    if not line["ok"]:
        raise Fail(1, line.get("error") or "failed")
    return 0


def cmd_action_list(cfg, a):
    va, cat = catalog(cfg)
    if a.json:
        out(json.dumps(va.cache(cfg.repo, server_name(cfg), cfg.home, catalog=cat), ensure_ascii=False))
        return 0
    lines = []
    for name in cat.names():
        line = va.menu_line(name, cat.get(name))
        lines.append(line + (" (made)" if cat.source(name) == "made" else ""))
    out("\n".join(lines) if lines else "none")
    for stem, why in sorted(cat.errors().items()):
        warn("%s did not load, left out: %s" % (stem, why))
    return 0


def action_rel(cfg, cat, name):
    """An action's file, from the repo: actions/railgun.py, made/main/actions/tnt_crouch.py."""
    try:
        return os.path.relpath(str(cat.file(name)), cfg.repo)
    except KeyError:
        return "%s.py" % name


def cmd_action_check(cfg, a):
    va, cat = catalog(cfg)
    if cat.get(a.name) is None:
        why = cat.errors().get(a.name)
        if why:
            out("%s: %s" % (a.name, why))
            raise Fail(1, "%s is left out: it does not load or does not pass" % a.name)
        raise Fail(1, "no action %s in actions/ or made/%s/actions/" % (a.name, server_name(cfg)))
    problems = va.check_action(a.name, cat.get(a.name))
    if problems:
        out("\n".join("%s: %s" % (action_rel(cfg, cat, a.name), p) for p in problems))
        raise Fail(1, "%d problem%s in %s" % (len(problems), "" if len(problems) == 1 else "s", a.name))
    out("ok: " + action_rel(cfg, cat, a.name))
    return 0


# ---------------------------------------------------------- running copies

# What runs, cached on this PC for everyone who asks (the dispatcher, the orchestrator's brief
# hook, implementers, the conversation): $VFG_HOME/running.json, {"fetched_at": <epoch s>,
# "copies": {copy: {"action", "script", "values", "live", "task", "started", "runs"}}}, written
# atomically under running.lock. Every run, edit and stop through vfg writes through; `vfg
# script list --fresh` fetches it from EC2, which drops a copy that ended by itself.
RUNNING_KEYS = ("action", "script", "values", "live", "task", "started", "runs")


def running_path(cfg):
    return os.path.join(cfg.home, "running.json")


def read_running(cfg):
    try:
        with open(running_path(cfg), encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data.get("copies"), dict):
            return data
    except (OSError, ValueError, AttributeError):
        pass
    return None


def write_running(cfg, copies, fetched_at):
    cfg.ensure_home()
    atomic_write(running_path(cfg), json.dumps({"fetched_at": fetched_at, "copies": copies},
                                               ensure_ascii=False) + "\n")


def note_copy(cfg, copy, entry):
    """Write one copy through to running.json (entry None: it ended or was stopped)."""
    try:
        cfg.ensure_home()
        with flocked(os.path.join(cfg.home, "running.lock")):
            data = read_running(cfg) or {"fetched_at": 0, "copies": {}}
            copies = dict(data["copies"])
            if entry is None:
                copies.pop(copy, None)
            else:
                copies[copy] = entry
            write_running(cfg, copies, data.get("fetched_at") or 0)
    except OSError as e:
        warn("running.json not written: %s" % e)


def entry_of(c):
    """A copy as the box reports it, as running.json keeps it."""
    return {"action": c.get("action"), "script": c.get("script"), "values": c.get("values") or {},
            "live": c.get("live") or [], "task": c.get("task"), "started": c.get("started"),
            "runs": c.get("runs")}


def store_fetched(cfg, rows, asked_at):
    """The box's running copies as running.json; a copy written through after the fetch was
    asked for (started meanwhile) is kept."""
    fresh = dict((c["copy"], entry_of(c)) for c in rows if c.get("copy"))
    cfg.ensure_home()
    with flocked(os.path.join(cfg.home, "running.lock")):
        cur = read_running(cfg)
        for name, e in ((cur or {}).get("copies") or {}).items():
            if name not in fresh and isinstance(e, dict) and (e.get("started") or "") > asked_at:
                fresh[name] = e
        write_running(cfg, fresh, time.time())
    return fresh


def fetch_running(cfg, a):
    asked_at = now_iso()
    rows = remote_json(cfg, a, {"op": "copies"})
    return store_fetched(cfg, rows, asked_at)


def baselines(cfg):
    """{action: its values when nothing is given}: the field defaults, then its defaults and
    fixed, from the actions cache; {} when the cache cannot be had."""
    try:
        va, cat = catalog(cfg)
        acts = va.cache(cfg.repo, server_name(cfg), cfg.home, catalog=cat).get("actions") or {}
    except Fail:
        return {}
    out_ = {}
    for name, info in acts.items():
        base = dict((f, d.get("default")) for f, d in (info.get("fields") or {}).items())
        base.update(info.get("defaults") or {})
        base.update(info.get("fixed") or {})
        out_[name] = base
    return out_


def differs(base, values):
    return dict((k, v) for k, v in (values or {}).items() if k not in base or base[k] != v)


def show_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, float) and v.is_integer() and abs(v) < 1e15:
        return "%d" % v
    if isinstance(v, (list, dict)):
        return json.dumps(v, ensure_ascii=False, separators=(",", ":"))
    return "%s" % (v,)


def copy_line(name, e, base):
    """`galick_gun_2 — galick_gun, T7, player=Alex cooldown=0`: the action when it is not the
    copy's own name, the task, and the values that differ from the action's."""
    bits = []
    if e.get("action") and e.get("action") != name:
        bits.append(e["action"])
    if e.get("task"):
        bits.append(e["task"])
    changed = differs(base.get(e.get("action"), {}), e.get("values"))
    if changed:
        bits.append(" ".join("%s=%s" % (k, show_value(v)) for k, v in changed.items()))
    return name + (" — " + ", ".join(bits) if bits else "")


def cmd_script_list(cfg, a):
    data = read_running(cfg)
    if a.fresh or data is None or not data.get("fetched_at"):
        fetch_running(cfg, a)
        data = read_running(cfg) or {"fetched_at": time.time(), "copies": {}}
    if a.json:
        out(json.dumps(data, ensure_ascii=False))
        return 0
    base = baselines(cfg)
    copies = data["copies"]
    out("\n".join(copy_line(n, copies[n], base) for n in sorted(copies)) if copies else "nothing running")
    return 0


def cmd_script_set(cfg, a):
    """vfg script set <copy> k=v …: the edit action."""
    check_home(a.values)
    given = {}
    for w in a.values:
        k, eq, v = w.partition("=")
        if not eq or not KEY_RE.match(k):
            raise Fail(2, "%r is not key=value" % w)
        if k in given:
            raise Fail(2, "%s is given twice" % k)
        given[k] = v
    line = run_named(cfg, a, "edit", {"copy": a.copy, "values": given})
    for note in line["notes"]:
        out(note)
    if not line["ok"]:
        raise Fail(1, line.get("error") or "the edit failed")
    out(line["summary"])
    return 0


def cmd_script_stop(cfg, a):
    """vfg script stop <copy>: the stop action."""
    if not NAME_RE.match(a.name):
        raise Fail(2, "%s is not a copy's name" % a.name)
    line = run_named(cfg, a, "stop", {"copy": a.name})
    if not line["ok"]:
        raise Fail(1, line.get("error") or "the stop failed")
    out(line["summary"])
    return 0


def copy_script(src_folder, dest, text):
    """src_folder (or nothing) copied to dest, its main.py replaced by text; all or nothing."""
    import shutil
    parent = os.path.dirname(dest)
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, ".%s.new-%d" % (os.path.basename(dest), os.getpid()))
    shutil.rmtree(tmp, ignore_errors=True)
    try:
        if src_folder:
            shutil.copytree(src_folder, tmp, ignore=shutil.ignore_patterns("__pycache__", ".*", "*.pyc"))
        else:
            os.makedirs(tmp)
        with open(os.path.join(tmp, "main.py"), "w", encoding="utf-8") as f:
            f.write(text)
        os.rename(tmp, dest)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


ACTION_NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,47}$")


def actions_over(cfg, cat, item):
    """The names of the actions that run a script: for a made script, this server's; for a
    library one, the library's."""
    return [n for n in cat.names() if getattr(cat.get(n), "script", None) == item.name
            and cat.source(n) == item.source]


def todo_problems(cfg, cat, name):
    """An action vfg script new wrote and nobody finished: its line or a description still a TODO."""
    cls = cat.get(name)
    rel = action_rel(cfg, cat, name)
    out_ = []
    doc = (cls.__doc__ or "").strip().split("\n", 1)[0]
    if doc.upper().startswith("TODO"):
        out_.append("%s: its line on the menu is still a TODO: say what it does, in players' words" % rel)
    for k, f in cls.model_fields.items():
        if (f.description or "").strip().upper().startswith("TODO"):
            out_.append("%s: %s's description is still a TODO" % (rel, k))
    return out_


def script_problems(cfg, library, lib, va, cat, item):
    """vfg script check of one script or preset: library.check, with a script's reads checked
    against its actions' fields, and each action over it as vfg action check sees it, with its
    TODOs; a preset's values class loaded as an action inheriting it would load it. A made
    script with no action is a problem."""
    if item.kind != "script":
        return library.check(item, lib) + preset_class_problems(library, va, item)
    names = actions_over(cfg, cat, item)
    fields = None
    if names:
        fields = set()
        for n in names:
            fields.update(cat.get(n).model_fields)
    problems = library.check(item, lib, fields)
    for n in names:
        problems += todo_problems(cfg, cat, n)
    why = cat.errors().get(item.name)
    if why:
        where = "made/%s/actions/%s.py" % (lib.server, item.name) if item.source == "made" else "actions/%s.py" % item.name
        problems.append("%s: left out: %s" % (where, why))
    return problems


def preset_class_problems(library, va, item):
    """A preset's values class as the PC reads it (actions/_types.py's preset()): it loads, and
    each field's type is one of _types.py's."""
    if item.problem or library.values_class_fields(item) is None:
        return []
    from pathlib import Path
    T = va._types()
    try:
        cls = T._preset_class(Path(item.path), item.name)
    except Exception as e:  # noqa: BLE001 — whatever stops it loading is the problem
        return ["%s: its values class does not load: %s: %s" % (item.rel, type(e).__name__, e)]
    out = []
    for key, f in cls.model_fields.items():
        why = T.type_problem(f.annotation, f.metadata)
        if why:
            out.append("%s: %s: %s" % (item.rel, key, why))
    return out


def report_check(cfg, library, lib, path, kind, name, source):
    """Run check on what was just written (and its action); print its problems. True when it passes."""
    item = library.parse(path, kind, name, source, os.path.relpath(path, lib.repo))
    va, cat = catalog(cfg)
    cat.refresh()
    problems = script_problems(cfg, library, lib, va, cat, item)
    if problems:
        out("check: %d to fix before it is done:" % len(problems))
        out("\n".join("  " + p for p in problems))
    else:
        out("check: ok")
    return not problems


def new_action(cfg, library, lib, cat, name, src, presets):
    """The source of the action beside a new script: the values class of every preset the
    script holds, inherited; every other field, and its takes, runs, defaults and fixed, from
    the source script's action; with no source (or none over it), a player. (text, the
    presets inherited)."""
    held = list(src.holds if src else []) + [p.name for p in presets if p.name not in (src.holds if src else [])]
    inherit, inherited = [], set()
    for p in held:
        it = lib.preset(p)
        keys = library.values_class_fields(it) if it is not None else None
        if keys is not None:
            inherit.append(p)
            inherited.update(keys)
    base = None
    if src is not None:
        over = actions_over(cfg, cat, src)
        if over:
            pick = src.name if src.name in over else over[0]
            base = va_cache_entry(cfg, cat, pick)
    if base is not None:
        fields = [(k, f) for k, f in base["fields"].items() if k not in inherited]
    else:
        fields = [f for f in library.SKELETON_FIELDS if f[0] not in inherited]
    known = set(k for k, _f in fields) | inherited
    takes = [k for k in (base or {}).get("takes", []) if k in known] if base else \
        (["player"] if "player" in known else [])
    keep = lambda d: dict((k, v) for k, v in (d or {}).items() if k in known)  # noqa: E731
    return library.action_text(name, name, inherit, fields, runs=(base or {}).get("runs") or "until_stopped",
                               takes=takes, defaults=keep((base or {}).get("defaults")),
                               fixed=keep((base or {}).get("fixed"))), inherit


def va_cache_entry(cfg, cat, name):
    """One action as actions.json holds it (vfg_actions.entry)."""
    va = actions_lib()
    return va.entry(name, cat.get(name), cat.source(name), action_rel(cfg, cat, name))


def cmd_script_new(cfg, a):
    """A new script, a copy of --from (or an empty one) with each --preset copied in, and its
    action beside it."""
    if not ACTION_NAME_RE.match(a.name):
        raise Fail(2, "%s is not a name for a script and its action (a-z, 0-9 and _, starting with a "
                      "letter, at most 48)" % a.name)
    library, lib = load_library(cfg)
    taken = lib.taken(a.name, "script")
    if taken:
        raise Fail(1, "%s is taken: %s — pick another name" % (a.name, taken))
    actions_dir = os.path.join(cfg.repo, "actions") if a.library else os.path.join(cfg.repo, "made", lib.server, "actions")
    for d in (os.path.join(cfg.repo, "actions"), os.path.join(cfg.repo, "made", lib.server, "actions")):
        if os.path.exists(os.path.join(d, a.name + ".py")):
            raise Fail(1, "%s is taken: %s — pick another name"
                       % (a.name, os.path.relpath(os.path.join(d, a.name + ".py"), cfg.repo)))
    presets = []
    for p in a.preset or []:
        it = lib.preset(p)
        if it is None:
            raise Fail(1, "no preset %s in scripts/_presets/ or made/%s/presets/" % (p, lib.server))
        if it.problem:
            raise Fail(1, "%s: %s" % (it.rel, it.problem))
        if any(x.name == p for x in presets):
            raise Fail(2, "--preset %s is given twice" % p)
        presets.append(it)
    src = None
    if a.source:
        src = lib.script(a.source)
        if src is None:
            raise Fail(1, "no script %s in scripts/ or made/%s/scripts/" % (a.source, lib.server))
        if src.problem:
            raise Fail(1, "%s: %s" % (src.rel, src.problem))
        text = src.text
    else:
        text = library.SKELETON
    added = []
    for p in presets:
        try:
            text, keys, imports = library.add_preset(text, p, lib.server)
        except ValueError as e:
            raise Fail(1, "cannot copy %s in: %s" % (p.name, e))
        added.append((p, keys, imports))
    va, cat = catalog(cfg)
    action, inherit = new_action(cfg, library, lib, cat, a.name, src, presets)
    dest = os.path.join(scripts_dir(cfg) if a.library else lib.made_scripts, a.name)
    copy_script(src.folder if src else None, dest, text)
    os.makedirs(actions_dir, exist_ok=True)
    action_path = os.path.join(actions_dir, a.name + ".py")
    atomic_write(action_path, action, 0o644)
    rel = os.path.relpath(dest, cfg.repo)
    out("made %s/ %s" % (rel, "from %s/ (%s)" % (os.path.dirname(src.rel), src.source) if src
                          else "from nothing"))
    for p, keys, imports in added:
        out("  + %s (%s): %s" % (p.name, p.source, ", ".join(keys) if keys else "no values"))
    out("made %s: class %s(%s)" % (os.path.relpath(action_path, cfg.repo), library.camel(a.name),
                                   ", ".join(["Action"] + ['preset("%s")' % p for p in inherit])))
    report_check(cfg, library, lib, os.path.join(dest, "main.py"), "script", a.name,
                 "library" if a.library else "made")
    out("next: edit its first line, ASKS and the wiring; the action's line, takes and descriptions; "
        "then vfg script check %s" % a.name)
    return 0


def check_targets(cfg, library, lib, target):
    """Items for one `vfg script check` argument: a name (script, preset or both) or a path."""
    found = []
    if NAME_RE.match(target) and "/" not in target:
        for it in (lib.script(target), lib.preset(target)):
            if it is not None:
                found.append(it)
        if found:
            return found
    path = os.path.abspath(target)
    if os.path.isdir(path):
        path = os.path.join(path, "main.py")
    if not os.path.isfile(path):
        raise Fail(1, "no script or preset %s (a name, a script's folder or a .py)" % target)
    rel = os.path.relpath(path, cfg.repo)
    rel = path if rel.startswith("..") else rel
    source = "made" if rel.startswith("made/") else "library"
    parent = os.path.basename(os.path.dirname(path))
    if os.path.basename(path) == "main.py":
        return [library.parse(path, "script", parent, source, rel)]
    if parent in ("_presets", "presets"):
        return [library.parse(path, "preset", None, source, rel)]
    it = library.parse(path, "script", os.path.splitext(os.path.basename(path))[0], source, rel)
    if it.asks is None and not it.problem:
        it = library.parse(path, "preset", None, source, rel)
    return [it]


def cmd_script_check(cfg, a):
    """Scripts and presets (library.check), each script's actions with them; with no target,
    every one, and every action the loader left out."""
    library, lib = load_library(cfg)
    va, cat = catalog(cfg)
    if a.targets:
        items = []
        for t in a.targets:
            items.extend(check_targets(cfg, library, lib, t))
    else:
        items = lib.scripts() + lib.presets()
    problems, bad = [], 0
    for it in items:
        got = script_problems(cfg, library, lib, va, cat, it)
        problems.extend(got)
        bad += 1 if got else 0
    if not a.targets:
        scripts_ = set(i.name for i in items if i.kind == "script")
        for stem, why in sorted(cat.errors().items()):
            if stem not in scripts_:
                problems.append("%s.py: left out: %s" % (stem, why))
                bad += 1
    if problems:
        out("\n".join(problems))
        raise Fail(1, "%d problem%s in %d of %d file%s" % (len(problems), "" if len(problems) == 1 else "s",
                                                           bad, len(items), "" if len(items) == 1 else "s"))
    scripts = [i for i in items if i.kind == "script"]
    presets = [i for i in items if i.kind == "preset"]
    if a.targets and len(items) <= 3:
        out("ok: " + ", ".join(i.rel for i in items))
    else:
        out("ok: %d script%s and %d preset%s" % (len(scripts), "" if len(scripts) == 1 else "s",
                                                len(presets), "" if len(presets) == 1 else "s"))
    return 0


def cmd_script_save(cfg, a):
    """A running copy's values kept as an action of their own, made/<server>/actions/<new_name>.py
    over the copy's script, with the values it runs with now as its defaults: a variant of a
    library action; a made action's fields written out (made actions do not import each other)."""
    if not COPY_RE.match(a.copy) and not NAME_RE.match(a.copy):
        raise Fail(2, "%s is not a copy's name" % a.copy)
    if not ACTION_NAME_RE.match(a.new_name):
        raise Fail(2, "%s is not an action name (a-z, 0-9 and _, starting with a letter, at most 48)"
                   % a.new_name)
    library, lib = load_library(cfg)
    dest = os.path.join(cfg.repo, "made", lib.server, "actions", a.new_name + ".py")
    for d in (os.path.join(cfg.repo, "actions"), os.path.dirname(dest)):
        if os.path.exists(os.path.join(d, a.new_name + ".py")):
            raise Fail(1, "%s is taken: %s — pick another name"
                       % (a.new_name, os.path.relpath(os.path.join(d, a.new_name + ".py"), cfg.repo)))
    entry = known_copy(cfg, a, a.copy)
    if not entry.get("action"):
        raise Fail(1, "%s runs no action this PC knows" % a.copy)
    va, cat, cls = action_class(cfg, entry["action"])
    from pydantic_core import to_jsonable_python
    base = dict((k, to_jsonable_python(f.get_default(call_default_factory=True))) for k, f in cls.model_fields.items())
    now = dict((k, v) for k, v in (entry.get("values") or {}).items() if k in base and base[k] != v)
    parent = entry["action"]
    if cat.source(parent) == "library":
        text = "from actions.%s import %s\n\n\nclass %s(%s):\n    %s%s%s\n" % (
            parent, cls.__name__, library.camel(a.new_name), cls.__name__, library.TRIPLE, library.TODO_LINE,
            library.TRIPLE)
        if now:
            text += "\n    defaults = %s\n" % library.literal(now)
    else:
        info = va_cache_entry(cfg, cat, parent)
        inherit = [k.__module__.rsplit("preset__", 1)[1] for k in cls.__mro__ if "preset__" in k.__module__]
        inherited = set()
        for k in cls.__mro__:
            if "preset__" in k.__module__:
                inherited.update(k.model_fields)
        fields = [(k, f) for k, f in info["fields"].items() if k not in inherited]
        fixed = dict((k, v) for k, v in info["fixed"].items() if k not in now)   # a value given is a default
        text = library.action_text(a.new_name, info["script"], inherit, fields, runs=info["runs"],
                                   takes=info["takes"], defaults=dict(info["defaults"], **now), fixed=fixed)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    atomic_write(dest, text, 0o644)
    out("saved %s from %s (%s), with %s" % (os.path.relpath(dest, cfg.repo), a.copy, parent,
                                            " ".join("%s=%s" % (k, show_value(v)) for k, v in now.items())
                                            + " as its defaults" if now else "the same defaults"))
    cat.refresh()
    problems = (["%s: %s" % (os.path.relpath(dest, cfg.repo), p) for p in va.check_action(a.new_name, cat.get(a.new_name))]
                if cat.get(a.new_name) is not None else
                ["%s: left out: %s" % (os.path.relpath(dest, cfg.repo), cat.errors().get(a.new_name, "?"))])
    if cat.get(a.new_name) is not None:
        problems += todo_problems(cfg, cat, a.new_name)
    out("check: %d to fix before it is done:\n%s" % (len(problems), "\n".join("  " + p for p in problems))
        if problems else "check: ok")
    out("next: its line on the menu, in players' words, then vfg action check %s" % a.new_name)
    return 0


def cmd_preset_save(cfg, a):
    """Lift a function out of a script into made/<server>/presets/<name>.py."""
    library, lib = load_library(cfg)
    if not library.PRESET_RE.match(a.name):
        raise Fail(2, "%s is not a preset name (a-z, 0-9 and _, starting with a letter)" % a.name)
    taken = lib.taken(a.name, "preset")
    if taken:
        raise Fail(1, "%s is taken: %s — pick another name" % (a.name, taken))
    item = lib.script(a.script)
    if item is None:
        raise Fail(1, "no script %s in scripts/ or made/%s/scripts/" % (a.script, lib.server))
    if item.problem:
        raise Fail(1, "%s: %s" % (item.rel, item.problem))
    va, cat = catalog(cfg)
    over = actions_over(cfg, cat, item)
    fields = va_cache_entry(cfg, cat, item.name if item.name in over else over[0])["fields"] if over else {}
    try:
        text, renames, helpers = library.lift(item, a.function, a.name, fields)
    except ValueError as e:
        raise Fail(1, str(e) if over else "%s (no action runs %s)" % (e, item.name))
    dest = lib.made_preset_path(a.name)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    atomic_write(dest, text, 0o644)
    vals = ", ".join(new if new == old else "%s (was %s)" % (new, old) for old, new in renames.items())
    out("saved %s from %s.%s: values %s%s" % (os.path.relpath(dest, cfg.repo), a.script, a.function,
                                              vals or "none",
                                              "; helpers " + ", ".join(helpers) if helpers else ""))
    report_check(cfg, library, lib, dest, "preset", a.name, "made")
    if renames:
        out("next: read its values class: each value's description, in players' words, must fit the preset "
            "(a TODO where the action had none), then vfg script check %s" % a.name)
    return 0


def cmd_preset(cfg, a):
    return cmd_preset_save(cfg, a)


def cmd_script(cfg, a):
    ops = {"deploy": cmd_script_deploy, "new": cmd_script_new, "check": cmd_script_check,
           "set": cmd_script_set, "save": cmd_script_save, "list": cmd_script_list, "stop": cmd_script_stop}
    if a.op in ops:
        return ops[a.op](cfg, a)
    if not NAME_RE.match(a.name):
        raise Fail(2, "%s is not a copy's name" % a.name)
    if a.n < 0:
        raise Fail(2, "-n is 0 or more")
    follow = bool(a.follow)
    args = {"op": "logs", "name": a.name, "n": a.n, "follow": follow}
    if follow:
        return follow_call(cfg, program("scripts.py", dict(args, vfg=cfg.rvfg, mc=cfg.rmc), SCRIPTS_LIBS))
    return finish(*remote(cfg, a, "scripts.py", args, 30, libs=SCRIPTS_LIBS))


# ------------------------------------------------------------------ state

def day_phase(t):
    t %= 24000
    return "day" if t < 12000 else "dusk" if t < 13000 else "night" if t < 23000 else "dawn"


def touches(fields, values):
    """Who a copy acts on: what its Player and Players fields name (a selector as it is)."""
    out_ = []
    for k, f in (fields or {}).items():
        if "player" not in str((f or {}).get("type") or "").lower():
            continue
        v = (values or {}).get(k)
        if isinstance(v, str):
            got = [x.strip() for x in v.split(",") if x.strip()]
        elif isinstance(v, list):
            got = [x for x in v if isinstance(x, str)]
        else:
            continue
        for x in got:
            if x not in out_:
                out_.append(x)
    return out_


def actions_cache(cfg):
    """~/.vfg/actions.json as it is, or built (vfg_actions.cache) when there is none; {} when
    neither can be had."""
    try:
        with open(os.path.join(cfg.home, "actions.json"), encoding="utf-8") as f:
            got = json.load(f)
        if isinstance(got.get("actions"), dict):
            return got
    except (OSError, ValueError, AttributeError):
        pass
    try:
        return actions_lib().cache(cfg.repo, server_name(cfg), cfg.home)
    except Fail:
        return {}


def cmd_state(cfg, a):
    """Who is online, where, the time, the weather and every running copy: one SSH call. What
    runs is written to running.json as a fetch would."""
    t0 = time.monotonic()
    asked_at = now_iso()
    rc, o, e = remote(cfg, a, "scripts.py", {"op": "state"}, 30, libs=SCRIPTS_LIBS)
    if rc not in (0, 5):
        finish(rc, o, e)
    try:
        world = json.loads(o.decode("utf-8"))
    except ValueError:
        finish(rc, o, e)
        raise Fail(1, "scripts.py answered something that is not JSON")
    rows = world.get("copies") or []
    try:
        store_fetched(cfg, rows, asked_at)
    except OSError as err:
        warn("running.json not written: %s" % err)
    acts = (actions_cache(cfg).get("actions") or {})
    running = []
    for c in rows:
        info = acts.get(c.get("action")) or {}
        base = dict((f, d.get("default")) for f, d in (info.get("fields") or {}).items())
        base.update(info.get("defaults") or {})
        base.update(info.get("fixed") or {})
        values = c.get("values") or {}
        running.append({"instance": c["copy"], "copy": c["copy"], "action": c.get("action"),
                        "script": c.get("script"), "source": c.get("source"), "task": c.get("task"),
                        "pid": c.get("pid"), "since": c.get("since"), "started": c.get("started"),
                        "runs": c.get("runs"), "values": values,
                        "changed": differs(base, values) if info else values,
                        "touches": touches(info.get("fields"), values)})
    weather = None
    if world.get("raining") is not None:
        weather = "thunder" if world.get("thundering") else "rain" if world.get("raining") else "clear"
    daytime = world.get("daytime")
    result = {"online": world.get("online") or [],
              "time": {"daytime": daytime, "day": world.get("day"),
                       "phase": day_phase(daytime) if isinstance(daytime, int) else None},
              "weather": weather, "instances": running, "rcon": world.get("rcon"),
              "ms": int((time.monotonic() - t0) * 1000)}
    if a.json:
        out(json.dumps(result, ensure_ascii=False))
    else:
        rows_ = []
        if world.get("rcon"):
            rows_.append(("minecraft", world["rcon"]))
        else:
            people = ["%s %s %s" % (p["name"], " ".join(str(c) for c in p["pos"]) if p.get("pos") else "?",
                                    p.get("dimension") or "?") for p in result["online"]]
            rows_.append(("online", ", ".join(people) if people else "nobody"))
            t = result["time"]
            rows_.append(("time", "%s (%s)%s" % (t["phase"] or "?", "?" if daytime is None else daytime,
                                                 ", day %d" % t["day"] if isinstance(t["day"], int) else "")))
            rows_.append(("weather", weather or "unknown"))
        for r in running:
            bits = []
            if r["action"] != r["copy"]:
                bits.append(r["action"] or "?")
            if r["task"]:
                bits.append(r["task"])
            if r["changed"]:
                bits.append(" ".join("%s=%s" % (k, show_value(v)) for k, v in r["changed"].items()))
            line = r["copy"] + (" — " + ", ".join(bits) if bits else "")
            if r["touches"]:
                line += "; touches " + ", ".join(r["touches"])
            rows_.append(("running", line))
        if not running:
            rows_.append(("running", "nothing"))
        out("\n".join("%-10s%s" % row for row in rows_))
    if rc == 5:
        finish(rc, b"", e)
    return 0


class _Stop(Exception):
    pass


def _raise_stop(signum, frame):
    raise _Stop()


def follow_call(cfg, data):
    """A follow mode with no timeout; SIGTERM, SIGINT or SIGHUP end it with 0."""
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, _raise_stop)
    try:
        rc, o, e = Ssh(cfg).call(data, None, stream=True)
    except _Stop:
        return 0
    return finish(rc, o, e)


