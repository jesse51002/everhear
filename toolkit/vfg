def read_settings(path):
    """KEY=value lines (export allowed, quotes taken off), as Config reads ~/.vfg/config."""
    found = {}
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            if line.startswith("export "):
                line = line[7:].lstrip()
            key, value = (x.strip() for x in line.split("=", 1))
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            found[key] = value
    return found


class TestBox(Config):
    """The live config, with the test box's keys (TEST_BOX_KEYS) from VFG_TEST_BOX's file over it."""

    def __init__(self, path):
        Config.__init__(self)
        self.box_file = path
        self.box = dict((k, v) for k, v in read_settings(path).items() if k in TEST_BOX_KEYS and v)

    def get(self, key):
        if key in self.box:
            value = self.box[key]
            return os.path.expanduser(value) if key in self.PATHS and value.startswith("~") else value
        return Config.get(self, key)


def test_box(cfg):
    """The test server's config; Fail 3 when there is none, or when it is the live box itself."""
    path = os.path.expanduser(cfg.get("VFG_TEST_BOX"))
    if not path:
        raise Fail(3, "no test server: VFG_TEST_BOX names none (a file of its box's settings); "
                      "check it on the live server with one vfg action run instead")
    try:
        box = TestBox(path)
    except OSError as e:
        raise Fail(3, "not configured: VFG_TEST_BOX's file cannot be read (%s)" % (e.strerror or e))
    if box.get("VFG_SSH_HOST") == cfg.get("VFG_SSH_HOST") and (box.rvfg == cfg.rvfg or box.rmc == cfg.rmc):
        raise Fail(3, "not configured: VFG_TEST_BOX names the live server itself (%s on %s); a test never "
                      "runs there" % (box.rvfg if box.rvfg == cfg.rvfg else box.rmc, box.get("VFG_SSH_HOST")))
    return box


def test_runs(text):
    """The actions a test starts or binds by name: t.run("railgun", ...)'s and t.bind's first word."""
    import ast
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return set(re.findall(r"""\.(?:run|bind)\(\s*["']([a-z][a-z0-9_]*)["']""", text))
    return set(n.args[0].value for n in ast.walk(tree)
               if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr in ("run", "bind")
               and n.args and isinstance(n.args[0], ast.Constant) and isinstance(n.args[0].value, str))


def test_path(cfg, name):
    """(the test file, "made" or "library"), or (None, None)."""
    made = os.path.join(cfg.repo, "made", server_name(cfg), "tests", name + ".py")
    if os.path.isfile(made):
        return made, "made"
    lib = os.path.join(scripts_dir(cfg), name, "test.py")
    if os.path.isfile(lib):
        return lib, "library"
    return None, None


def test_kinds(cfg):
    """The kinds of ability with a test template: scripts/_lib/kit/templates/<kind>.py, the kit's own
    (kit.test.kinds() lists the same folder)."""
    try:
        return sorted(f[:-3] for f in os.listdir(os.path.join(scripts_dir(cfg), "_lib", "kit", "templates"))
                      if f.endswith(".py") and not f.startswith("_"))
    except OSError:
        return []


def test_skeleton(cfg, name):
    return TEST_SKELETON.format(name=name, kinds="|".join(test_kinds(cfg)) or "(none here)")


def test_template(cfg, name, kind):
    """The template of `kind`, filled for `name`: its player and phrase from the incantations it
    bound (the cache, no call), else Steve and its name in words; its item from its action. A line
    naming the item is left as a comment when its action names none."""
    kinds = test_kinds(cfg)
    if kind not in kinds:
        raise Fail(2, "no test template %s: the kinds are %s" % (kind, ", ".join(kinds) or "none"))
    text = read_text(os.path.join(scripts_dir(cfg), "_lib", "kit", "templates", kind + ".py"))
    got = read_incant_cache(cfg)
    rows = [e for e in (got[0]["incantations"] if got else []) if isinstance(e, dict)
            and (e.get("by") == name or e.get("action") == name)]
    mine = [e for e in rows if e.get("player") and e.get("player") != "@a"]
    player = (mine[0]["player"] if mine else "Steve")
    phrase = (mine or rows)[0].get("phrase") if (mine or rows) else name.replace("_", " ")
    item = ""
    try:
        act = (actions_lib().cache(cfg.repo, server_name(cfg), cfg.home).get("actions") or {}).get(name) or {}
        item = (act.get("defaults") or {}).get("item") or ((act.get("fields") or {}).get("item") or {}).get("default") or ""
    except Exception:
        pass
    lines = []
    for ln in text.split("\n"):
        if "{item}" in ln and not (isinstance(item, str) and item):
            ln = "# " + ln.replace("{item}", "<its item>") + "  (its action names no item)"
        lines.append(ln)
    text = "\n".join(lines)
    out_ = []
    for ln in text.split("\n"):
        filled = ln
        for k, v in (("{name}", name), ("{player}", player), ("{phrase}", phrase or ""), ("{item}", str(item))):
            filled = filled.replace(k, v)
        if filled != ln and "  # " in filled and not filled.lstrip().startswith("#"):   # its comment kept in line
            code, note = filled.split("  # ", 1)
            filled = code.rstrip().ljust(ln.index("  # ") + 1) + " # " + note
        out_.append(filled)
    return "\n".join(out_)


def write_test_skeleton(cfg, name, kind=None):
    """made/<server>/tests/<name>.py: the template of `kind` (test_template), else TEST_SKELETON,
    unless there is one: its path, or None. A kind's template goes over the bare skeleton too."""
    path = os.path.join(cfg.repo, "made", server_name(cfg), "tests", name + ".py")
    text = test_template(cfg, name, kind) if kind else test_skeleton(cfg, name)
    if os.path.exists(path) and not (kind and read_text(path) == test_skeleton(cfg, name)):
        return None
    os.makedirs(os.path.dirname(path), exist_ok=True)
    atomic_write(path, text, 0o644)
    return path


# What a test changed since its last run, shown before its results (visibility only: the test is
# the implementer's to change). The last run's file is kept on this PC, $VFG_HOME/tests/<server or
# library>/<name>.py; the changes are read from its t.check(...) calls, the things it puts on the
# stage and how it starts the ability.
TEST_STAGE = ("mob", "blocks", "ground", "region", "player", "stand_in")
TEST_TRIGGER = ("cast", "run", "bind", "use", "sneak", "look")


def test_memory(cfg, source, name):
    return os.path.join(cfg.home, "tests", "library" if source == "library" else server_name(cfg), name + ".py")


def _test_calls(tree_):
    """(checks {(item, n): verdict node}, stage {key: call}, trigger [call]) of a test's AST."""
    import ast
    checks, stage, trigger, seen = {}, {}, [], {}
    named = dict((id(n.value), n.targets[0].id) for n in ast.walk(tree_)
                 if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name))
    calls = sorted((n for n in ast.walk(tree_) if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute)),
                   key=lambda n: (n.lineno, n.col_offset))
    for n in calls:
        attr = n.func.attr
        if attr == "check" and len(n.args) >= 2:
            item = n.args[0].value if isinstance(n.args[0], ast.Constant) else ast.unparse(n.args[0])
            k = seen[("c", item)] = seen.get(("c", item), -1) + 1
            checks[(str(item), k)] = n.args[1]
        elif attr in TEST_STAGE and isinstance(n.func.value, ast.Name):
            what = named.get(id(n)) or "%s %s" % (attr, n.args[0].value if n.args and isinstance(n.args[0], ast.Constant)
                                                  else "")
            k = seen[("s", what)] = seen.get(("s", what), -1) + 1
            stage[(what.strip(), k)] = n
        elif attr in TEST_TRIGGER and isinstance(n.func.value, ast.Name):
            trigger.append(ast.unparse(n))
    return checks, stage, trigger


def _numbers(node):
    """(the node's source with each number as #, its numbers in order)."""
    import ast
    import copy
    nums, node = [], copy.deepcopy(node)
    for n in ast.walk(node):
        if isinstance(n, ast.UnaryOp) and isinstance(n.op, ast.USub) and isinstance(n.operand, ast.Constant) \
                and isinstance(n.operand.value, (int, float)) and not isinstance(n.operand.value, bool):
            n.operand.value = -n.operand.value
            n.op = ast.UAdd()
    for n in ast.walk(node):
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)) and not isinstance(n.value, bool):
            nums.append(n.value)
            n.value = 0
    return ast.unparse(node), nums


def test_changes(old, new):
    """One line per meaningful change from the test `old` to `new`: a check removed, added or
    renamed, a bar lowered or raised (a number in a check's call smaller or larger), a check
    changed otherwise, a target moved or changed or removed, the trigger changed. [] when either
    does not parse."""
    import ast
    try:
        (oc, os_, ot), (nc, ns, nt) = _test_calls(ast.parse(old)), _test_calls(ast.parse(new))
    except SyntaxError:
        return []
    short = lambda n: (lambda t: t if len(t) <= 120 else t[:117] + "...")(ast.unparse(n))  # noqa: E731
    lines = []
    gone = [k for k in oc if k not in nc]
    came = [k for k in nc if k not in oc]
    for k in list(gone):   # the same verdict under another item: renamed
        same = [c for c in came if ast.unparse(nc[c]) == ast.unparse(oc[k])]
        if same:
            lines.append('check renamed: "%s" -> "%s"' % (k[0], same[0][0]))
            gone.remove(k)
            came.remove(same[0])
    lines += ['check removed: "%s" (%s)' % (k[0], short(oc[k])) for k in gone]
    lines += ['check added: "%s" (%s)' % (k[0], short(nc[k])) for k in came]
    for k in oc:
        if k not in nc or ast.unparse(oc[k]) == ast.unparse(nc[k]):
            continue
        (shape0, n0), (shape1, n1) = _numbers(oc[k]), _numbers(nc[k])
        if shape0 == shape1:
            down, up = any(b < a for a, b in zip(n0, n1)), any(b > a for a, b in zip(n0, n1))
            word = "bar lowered" if down and not up else "bar raised" if up and not down else "bars changed"
        else:
            word = "check changed"
        lines.append('%s: "%s": %s -> %s' % (word, k[0], short(oc[k]), short(nc[k])))
    for k, call in os_.items():
        if k not in ns:
            lines.append("target removed: %s (%s)" % (k[0], short(call)))
            continue
        if ast.unparse(call) == ast.unparse(ns[k]):
            continue
        pos0 = [ast.unparse(x) for x in call.args] + [ast.unparse(w) for w in call.keywords
                                                       if w.arg in ("right", "up", "forward", "size")]
        pos1 = [ast.unparse(x) for x in ns[k].args] + [ast.unparse(w) for w in ns[k].keywords
                                                        if w.arg in ("right", "up", "forward", "size")]
        lines.append("target %s: %s: %s -> %s" % ("moved" if pos0 != pos1 else "changed", k[0], short(call),
                                                  short(ns[k])))
    if ot != nt:
        lines.append("trigger: %s -> %s" % ("; ".join(ot)[:150] or "none", "; ".join(nt)[:150] or "none"))
    return lines


def deploy_for_test(box, a, lib_names, made_names):
    """The kit and these scripts onto the test server, each only when its stamp there is another:
    the folders sent, as "scripts/_lib"... ([] when it had them all)."""
    groups = [("scripts", scripts_dir(box), with_lib(box, sorted(lib_names)))]
    if made_names:
        groups.append((made_root(box), made_scripts_dir(box), sorted(made_names)))
    stamps = [{"root": r, "stamps": dict((n, stamp(tree(here, n, action_defaults(box, here, n)))) for n in names)}
              for r, here, names in groups]
    stale = set(remote_json(box, a, {"op": "stale", "stamps": stamps}).get("stale") or [])
    tars, sent = [], []
    for root, here, names in groups:
        need = [n for n in names if "%s/%s" % (root, n) in stale]
        if need:
            tar, stamps_ = pack(box, need, here)
            tars.append({"root": root, "tar": tar, "stamps": stamps_})
            sent += ["%s/%s" % (root, n) for n in need]
    if tars:
        rc, o, e = remote(box, a, "scripts.py", {"op": "deploy", "tars": tars}, 120, libs=SCRIPTS_LIBS)
        if rc != 0:
            finish(rc, b"", e)
    return sent


def cmd_test(cfg, a):
    """vfg test <name>: the test of a task (or of a library script) on the test server, its
    report printed; exit 0 when no check failed. With no test yet, a made task gets the skeleton."""
    name = a.name
    if not NAME_RE.match(name or ""):
        raise Fail(2, "%s is not a task's or a script's name" % name)
    if a.n is not None and not 0 <= a.n <= 500:
        raise Fail(2, "-n is a number of log lines, 0 to 500")
    timeout = a.test_timeout if a.test_timeout is not None else setting(cfg, "VFG_TEST_TIMEOUT_S", TEST_TIMEOUT, 5, 600)
    if not 5 <= timeout <= 600:
        raise Fail(2, "--timeout is 5 to 600 seconds")
    path, source = test_path(cfg, name)
    kind = getattr(a, "kind", None)
    if kind and source != "library":
        made = write_test_skeleton(cfg, name, kind)
        if made:
            raise Fail(1, "wrote the %s template %s: one t.check per DONE WHEN item at its TODO, the rest edited as "
                          "the ability needs, then vfg test %s" % (kind, os.path.relpath(made, cfg.repo), name))
        warn("%s has a test already: --kind writes a template only where there is none or the bare skeleton; "
             "its template is scripts/_lib/kit/templates/%s.py" % (name, kind))
    elif kind:
        test_template(cfg, name, kind)  # a kind that is none says so
        warn("%s is a library script: its test.py is written by hand; --kind is for a task's" % name)
    if path is None:
        if os.path.isdir(os.path.join(scripts_dir(cfg), name)):
            raise Fail(1, "the library script %s has no test.py" % name)
        made = write_test_skeleton(cfg, name)
        raise Fail(1, "no test for %s yet: wrote the skeleton %s; or the template of its kind: vfg test %s --kind "
                      "%s; fill in one check per DONE WHEN item, then vfg test %s"
                   % (name, os.path.relpath(made, cfg.repo), name, "|".join(test_kinds(cfg)), name))
    box = test_box(cfg)
    text = read_text(path)
    # The task's incantations, as the live server has them: those it bound, and those on its action.
    entries = []
    try:
        store, _ = fetch_incantations(cfg, a)
        entries = [e for e in store.get("incantations") or [] if isinstance(e, dict)
                   and (e.get("by") == name or e.get("action") == name)]
    except Fail as f:
        warn("the live server's incantations were not read (%s): the test server has only its own" % f.msg)
    # The actions it runs (t.run's), the task's own and those its incantations fire, as the actions
    # cache holds them: their scripts go to the test server, and t.run reads them there.
    acts = actions_lib().cache(cfg.repo, server_name(cfg), cfg.home).get("actions") or {}
    wanted = test_runs(text) | {name} | set(e.get("action") for e in entries)
    named = dict((n, acts[n]) for n in sorted(x for x in wanted if x) if isinstance(acts.get(n), dict))
    lib_names, made_names = set(), set()
    if source == "library":
        lib_names.add(name)
    for e in list(named.values()) + entries:
        script = e.get("script") or e.get("action")
        if script:
            (made_names if e.get("source") == "made" else lib_names).add(script)
    if os.path.isdir(os.path.join(made_scripts_dir(cfg), name)):
        made_names.add(name)
    lib_names = set(n for n in lib_names if not script_problem(cfg, n))
    made_names = set(n for n in made_names if not script_problem(cfg, n, made_scripts_dir(cfg)))
    sent = deploy_for_test(box, a, lib_names, made_names)
    if sent:
        out("test server: deployed %s" % ", ".join(x.split("/")[-1] for x in sent))
    args = {"task": name, "server": server_name(cfg), "file": os.path.relpath(path, cfg.repo), "test": text,
            "actions": named, "incantations": entries, "timeout": timeout, "owner": cfg.get("VFG_OWNER"),
            "poll": live_poll(cfg), "tail": 15 if a.n is None else a.n}
    if box.get("VFG_SSH_HOST") == cfg.get("VFG_SSH_HOST"):
        # the same machine: the box checks itself that its server is not the live one under another path
        args["live"] = {"vfg": cfg.rvfg, "mc": cfg.rmc}
    memory = test_memory(cfg, source, name)
    try:
        last = read_text(memory)
    except (OSError, Fail):
        last = None
    if last is not None and last != text:
        changed = test_changes(last, text)
        if changed:
            out("\n".join("CHANGED    %s" % ln for ln in ["since the last run of this test:"] + changed))
    rc, o, e = Ssh(box).call(program("test.py", dict(args, vfg=box.rvfg, mc=box.rmc)), timeout + 30,
                             keep_master=True)
    if rc != 0:
        finish(rc, o, e)
    lines = o.decode("utf-8", "replace").rstrip("\n").split("\n")
    try:
        end = json.loads(lines[-1])
    except ValueError:
        raise Fail(1, "the test server answered something that is not the test's end")
    try:   # it ran: what it was is the next run's to compare with
        os.makedirs(os.path.dirname(memory), mode=0o700, exist_ok=True)
        atomic_write(memory, text)
    except OSError as x:
        warn("this test's last run was not kept (%s): the next run shows no changes" % (x.strerror or x))
    # what the kit logged as it went (forceloads, cleanups) is not the report
    report = [ln for ln in lines[:-1] if not re.match(r"^\d\d:\d\d:\d\d test_[a-z0-9_-]+ ", ln)]
    if report:
        out("\n".join(report))
    if end.get("timed_out"):
        raise Fail(1, "the test ran past its %g s and was stopped: shorten its waits, or --timeout" % timeout)
    code = end.get("code")
    result = [ln for ln in report if ln.startswith("RESULT: ")]
    if code == 0:
        return 0
    if code == 1 and result:
        raise Fail(1, "the test failed: %s" % result[-1][len("RESULT: "):])
    if code == 2 and result:
        raise Fail(1, "the test checked nothing: call t.check for each DONE WHEN item, then t.done()")
    last = [ln for ln in report if ln.strip()]
    raise Fail(1, "the test did not finish (exit %s): %s" % (code, last[-1].strip()[:300] if last else "no output"))


