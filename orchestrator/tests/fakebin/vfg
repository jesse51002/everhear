#!/usr/bin/env bash
# The fake vfg toolkit for tests. Put first on the PATH. It appends its arguments as one JSON
# line to $VFG_FAKE_LOG and answers:
#   cmd list                      There are 1 of a max of 20 players online: Steve
#   cmd data get entity Steve Pos Steve has the following entity data: [10.5d, 64.0d, -3.5d]
#   any other cmd, script ...     nothing
#   orch reply ...                exit 1 while the number in $VFG_FAKE_FAIL_REPLIES is above 0 (it is decremented)
#   place list                    the file $VFG_FAKE_PLACES, else "none"; with $VFG_FAKE_PLACES_FAIL set, that
#                                 text on stderr and exit 1; with $VFG_FAKE_PLACES_SLEEP, it sleeps that long first
#   everything else               exit 0
set -u

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

if [ -n "${VFG_FAKE_LOG:-}" ]; then
  line="["
  sep=""
  for a in "$@"; do
    line+="$sep\"$(json_escape "$a")\""
    sep=","
  done
  line+="]"
  printf '%s\n' "$line" >> "$VFG_FAKE_LOG"
fi

case "${1:-}" in
  cmd)
    shift
    c="$*"
    c="${c#/}"
    case "$c" in
      "list") echo "There are 1 of a max of 20 players online: Steve" ;;
      "data get entity Steve Pos") echo "Steve has the following entity data: [10.5d, 64.0d, -3.5d]" ;;
    esac
    exit 0
    ;;
  place)
    if [ "${2:-}" = "list" ]; then
      if [ -n "${VFG_FAKE_PLACES_SLEEP:-}" ]; then exec sleep "$VFG_FAKE_PLACES_SLEEP"; fi
      if [ -n "${VFG_FAKE_PLACES_FAIL:-}" ]; then echo "vfg: $VFG_FAKE_PLACES_FAIL" >&2; exit 1; fi
      if [ -n "${VFG_FAKE_PLACES:-}" ] && [ -f "$VFG_FAKE_PLACES" ]; then cat "$VFG_FAKE_PLACES"; else echo none; fi
    fi
    exit 0
    ;;
  orch)
    if [ "${2:-}" = "reply" ] && [ -n "${VFG_FAKE_FAIL_REPLIES:-}" ] && [ -f "$VFG_FAKE_FAIL_REPLIES" ]; then
      exec 9>>"$VFG_FAKE_FAIL_REPLIES.lock"
      flock 9 2>/dev/null || true
      n=$(cat "$VFG_FAKE_FAIL_REPLIES" 2>/dev/null || echo 0)
      n=${n//[^0-9]/}
      if [ "${n:-0}" -gt 0 ]; then
        echo $((n - 1)) > "$VFG_FAKE_FAIL_REPLIES"
        echo "vfg: EC2 unreachable (fake)" >&2
        exit 1
      fi
    fi
    exit 0
    ;;
esac
exit 0
